---
import { ClientRouter } from 'astro:transitions';

import '@fontsource-variable/manrope';
import '@/styles/global.css';

import SiteHeader from '@/components/global/SiteHeader.astro';
import SiteFooter from '@/components/global/SiteFooter.astro';
import ScrollToTop from '@/components/global/ScrollToTop.astro';
import GoogleTag from '@/components/global/GoogleTag.astro';
import CookieConsent from '@/components/global/CookieConsent.astro';

import { SITE } from '@/config/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  noindex?: boolean;
  footerCta?: 'default' | 'portfolio' | 'about' | false;
}

const {
  title,
  description = SITE.description,
  image = SITE.defaultOgImage,
  imageAlt = SITE.seo.openGraph.imageAlt,
  imageWidth = 1600,
  imageHeight = 878,
  imageType = 'image/webp',
  twitterCard = SITE.seo.twitter.card,
  noindex = false,
  footerCta = 'default',
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : SITE.title;

const siteBase = Astro.site ?? new URL(SITE.url);
const canonicalUrl = new URL(Astro.url.pathname, siteBase);
const socialImageUrl = new URL(image, siteBase);
const homeUrl = new URL('/', siteBase);
const organizationId = new URL('/#organization', siteBase).toString();
const websiteId = new URL('/#website', siteBase).toString();
const webpageId = new URL('/#webpage', siteBase).toString();
const primaryImageId = new URL(`${Astro.url.pathname}#primaryimage`, siteBase).toString();
const isHomePage = Astro.url.pathname === '/';

const homeStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: homeUrl.toString(),
      name: SITE.name,
      alternateName: 'ROMADI.lv',
      inLanguage: 'lv-LV',
      publisher: { '@id': organizationId },
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: canonicalUrl.toString(),
      name: pageTitle,
      description,
      inLanguage: 'lv-LV',
      isPartOf: { '@id': websiteId },
      about: { '@id': organizationId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        '@id': primaryImageId,
        url: socialImageUrl.toString(),
        contentUrl: socialImageUrl.toString(),
        width: imageWidth,
        height: imageHeight,
        caption: imageAlt,
      },
    },
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: SITE.organization.name,
      url: homeUrl.toString(),
      logo: {
        '@type': 'ImageObject',
        url: new URL(SITE.organization.logo, siteBase).toString(),
        width: 1200,
        height: 1200,
      },
      email: SITE.contact.email,
      telephone: SITE.contact.phones[0]?.display,
      address: {
        '@type': 'PostalAddress',
        addressLocality: SITE.contact.location.city,
        addressCountry: SITE.contact.location.countryCode,
      },
    },
  ],
};
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="theme-color" content="#080305" />

    <meta name="color-scheme" content="dark" />

    <meta name="mobile-web-app-capable" content="yes" />

    <meta name="apple-mobile-web-app-capable" content="yes" />

    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>

    <meta name="description" content={description} />

    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />

    <meta property="og:site_name" content={SITE.name} />

    <meta property="og:locale" content={SITE.locale} />

    <meta property="og:title" content={pageTitle} />

    <meta property="og:description" content={description} />

    <meta property="og:url" content={canonicalUrl} />

    <meta property="og:image" content={socialImageUrl} />

    <meta property="og:image:secure_url" content={socialImageUrl} />

    <meta property="og:image:type" content={imageType} />

    <meta property="og:image:width" content={String(imageWidth)} />

    <meta property="og:image:height" content={String(imageHeight)} />

    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content={twitterCard} />

    <meta name="twitter:title" content={pageTitle} />

    <meta name="twitter:description" content={description} />

    <meta name="twitter:image" content={socialImageUrl} />

    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />

    <link rel="shortcut icon" href="/favicon.ico" />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta name="apple-mobile-web-app-title" content={SITE.shortName} />

    <link rel="manifest" href="/site.webmanifest" />

    <GoogleTag />

    {isHomePage && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(homeStructuredData)} />
    )}

    <script is:inline>
      document.documentElement.dataset.motionReady = 'true';
    </script>

    <ClientRouter />
  </head>

  <body>
    <a
      href="#main-content"
      class="fixed top-4 left-4 z-[100] -translate-y-24 rounded-full bg-white px-5 py-3 text-sm font-semibold text-black transition-transform focus:translate-y-0"
    >
      Pāriet uz saturu
    </a>

    <SiteHeader />

    <main id="main-content">
      <slot />
    </main>

    <SiteFooter ctaVariant={footerCta} />

    <ScrollToTop />

    <CookieConsent />

    <script>
      import { initRevealAnimations } from '@/lib/animations/reveal';

      document.addEventListener('astro:page-load', () => {
        initRevealAnimations();
      });
    </script>
  </body>
</html>
