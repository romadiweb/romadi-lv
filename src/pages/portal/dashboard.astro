---
import PortalLayout from '@/layouts/PortalLayout.astro';

export const prerender = false;

const identity = Astro.locals.portalIdentity;
if (!identity) return Astro.redirect('/portal/login?reason=session');

const existingCsrf = Astro.cookies.get('portal_csrf')?.value;
const csrfToken = existingCsrf ?? crypto.randomUUID();
if (!existingCsrf) {
  Astro.cookies.set('portal_csrf', csrfToken, {
    httpOnly: false,
    maxAge: 60 * 60 * 8,
    path: '/',
    sameSite: 'strict',
    secure: import.meta.env.PROD,
  });
}
---

<PortalLayout
  title="Satura vadības centrs"
  description="ROMADI projektu, atsauksmju un cenu plānu pārvaldība."
>
  <main
    id="portal-main"
    class="portal-dashboard"
    data-portal-dashboard
    data-role={identity.role}
    data-csrf={csrfToken}
  >
    <aside class="portal-sidebar">
      <button
        type="button"
        class="portal-sidebar-brand"
        data-dashboard-brand
        aria-label="Atvērt portāla pārskatu"
      >
        <img src="/images/brand/romadi-logo-white.svg" width="116" height="31" alt="ROMADI" />
        <span>CMS</span>
      </button>

      <nav class="portal-nav" aria-label="Portāla sadaļas">
        <section class="portal-nav-group portal-nav-home" aria-label="Pārskats">
          <button type="button" class="is-active" data-section="dashboard">
            <span class="portal-nav-signal"></span>
            <svg class="portal-nav-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"></path>
            </svg>
            <span>Pārskats</span>
          </button>
        </section>

        <section class="portal-nav-group" aria-labelledby="portal-nav-clients">
          <h2 id="portal-nav-clients">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"
              ></path></svg
            >
            <span>Klienti</span>
          </h2>
          <button type="button" data-section="leads">
            <span class="portal-nav-signal"></span>
            <svg class="portal-nav-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.87"
              ></path>
            </svg>
            <span>Leads</span>
            <b data-count="leads">—</b>
          </button>
          <button type="button" data-section="templates">
            <span class="portal-nav-signal"></span>
            <svg class="portal-nav-icon" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="9" y="9" width="11" height="11" rx="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span>Tekstu sagataves</span>
            <b data-count="text_templates">—</b>
          </button>
        </section>

        <section class="portal-nav-group" aria-labelledby="portal-nav-tasks">
          <h2 id="portal-nav-tasks">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"
              ></path></svg
            >
            <span>Uzdevumi</span>
          </h2>
          <button type="button" class="is-disabled" disabled>
            <span class="portal-nav-signal"></span>
            <span>Kvotas</span>
            <b>Drīz</b>
          </button>
        </section>

        <section class="portal-nav-group" aria-labelledby="portal-nav-finance">
          <h2 id="portal-nav-finance">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7H14a3.5 3.5 0 0 1 0 7H6"></path></svg
            >
            <span>Finanses</span>
          </h2>
          <button type="button" class="is-disabled" disabled>
            <span class="portal-nav-signal"></span>
            <span>Ieņēmumi</span>
            <b>Drīz</b>
          </button>
          <button type="button" data-section="calculator">
            <span class="portal-nav-signal"></span>
            <svg class="portal-nav-icon" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="4" y="3" width="16" height="18" rx="2"></rect>
              <path d="M8 7h8M8 11h2M14 11h2M8 15h2M14 15h2"></path>
            </svg>
            <span>Cenu kalkulators</span>
            <b data-count="portal_pricing_items">—</b>
          </button>
        </section>

        <section class="portal-nav-group" aria-labelledby="portal-nav-partners">
          <h2 id="portal-nav-partners">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M16 3h5v5M21 3l-7 7M8 21H3v-5M3 21l7-7M21 16v5h-5M21 21l-7-7M3 8V3h5M3 3l7 7"
              ></path></svg
            >
            <span>Sadarbības</span>
          </h2>
          <button type="button" class="is-disabled" disabled>
            <span class="portal-nav-signal"></span>
            <span>Partneri</span>
            <b>Drīz</b>
          </button>
        </section>

        <section class="portal-nav-group" aria-labelledby="portal-nav-website">
          <h2 id="portal-nav-website">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M3 4h18v14H3zM8 20h8M12 18v2"></path></svg
            >
            <span>Mājaslapa</span>
          </h2>
          <button type="button" data-resource="projects">
            <span class="portal-nav-signal"></span>
            <svg class="portal-nav-icon" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="7" width="18" height="13" rx="2"></rect>
              <path d="M8 7V4h8v3M3 12h18"></path>
            </svg>
            <span>Projekti</span>
            <b data-count="projects">—</b>
          </button>
          <button type="button" data-resource="reviews">
            <span class="portal-nav-signal"></span>
            <svg class="portal-nav-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
            </svg>
            <span>Atsauksmes</span>
            <b data-count="reviews">—</b>
          </button>
          <button type="button" data-resource="pricing_plans">
            <span class="portal-nav-signal"></span>
            <svg class="portal-nav-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 2h12v20l-3-2-3 2-3-2-3 2zM9 7h6M9 11h6M9 15h4"></path>
            </svg>
            <span>Cenu plāni</span>
            <b data-count="pricing_plans">—</b>
          </button>
          {
            identity.role === 'super-admin' && (
              <button type="button" data-resource="audit">
                <span class="portal-nav-signal" />
                <svg class="portal-nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5M12 7v5l3 2" />
                </svg>
                <span>Izmaiņu žurnāls</span>
              </button>
            )
          }
        </section>

        <section class="portal-nav-group" aria-labelledby="portal-nav-analytics">
          <h2 id="portal-nav-analytics">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 3v18h18"></path>
              <path d="M7 16l4-5 4 3 5-7"></path>
            </svg>

            <span>Analītika</span>
          </h2>

          <button type="button" class="is-disabled" disabled>
            <span class="portal-nav-signal"></span>
            <span>Pārskats</span>
            <b>Drīz</b>
          </button>

          <button type="button" class="is-disabled" disabled>
            <span class="portal-nav-signal"></span>
            <span>Apmeklētāji</span>
            <b>Drīz</b>
          </button>

          <button type="button" class="is-disabled" disabled>
            <span class="portal-nav-signal"></span>
            <span>Veiktspēja</span>
            <b>Drīz</b>
          </button>
        </section>
      </nav>

      <div class="portal-sidebar-foot">
        <button
          type="button"
          class="portal-sidebar-toggle"
          data-sidebar-toggle
          aria-expanded="true"
          aria-label="Sakļaut sānu izvēlni"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
          <span>Sakļaut izvēlni</span>
        </button>
        <div class="portal-user-summary">
          <span>{identity.email.slice(0, 1).toUpperCase()}</span>
          <div>
            <strong>{identity.email}</strong>
            <small>{identity.role === 'super-admin' ? 'Super-admins' : 'Administrators'}</small>
          </div>
        </div>
        <button type="button" class="portal-logout" data-logout>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M10 17l5-5-5-5M15 12H3M14 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"></path>
          </svg>
          <span>Izrakstīties</span>
        </button>
      </div>
    </aside>

    <section class="portal-workspace">
      <header class="portal-workspace-header">
        <div>
          <h1 data-section-title>Pārskats</h1>
          <p data-section-description>
            Dienas uzdevumi, aktīvie kontakti un biežāk lietotās darbības vienuviet.
          </p>
        </div>
        <button type="button" class="portal-create-action" data-create hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          <span>Jauns lead</span>
        </button>
      </header>

      <div class="portal-home" data-dashboard-home-view>
        <section class="portal-home-summary" aria-label="Darba kopsavilkums">
          <article>
            <span data-home-metric="open-leads">—</span>
            <p>Aktīvi lead</p>
          </article>
          <article>
            <span data-home-metric="due-tasks">—</span>
            <p>Jāuzrunā vai jāatgādina</p>
          </article>
          <article>
            <span data-home-metric="templates">—</span>
            <p>Kopīgas teksta sagataves</p>
          </article>
        </section>

        <div class="portal-home-columns">
          <section class="portal-home-tasks" aria-labelledby="home-tasks-title">
            <header>
              <div>
                <h2 id="home-tasks-title">Šodienas uzdevumi</h2>
                <p>Follow-up termiņi un vēl neuzrunātie kontakti.</p>
              </div>
              <button type="button" data-home-action="leads">Atvērt visus</button>
            </header>
            <div class="portal-home-task-list" data-home-task-list aria-live="polite"></div>
          </section>

          <aside class="portal-quick-actions" aria-labelledby="quick-actions-title">
            <h2 id="quick-actions-title">Ātrās darbības</h2>
            <button type="button" data-home-action="new-lead">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
              <span
                ><strong>Pievienot lead</strong><small>Saglabā kontaktu pirms uzrunas</small></span
              >
            </button>
            <button type="button" data-home-action="new-template">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
              <span
                ><strong>Jauna sagatave</strong><small>Pievieno tekstu ar vairākiem toņiem</small
                ></span
              >
            </button>
            <button type="button" data-home-action="projects">
              <svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="M8 7V4h8v3M3 12h18M3 7h18v13H3z"></path></svg
              >
              <span><strong>Mājaslapas saturs</strong><small>Atver projektu pārvaldību</small></span
              >
            </button>
          </aside>
        </div>
      </div>

      <div class="portal-lead-grid" data-lead-grid hidden>
        <section class="portal-lead-board-panel" aria-labelledby="lead-board-title">
          <header>
            <div>
              <h2 id="lead-board-title">Pipeline</h2>
              <span data-lead-status>Ielādē…</span>
            </div>
            <label class="portal-lead-search">
              <span class="portal-visually-hidden">Meklēt lead</span>
              <input
                type="search"
                data-lead-search
                placeholder="Meklēt uzņēmumu, nozari, platformu"
              />
            </label>
          </header>
          <div class="portal-lead-metrics" aria-label="Lead kopsavilkums">
            <article>
              <span data-lead-metric="open">—</span>
              <p>Aktīvi lead</p>
            </article>
            <article>
              <span data-lead-metric="followups">—</span>
              <p>Follow-up šonedēļ</p>
            </article>
            <article>
              <span data-lead-metric="quota">Kvotas gatavs</span>
              <p>Uzdevumu norma tiks pieslēgta pie šīs plūsmas</p>
            </article>
          </div>
          <div class="portal-kanban" data-lead-kanban aria-live="polite"></div>
        </section>

        <section class="portal-lead-editor-panel" aria-labelledby="lead-editor-title">
          <header>
            <div>
              <h2 id="lead-editor-title" data-lead-editor-title>Jauns lead</h2>
              <p data-lead-editor-copy>Izveido kontaktu un ieliec to pareizajā statusā.</p>
            </div>
            <span class="portal-draft-state" data-lead-form-state>Nav saglabāts</span>
          </header>

          <form class="portal-lead-form" data-lead-form>
            <div class="portal-form-fields">
              <label class="portal-field is-wide">
                <span>Uzņēmums / Nosaukums</span>
                <input name="company_name" required maxlength="180" autocomplete="organization" />
              </label>
              <label class="portal-field">
                <span>Kur atrasts? Platforma</span>
                <input
                  name="found_on"
                  required
                  maxlength="180"
                  placeholder="Instagram, Google Maps…"
                />
              </label>
              <label class="portal-field">
                <span>Nozare</span>
                <input name="industry" maxlength="120" placeholder="Restorāni, ražošana…" />
              </label>
              <label class="portal-checkbox-field portal-contact-state is-wide">
                <input
                  type="checkbox"
                  name="is_contacted"
                  aria-controls="lead-outreach-fields"
                  aria-expanded="false"
                />
                <span class="portal-checkbox-control"></span>
                <span class="portal-checkbox-copy">
                  <strong>Leads jau ir uzrunāts</strong>
                  <small>Atzīmē, lai pievienotu saziņas informāciju un statusu.</small>
                </span>
              </label>
              <div
                class="portal-lead-outreach-fields is-wide"
                id="lead-outreach-fields"
                data-lead-outreach-fields
                hidden
              >
                <label class="portal-field">
                  <span>Kurā datumā uzrunāts</span>
                  <input name="contacted_at" type="date" />
                </label>
                <label class="portal-field">
                  <span>Kurš uzrunāja</span>
                  <input name="outreach_owner" maxlength="120" autocomplete="name" />
                </label>
                <label class="portal-field">
                  <span>Saziņas kanāls</span>
                  <select name="contact_channel">
                    <option value="instagram">Instagram</option>
                    <option value="facebook">Facebook</option>
                    <option value="linkedin">LinkedIn</option>
                    <option value="tiktok">TikTok</option>
                    <option value="email">E-pasts</option>
                    <option value="phone">Telefons</option>
                    <option value="other">Cits</option>
                  </select>
                </label>
                <label class="portal-field">
                  <span>Statuss</span>
                  <select name="status">
                    <option value="not_contacted" hidden>Nav uzrunāts</option>
                    <option value="contacted">Uzrunāts</option>
                    <option value="answered">Atbildēja</option>
                    <option value="interested">Ieinteresēts</option>
                    <option value="offer_sent">Piedāvājums nosūtīts</option>
                    <option value="negotiation">Sarunas</option>
                    <option value="client">Klients</option>
                    <option value="rejected">Noraidīts</option>
                    <option value="no_response">Neatbild</option>
                    <option value="deferred">Atlikts</option>
                  </select>
                </label>
                <label class="portal-checkbox-field">
                  <input type="checkbox" name="follow_up_enabled" />
                  <span class="portal-checkbox-control"></span>
                  <span>Follow-up</span>
                </label>
              </div>
              <label class="portal-checkbox-field">
                <input type="checkbox" name="has_website" />
                <span class="portal-checkbox-control"></span>
                <span>Mājaslapa ir</span>
              </label>
              <label class="portal-field is-wide">
                <span>Piezīmes</span>
                <textarea name="notes" maxlength="4000" rows="5"></textarea>
              </label>
            </div>
            <div class="portal-editor-actions">
              <button type="button" class="portal-delete-action" data-lead-delete hidden
                >Dzēst</button
              >
              <span class="portal-save-status" data-lead-save-status aria-live="polite"></span>
              <button type="button" class="portal-secondary-action" data-lead-reset>Notīrīt</button>
              <button type="submit" class="portal-primary-action">Saglabāt lead</button>
            </div>
          </form>
        </section>
      </div>

      <div class="portal-template-grid" data-template-grid hidden>
        <section class="portal-template-library" aria-labelledby="template-library-title">
          <header>
            <div>
              <h2 id="template-library-title">Bibliotēka</h2>
              <span data-template-status>Ielādē…</span>
            </div>
            <div class="portal-template-filters">
              <label>
                <span class="portal-visually-hidden">Meklēt sagatavi</span>
                <input type="search" data-template-search placeholder="Meklēt sagatavi" />
              </label>
              <label>
                <span class="portal-visually-hidden">Filtrēt pēc kategorijas</span>
                <select data-template-category-filter>
                  <option value="">Visas kategorijas</option>
                </select>
              </label>
            </div>
          </header>
          <div class="portal-template-list" data-template-list aria-live="polite"></div>
        </section>

        <section class="portal-template-editor" aria-labelledby="template-editor-title">
          <header>
            <div>
              <h2 id="template-editor-title" data-template-editor-title>Izvēlies sagatavi</h2>
              <p>Katram tekstam vari saglabāt vairākus toņus un nokopēt vajadzīgo versiju.</p>
            </div>
            <span class="portal-draft-state" data-template-form-state>Nav izvēlēts</span>
          </header>

          <div class="portal-editor-empty" data-template-empty>
            <span class="portal-empty-glyph" aria-hidden="true"></span>
            <h3>Sagataves ir gatavas darbam</h3>
            <p>Izvēlies sagatavi kreisajā pusē vai izveido jaunu.</p>
          </div>

          <form class="portal-template-form" data-template-form hidden>
            <div class="portal-form-fields">
              <label class="portal-field is-wide">
                <span>Nosaukums</span>
                <input name="title" required maxlength="160" />
              </label>
              <label class="portal-field is-wide">
                <span>Kategorija</span>
                <input
                  name="category"
                  required
                  maxlength="100"
                  list="portal-template-categories"
                  placeholder="Piemēram, Viesu mājas"
                />
                <datalist id="portal-template-categories" data-template-category-options></datalist>
                <small>Raksti esošu kategoriju vai izveido jaunu.</small>
              </label>
              <label class="portal-field is-wide">
                <span>Piezīmes</span>
                <textarea
                  name="notes"
                  maxlength="2000"
                  rows="3"
                  placeholder="Kad un kam šo sagatavi izmantot"></textarea>
              </label>
            </div>

            <section class="portal-variant-section" aria-labelledby="template-variants-title">
              <header>
                <div>
                  <h3 id="template-variants-title">Teksta varianti</h3>
                  <p>Nosauc toni, piemēram, “Formāls” vai “Draudzīgs”.</p>
                </div>
                <button type="button" class="portal-secondary-action" data-add-variant>
                  Pievienot variantu
                </button>
              </header>
              <div class="portal-variant-list" data-variant-list></div>
            </section>

            <div class="portal-editor-actions">
              <button type="button" class="portal-delete-action" data-template-delete hidden
                >Dzēst</button
              >
              <span class="portal-save-status" data-template-save-status aria-live="polite"></span>
              <button type="button" class="portal-secondary-action" data-template-reset
                >Atiestatīt</button
              >
              <button type="submit" class="portal-primary-action">Saglabāt sagatavi</button>
            </div>
          </form>
        </section>
      </div>

      <div class="portal-calculator-grid" data-calculator-grid hidden>
        <section class="portal-price-catalog" aria-labelledby="price-catalog-title">
          <header>
            <div>
              <h2 id="price-catalog-title">Cenu katalogs</h2>
              <span data-price-status>Ielādē…</span>
            </div>
            <label>
              <span class="portal-visually-hidden">Meklēt cenu</span>
              <input type="search" data-price-search placeholder="Meklēt cenu vai integrāciju" />
            </label>
          </header>
          <div class="portal-price-list" data-price-list aria-live="polite"></div>
        </section>

        <section class="portal-calculator-panel" aria-labelledby="calculator-title">
          <header>
            <div>
              <h2 id="calculator-title">Kalkulators</h2>
              <p>Saliec projekta apjomu no aktīvajām cenu rindām.</p>
            </div>
            <label class="portal-vat-toggle">
              <input type="checkbox" data-vat-toggle checked />
              <span class="portal-checkbox-control"></span>
              <span>PVN 21%</span>
            </label>
          </header>

          <div class="portal-calculator-builder" data-calculator-builder></div>
          <div class="portal-calculator-summary">
            <div data-calculator-lines></div>
            <label class="portal-discount-field">
              <span>Atlaide %</span>
              <input type="number" data-discount-percent min="0" max="100" step="0.01" value="0" />
            </label>
            <dl>
              <div>
                <dt>Starpsumma</dt>
                <dd data-calculator-subtotal>0 €</dd>
              </div>
              <div>
                <dt>Atlaide</dt>
                <dd data-calculator-discount>0 €</dd>
              </div>
              <div>
                <dt>PVN</dt>
                <dd data-calculator-vat>0 €</dd>
              </div>
              <div>
                <dt>Kopā</dt>
                <dd data-calculator-total>0 €</dd>
              </div>
            </dl>
            <button type="button" class="portal-secondary-action" data-copy-estimate>
              Kopēt aprēķinu
            </button>
          </div>
        </section>

        <section class="portal-price-editor" aria-labelledby="price-editor-title">
          <header>
            <div>
              <h2 id="price-editor-title" data-price-editor-title>Jauna cena</h2>
              <p>Cenas glabājas Supabase un uzreiz parādās kalkulatorā.</p>
            </div>
            <span class="portal-draft-state" data-price-form-state>Nav saglabāta</span>
          </header>

          <form class="portal-price-form" data-price-form>
            <div class="portal-form-fields">
              <label class="portal-field is-wide">
                <span>Nosaukums</span>
                <input name="name" required maxlength="160" />
              </label>
              <label class="portal-field">
                <span>Atslēga</span>
                <input name="item_key" required maxlength="100" placeholder="epasta-forma" />
              </label>
              <label class="portal-field">
                <span>Kategorija</span>
                <select name="category" required>
                  <option value="base">Pamata komplekts</option>
                  <option value="page">Lapas</option>
                  <option value="integration">Integrācijas</option>
                  <option value="addon">Papildinājumi</option>
                  <option value="hourly">Stundu darbs</option>
                  <option value="adjustment">Korekcijas</option>
                </select>
              </label>
              <label class="portal-field">
                <span>Vienība</span>
                <select name="unit" required>
                  <option value="project">projekts</option>
                  <option value="page">lapa</option>
                  <option value="item">gab.</option>
                  <option value="hour">stunda</option>
                </select>
              </label>
              <label class="portal-field">
                <span>Cena EUR</span>
                <input name="price_eur" type="number" required min="0" step="0.01" />
              </label>
              <label class="portal-field">
                <span>Noklusētais daudzums</span>
                <input name="default_quantity" type="number" required min="0.01" step="0.01" />
              </label>
              <label class="portal-field">
                <span>Secība</span>
                <input name="sort_order" type="number" required min="0" step="1" />
              </label>
              <label class="portal-checkbox-field">
                <input type="checkbox" name="is_active" checked />
                <span class="portal-checkbox-control"></span>
                <span>Aktīva kalkulatorā</span>
              </label>
              <label class="portal-field is-wide">
                <span>Apraksts</span>
                <textarea name="description" maxlength="1000" rows="4"></textarea>
              </label>
            </div>
            <div class="portal-editor-actions">
              <button type="button" class="portal-delete-action" data-price-delete hidden
                >Dzēst</button
              >
              <span class="portal-save-status" data-price-save-status aria-live="polite"></span>
              <button type="button" class="portal-secondary-action" data-price-reset
                >Jauna cena</button
              >
              <button type="submit" class="portal-primary-action">Saglabāt cenu</button>
            </div>
          </form>
        </section>
      </div>

      <div class="portal-work-grid" data-work-grid hidden>
        <section class="portal-list-panel" aria-labelledby="content-list-title">
          <header>
            <h2 id="content-list-title">Saturs</h2>
            <span data-list-status>Ielādē…</span>
          </header>
          <div class="portal-list" data-content-list aria-live="polite"></div>
        </section>

        <section class="portal-editor-panel" data-editor-panel aria-labelledby="editor-title">
          <header>
            <div>
              <h2 id="editor-title" data-editor-title>Izvēlies ierakstu</h2>
              <p>Vienkāršs teksts; HTML tiek noraidīts serverī.</p>
            </div>
            <span class="portal-draft-state" data-record-state>Nav izvēlēts</span>
          </header>

          <div class="portal-editor-empty" data-editor-empty>
            <span class="portal-empty-glyph" aria-hidden="true"></span>
            <h3>Saturs gaida izvēli</h3>
            <p>Izvēlies ierakstu kreisajā pusē vai izveido jaunu.</p>
          </div>

          <form class="portal-editor-form" data-editor-form hidden>
            <div class="portal-form-fields" data-form-fields></div>
            <div class="portal-editor-actions">
              <button type="button" class="portal-delete-action" data-delete hidden>Dzēst</button>
              <span class="portal-save-status" data-save-status aria-live="polite"></span>
              <button type="submit" class="portal-primary-action">Saglabāt izmaiņas</button>
            </div>
          </form>
        </section>
      </div>
    </section>

    <div class="portal-toast" data-toast role="status" aria-live="polite" hidden></div>

    <dialog class="portal-confirm-dialog" data-delete-dialog>
      <form method="dialog">
        <span class="portal-dialog-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 10v6M14 10v6"></path>
          </svg>
        </span>
        <h2>Dzēst šo ierakstu?</h2>
        <p>Šo darbību nevar atsaukt. Izmaiņa tiks saglabāta audita žurnālā.</p>
        <div>
          <button value="cancel" class="portal-secondary-action">Atcelt</button>
          <button value="confirm" class="portal-danger-action">Dzēst neatgriezeniski</button>
        </div>
      </form>
    </dialog>

    <dialog class="portal-confirm-dialog" data-discard-dialog>
      <form method="dialog">
        <span class="portal-dialog-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M9 14l-4-4 4-4M5 10h8a6 6 0 0 1 6 6v2"></path>
          </svg>
        </span>
        <h2>Atmest nesaglabātās izmaiņas?</h2>
        <p>Šajā ierakstā ir izmaiņas, kas vēl nav saglabātas.</p>
        <div>
          <button value="cancel" class="portal-secondary-action">Turpināt rediģēt</button>
          <button value="confirm" class="portal-danger-action">Atmest izmaiņas</button>
        </div>
      </form>
    </dialog>
  </main>

  <script>
    import { initPortalDashboard } from '@/lib/portal/dashboard';
    initPortalDashboard();
  </script>
</PortalLayout>
