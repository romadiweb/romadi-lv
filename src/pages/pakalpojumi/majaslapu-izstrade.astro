---
import ServicePage from '@/components/sections/services/ServicePage.astro';
import { SERVICES } from '@/data/services';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const prerender = false;

const service = SERVICES.find((service) => service.slug === 'majaslapu-izstrade')!;
const canonicalUrl = new URL(service.href, Astro.site ?? 'https://romadi.lv').toString();
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.label,
  description: service.seoDescription,
  url: canonicalUrl,
  areaServed: {
    '@type': 'Country',
    name: 'Latvija',
  },
  provider: {
    '@type': 'Organization',
    name: 'ROMADI',
    url: 'https://romadi.lv',
  },
};
---

<BaseLayout title={service.seoTitle} description={service.seoDescription}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <ServicePage service={service} />
</BaseLayout>
