---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPortfolioProjects, type PortfolioProject } from '@/lib/projects';

const fallbackBySlug: Record<string, Partial<PortfolioProject>> = {
  'diana-hunt': {
    summary:
      'Medību preču kataloga vietne ar Latvijā izstrādātu mednieku eksāmena testa sistēmu, lietotāju kontiem un īpašnieka pārvaldības vidi.',
    portfolio_image_url: '/images/projects/dianahunt-1600.webp',
    alt_text: 'Diana Hunt interneta veikala sākumlapa',
    project_url: 'https://dianahunt.lv',
    challenge:
      'Vienā saprotamā vietnē bija jāapvieno medību preču katalogs, mācību saturs un droša piekļuve eksāmena testa sistēmai.',
    solution:
      'Izveidojām individuālu vietni ar lietotāju kontiem, mednieku eksāmena treniņtestu un īpašnieka CMS produktu un lietotāju pārvaldībai.',
    features: [
      'Latvijas mednieku eksāmena testa sistēma',
      'Lietotāju konti un piekļuves pārvaldība',
      'Produktu katalogs bez tiešsaistes apmaksas',
      'CMS produktu un lietotāju pārvaldībai',
      'Pieteikuma forma ar nosūtīšanu uz e-pastu',
    ],
    technologies: ['Custom izstrāde', 'Pielāgots CMS'],
    integrations: [
      'Lietotāju konti',
      'E-pasta forma',
      'Produktu kataloga pārvaldība',
      'Eksāmena testa sistēma',
    ],
  },
  'liepajas-teltis': {
    summary:
      'Pakalpojumu vietne, kas palīdz ātri saprast piedāvājumu un nonākt līdz rezervācijas pieprasījumam.',
    portfolio_image_url: '/images/projects/liepajas-teltis-1600.webp',
    alt_text: 'Liepājas Teltis vietnes sākumlapa',
  },
  'rtu-liepajas-jurniecibas-koledza': {
    summary:
      'Digitāla klātbūtne jūrniecības izglītības iestādei ar pārskatāmu informācijas arhitektūru.',
    portfolio_image_url: '/images/projects/ljk.png',
    alt_text: 'RTU Liepājas Jūrniecības koledžas logotips',
  },
};

const categoryBySlug: Record<string, { name: string; description: string }> = {
  'diana-hunt': {
    name: 'Interneta veikali',
    description: 'Ātra un saprotama iepirkšanās pieredze, veidota pārdošanai un ērtai pārvaldībai.',
  },
  'liepajas-teltis': {
    name: 'Mājaslapas',
    description:
      'Pārdomātas uzņēmumu vietnes, kas skaidri izstāsta vērtību un ved apmeklētāju uz rīcību.',
  },
  'rtu-liepajas-jurniecibas-koledza': {
    name: 'Zīmols & UI/UX',
    description:
      'Vizuālā identitāte un saskarnes, kas veido vienotu, atpazīstamu digitālo pieredzi.',
  },
};

const showcaseVisualBySlug: Record<string, { desktop: string; mobile?: string; alt: string }> = {
  'liepajas-teltis': {
    desktop: '/images/projects/portfolio-web-hero-pc.webp',
    mobile: '/images/projects/portfolio-web-hero-mobile.webp',
    alt: 'ROMADI mājaslapu dizaina kategorijas priekšskatījums',
  },
  'diana-hunt': {
    desktop: '/images/projects/portfolio-shop-hero-desktop.webp',
    mobile: '/images/projects/portfolio-shop-hero-mobile.webp',
    alt: 'ROMADI interneta veikalu dizaina kategorijas priek\u0161skat\u012bjums',
  },
  'rtu-liepajas-jurniecibas-koledza': {
    desktop: '/images/projects/portfolio-uiux-hero-desktop.webp',
    mobile: '/images/projects/portfolio-uiux-hero-mobile.webp',
    alt: 'ROMADI z\u012bmola un UI UX dizaina kategorijas priek\u0161skat\u012bjums',
  },
};

const dbProjects = await getPublishedPortfolioProjects();
const projects = dbProjects.map((project) => {
  const fallback = fallbackBySlug[project.slug];

  return {
    ...project,
    summary: project.summary ?? fallback?.summary ?? null,
    portfolio_image_url: project.portfolio_image_url ?? fallback?.portfolio_image_url ?? null,
    alt_text: project.alt_text ?? fallback?.alt_text ?? null,
    project_url: project.project_url ?? fallback?.project_url ?? null,
    challenge: project.challenge ?? fallback?.challenge ?? null,
    solution: project.solution ?? fallback?.solution ?? null,
    features: project.features.length > 0 ? project.features : (fallback?.features ?? []),
    technologies:
      project.technologies.length > 0 ? project.technologies : (fallback?.technologies ?? []),
    integrations:
      project.integrations.length > 0 ? project.integrations : (fallback?.integrations ?? []),
  };
});

const showcaseOrder = ['liepajas-teltis', 'diana-hunt', 'rtu-liepajas-jurniecibas-koledza'];
const showcaseProjects = [...projects].sort(
  (a, b) => showcaseOrder.indexOf(a.slug) - showcaseOrder.indexOf(b.slug),
);
---

<BaseLayout
  title="Portfolio"
  description="ROMADI portfolio — mūsu veidotās mājaslapas, digitālie produkti un specializētās sistēmas."
  footerCta="portfolio"
>
  <section class="portfolio-hero" aria-labelledby="portfolio-title">
    <div class="portfolio-shell">
      <div class="portfolio-showcase" data-portfolio-showcase>
        <header class="portfolio-showcase__header">
          <h1 id="portfolio-title">Digitāli darbi ar skaidru mērķi.</h1>
          <p>Stratēģija, dizains un tehnoloģija — vienā pārdomātā risinājumā.</p>
        </header>

        <div class="portfolio-showcase__frame">
          {
            showcaseProjects.map((project, index) => (
              <figure
                class:list={['portfolio-showcase__visual', { 'is-active': index === 0 }]}
                data-showcase-visual={project.slug}
              >
                <picture>
                  {showcaseVisualBySlug[project.slug]?.mobile && (
                    <source
                      media="(max-width: 640px)"
                      srcset={showcaseVisualBySlug[project.slug]!.mobile!}
                    />
                  )}
                  <img
                    src={
                      showcaseVisualBySlug[project.slug]?.desktop ??
                      project.portfolio_image_url ??
                      project.logo_url ??
                      ''
                    }
                    alt={
                      showcaseVisualBySlug[project.slug]?.alt ??
                      project.alt_text ??
                      `${project.name} projekta skats`
                    }
                    width={showcaseVisualBySlug[project.slug] ? 1280 : 1600}
                    height={showcaseVisualBySlug[project.slug] ? 960 : 900}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : 'auto'}
                    decoding={index === 0 ? 'sync' : 'async'}
                  />
                </picture>
              </figure>
            ))
          }
        </div>

        <div class="portfolio-showcase__tabs" role="tablist" aria-label="Projektu kategorijas">
          {
            showcaseProjects.map((project, index) => (
              <button
                class:list={['portfolio-showcase__tab', { 'is-active': index === 0 }]}
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                data-showcase-tab={project.slug}
              >
                <span>{String(index + 1).padStart(2, '0')} / Kategorija</span>
                <strong>{categoryBySlug[project.slug]?.name ?? 'Mājaslapas'}</strong>
                <small>{categoryBySlug[project.slug]?.description ?? project.summary}</small>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="portfolio-work" id="projekti" aria-labelledby="projects-title">
    <canvas class="portfolio-liquid-line" data-liquid-canvas aria-hidden="true"></canvas>
    <div class="portfolio-shell">
      <header class="portfolio-work__header">
        <p class="portfolio-kicker">Atlasītie projekti</p>
        <h2 id="projects-title">No idejas līdz<br />strādājošam rezultātam.</h2>
        <p>{projects.length.toString().padStart(2, '0')} publicēti darbi</p>
      </header>

      {
        projects.length > 0 ? (
          <ol class="portfolio-grid">
            {projects.map((project, index) => {
              const content = (
                <figure
                  class:list={[
                    'project-card__media',
                    { 'project-card__media--logo': !project.portfolio_image_url },
                  ]}
                >
                  <div class="project-card__platform">
                    <span aria-hidden="true">{'{ }'}</span>
                    <strong>{project.build_platform}</strong>
                  </div>

                  {project.portfolio_image_url ? (
                    <img
                      src={project.portfolio_image_url}
                      alt={project.alt_text ?? `${project.name} projekta skats`}
                      width="1600"
                      height="1000"
                      loading={index === 0 ? 'eager' : 'lazy'}
                      fetchpriority={index === 0 ? 'high' : 'auto'}
                    />
                  ) : project.logo_url ? (
                    <img
                      class="project-card__logo"
                      src={project.logo_url}
                      alt={project.alt_text ?? `${project.name} logotips`}
                      loading="lazy"
                    />
                  ) : (
                    <span class="project-card__monogram" aria-hidden="true">
                      {project.name.slice(0, 2)}
                    </span>
                  )}

                  <span class="project-card__wash" aria-hidden="true" />

                  <figcaption class="project-card__info">
                    <p>{categoryBySlug[project.slug]?.name ?? 'Digitāls projekts'}</p>
                    <h3>{project.name}</h3>
                    <span class="project-card__action">
                      Atvērt apskatu <span aria-hidden="true">→</span>
                    </span>
                  </figcaption>
                </figure>
              );

              const dialogId = `project-dialog-${project.slug}`;
              const projectCategory = categoryBySlug[project.slug];
              const projectSummary =
                project.summary ??
                fallbackBySlug[project.slug]?.summary ??
                projectCategory?.description ??
                'Individuāli izstrādāts digitālais risinājums ar skaidru struktūru un pārdomātu lietotāja pieredzi.';
              const challenge = project.challenge ?? projectSummary;
              const solution =
                project.solution ??
                projectCategory?.description ??
                'Stratēģija, dizains un izstrāde savienota vienotā, mērķtiecīgā risinājumā.';
              const hasCapabilities = project.features.length > 0;
              const hasTechnologyDetails =
                project.technologies.length > 0 || project.integrations.length > 0;

              return (
                <li class="project-card">
                  {content}
                  <button
                    class="project-card__trigger"
                    type="button"
                    aria-label={`${project.name} — atvērt projekta apskatu`}
                    aria-haspopup="dialog"
                    aria-controls={dialogId}
                    data-open-project={dialogId}
                  />

                  <dialog
                    class="project-dialog"
                    id={dialogId}
                    aria-labelledby={`${dialogId}-title`}
                    data-project-dialog
                  >
                    <div class="project-dialog__surface">
                      <header class="project-dialog__topbar">
                        <p>
                          <span aria-hidden="true">{'{ }'}</span>
                          ROMADI / PROJEKTA APSKATS
                        </p>
                        <button
                          type="button"
                          aria-label="Aizvērt projekta apskatu"
                          data-close-project
                          autofocus
                        >
                          <span aria-hidden="true" />
                          <span aria-hidden="true" />
                        </button>
                      </header>

                      <div class="project-dialog__content">
                        <figure
                          class:list={[
                            'project-dialog__media',
                            { 'project-dialog__media--logo': !project.portfolio_image_url },
                          ]}
                        >
                          {project.portfolio_image_url ? (
                            <img
                              src={project.portfolio_image_url}
                              alt={project.alt_text ?? `${project.name} projekta skats`}
                              width="1600"
                              height="1000"
                              loading="lazy"
                              decoding="async"
                            />
                          ) : project.logo_url ? (
                            <img
                              src={project.logo_url}
                              alt={project.alt_text ?? `${project.name} logotips`}
                              loading="lazy"
                            />
                          ) : (
                            <span aria-hidden="true">{project.name.slice(0, 2)}</span>
                          )}
                        </figure>

                        <section class="project-dialog__intro">
                          <div>
                            <p>{projectCategory?.name ?? 'Digitāls projekts'}</p>
                            <h2 id={`${dialogId}-title`}>{project.name}</h2>
                          </div>
                          <dl>
                            <div>
                              <dt>Izstrādes veids</dt>
                              <dd>{project.build_platform}</dd>
                            </div>
                            <div>
                              <dt>Virziens</dt>
                              <dd>{projectCategory?.name ?? 'Digitālā pieredze'}</dd>
                            </div>
                          </dl>
                        </section>

                        <section class="project-dialog__story" aria-label="Par projektu">
                          <div>
                            <h3>Izaicinājums</h3>
                            <p>{challenge}</p>
                          </div>
                          <div>
                            <h3>Risinājums</h3>
                            <p>{solution}</p>
                          </div>
                        </section>

                        {hasCapabilities && (
                          <section class="project-dialog__features" aria-labelledby={`${dialogId}-features`}>
                            <h3 id={`${dialogId}-features`}>Izveidotā funkcionalitāte</h3>
                            <ul>
                              {project.features.map((feature) => (
                                <li>{feature}</li>
                              ))}
                            </ul>
                          </section>
                        )}

                        {hasTechnologyDetails && (
                          <section class="project-dialog__technology" aria-labelledby={`${dialogId}-technology`}>
                            <header>
                              <h3 id={`${dialogId}-technology`}>Tehnoloģijas un integrācijas</h3>
                              <p>Risinājuma pamats un galvenie savienojumi.</p>
                            </header>
                            <div>
                              {project.technologies.length > 0 && (
                                <section aria-label="Izstrādes tehnoloģijas">
                                  <h4>Izstrāde</h4>
                                  <ul>
                                    {project.technologies.map((technology) => (
                                      <li>{technology}</li>
                                    ))}
                                  </ul>
                                </section>
                              )}
                              {project.integrations.length > 0 && (
                                <section aria-label="Galvenās integrācijas">
                                  <h4>Galvenās integrācijas</h4>
                                  <ul>
                                    {project.integrations.map((integration) => (
                                      <li>{integration}</li>
                                    ))}
                                  </ul>
                                </section>
                              )}
                            </div>
                          </section>
                        )}

                        <footer class="project-dialog__footer">
                          {project.project_url && (
                            <a href={project.project_url} target="_blank" rel="noreferrer">
                              Apmeklēt vietni <span aria-hidden="true">↗</span>
                            </a>
                          )}
                          <a href="/kontakti" data-astro-prefetch>
                            Pārrunāt līdzīgu projektu <span aria-hidden="true">↗</span>
                          </a>
                        </footer>
                      </div>
                    </div>
                  </dialog>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="portfolio-empty">Projektu atlase pašlaik tiek papildināta.</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  const initPortfolioShowcase = () => {
    document.querySelectorAll<HTMLElement>('[data-portfolio-showcase]').forEach((showcase) => {
      const tabs = Array.from(showcase.querySelectorAll<HTMLButtonElement>('[data-showcase-tab]'));
      const visuals = Array.from(showcase.querySelectorAll<HTMLElement>('[data-showcase-visual]'));
      const frame = showcase.querySelector<HTMLElement>('.portfolio-showcase__frame');
      const mobileViewport = window.matchMedia('(max-width: 640px)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const selected = tab.dataset.showcaseTab;

          tabs.forEach((item) => {
            const active = item === tab;
            item.classList.toggle('is-active', active);
            item.setAttribute('aria-selected', String(active));
          });

          visuals.forEach((visual) => {
            visual.classList.toggle('is-active', visual.dataset.showcaseVisual === selected);
          });

          if (mobileViewport.matches && frame) {
            requestAnimationFrame(() => {
              frame.scrollIntoView({
                behavior: reducedMotion.matches ? 'auto' : 'smooth',
                block: 'start',
              });
            });
          }
        });
      });
    });
  };

  const initLiquidCanvas = () => {
    document.querySelectorAll<HTMLCanvasElement>('[data-liquid-canvas]').forEach((canvas) => {
      if (canvas.dataset.liquidReady === 'true') return;

      const gl = canvas.getContext('webgl', {
        alpha: true,
        antialias: false,
        premultipliedAlpha: true,
      });
      if (!gl) return;

      const vertexSource = `
        attribute vec2 aPosition;
        void main() { gl_Position = vec4(aPosition, 0.0, 1.0); }
      `;
      const fragmentSource = `
        precision highp float;
        uniform vec2 uResolution;
        uniform float uTime;

        float hash(vec2 p) {
          return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
        }

        float noise(vec2 p) {
          vec2 i = floor(p);
          vec2 f = fract(p);
          vec2 u = f * f * (3.0 - 2.0 * f);
          return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
                     mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
        }

        void main() {
          vec2 uv = gl_FragCoord.xy / uResolution;
          float t = uTime;
          float broadNoise = noise(vec2(uv.x * 4.0 + t * 0.055, t * 0.09));
          float edgeNoise = noise(vec2(uv.x * 18.0 - t * 0.1, t * 0.16));
          float flowNoise = noise(vec2(uv.x * 31.0 + t * 0.14, t * 0.21));

          float center = 0.5
            + sin((uv.x * 1.82 + 0.08 + t * 0.026) * 6.28318) * 0.13
            + sin((uv.x * 4.3 + 0.31 - t * 0.041) * 6.28318) * 0.025
            + sin(t * 0.82 + uv.x * 8.0) * 0.012;
          center += (broadNoise - 0.5) * 0.06 + (edgeNoise - 0.5) * 0.016;

          float width = 0.032 + broadNoise * 0.024 + (edgeNoise - 0.5) * 0.016;
          float surfaceNoise = noise(vec2(uv.x * 38.0 - t * 0.11, uv.y * 7.0 + t * 0.18));
          float distanceToFlow = abs(uv.y - center + (surfaceNoise - 0.5) * 0.015);
          float bloom = exp(-pow(distanceToFlow / (width * 4.8), 2.0));
          float body = exp(-pow(distanceToFlow / (width * 1.85), 1.22));
          float endpointFade = smoothstep(0.0, 0.08, uv.x) * smoothstep(0.0, 0.08, 1.0 - uv.x);

          vec3 wine = vec3(0.33, 0.0, 0.09);
          vec3 cherry = vec3(1.0, 0.045, 0.27);
          vec3 pearl = vec3(1.0, 0.68, 0.78);
          vec3 color = mix(wine, cherry, body);
          float softLight = body * (0.28 + flowNoise * 0.28);
          color = mix(color, pearl, softLight);
          color += cherry * bloom * (0.14 + surfaceNoise * 0.08);

          float alpha = max(bloom * 0.38, body * 0.84) * endpointFade;
          gl_FragColor = vec4(color * alpha, alpha);
        }
      `;

      const compileShader = (type: number, source: string) => {
        const shader = gl.createShader(type);
        if (!shader) return null;
        gl.shaderSource(shader, source);
        gl.compileShader(shader);
        return gl.getShaderParameter(shader, gl.COMPILE_STATUS) ? shader : null;
      };

      const vertexShader = compileShader(gl.VERTEX_SHADER, vertexSource);
      const fragmentShader = compileShader(gl.FRAGMENT_SHADER, fragmentSource);
      if (!vertexShader || !fragmentShader) return;

      const program = gl.createProgram();
      if (!program) return;
      gl.attachShader(program, vertexShader);
      gl.attachShader(program, fragmentShader);
      gl.linkProgram(program);
      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;

      const buffer = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      gl.useProgram(program);

      const position = gl.getAttribLocation(program, 'aPosition');
      gl.enableVertexAttribArray(position);
      gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);

      const resolution = gl.getUniformLocation(program, 'uResolution');
      const time = gl.getUniformLocation(program, 'uTime');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const resize = () => {
        const rect = canvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio, 1.5);
        canvas.width = Math.max(1, Math.round(rect.width * dpr));
        canvas.height = Math.max(1, Math.round(rect.height * dpr));
        gl.viewport(0, 0, canvas.width, canvas.height);
      };

      const resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(canvas);
      resize();
      canvas.dataset.liquidReady = 'true';

      const startedAt = performance.now();
      const render = (now: number) => {
        if (!canvas.isConnected) {
          resizeObserver.disconnect();
          return;
        }

        gl.clearColor(0, 0, 0, 0);
        gl.clear(gl.COLOR_BUFFER_BIT);
        gl.uniform2f(resolution, canvas.width, canvas.height);
        gl.uniform1f(time, reduceMotion ? 0 : (now - startedAt) * 0.00115);
        gl.drawArrays(gl.TRIANGLES, 0, 3);

        if (!reduceMotion) requestAnimationFrame(render);
      };

      requestAnimationFrame(render);
    });
  };

  const initProjectDialogs = () => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    document.querySelectorAll<HTMLButtonElement>('[data-open-project]').forEach((trigger) => {
      if (trigger.dataset.dialogInitialized === 'true') return;

      const dialogId = trigger.dataset.openProject;
      const dialog = dialogId
        ? (document.getElementById(dialogId) as HTMLDialogElement | null)
        : null;
      const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-close-project]');

      if (!dialog || !closeButton) return;
      trigger.dataset.dialogInitialized = 'true';

      let closeTimer = 0;

      const unlockPage = () => {
        delete document.body.dataset.projectDialogOpen;
        delete dialog.dataset.closing;
      };

      const closeDialog = () => {
        if (!dialog.open || dialog.dataset.closing === 'true') return;

        window.clearTimeout(closeTimer);
        dialog.dataset.closing = 'true';
        closeTimer = window.setTimeout(() => dialog.close(), reducedMotion.matches ? 0 : 180);
      };

      trigger.addEventListener('click', () => {
        window.clearTimeout(closeTimer);
        delete dialog.dataset.closing;
        document.body.dataset.projectDialogOpen = 'true';
        dialog.showModal();
        dialog.scrollTop = 0;
      });

      closeButton.addEventListener('click', closeDialog);
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) closeDialog();
      });
      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeDialog();
      });
      dialog.addEventListener('close', unlockPage);
    });
  };

  document.addEventListener('astro:page-load', () => {
    initPortfolioShowcase();
    initLiquidCanvas();
    initProjectDialogs();
  });

  document.addEventListener('astro:before-swap', () => {
    document
      .querySelectorAll<HTMLDialogElement>('[data-project-dialog][open]')
      .forEach((dialog) => dialog.close());
    delete document.body.dataset.projectDialogOpen;
  });
</script>

<style>
  .portfolio-shell {
    width: min(100% - 3rem, 92rem);
    margin-inline: auto;
  }

  .portfolio-kicker,
  .project-card__meta,
  .portfolio-work__header > p {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
