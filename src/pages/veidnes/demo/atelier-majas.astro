---
import '@fontsource-variable/manrope';

import DemoShareMeta from '@/components/veidnes/DemoShareMeta.astro';

const services = [
  {
    title: 'Arhitektūra',
    text: 'Vieta, dzīves ritms un budžets kļūst par skaidru telpisku koncepciju.',
  },
  {
    title: 'Koka konstrukcijas',
    text: 'Precīzi projektētas detaļas, pārdomāti mezgli un atbildīgi izvēlēti materiāli.',
  },
  {
    title: 'Pilna būvniecība',
    text: 'Viena komanda koordinē projektu no pamatiem līdz pēdējam apdares pieskārienam.',
  },
];

const process = [
  ['Saruna', 'Iepazīstam jūsu ieceri, vietu, termiņu un svarīgākos ikdienas paradumus.'],
  ['Koncepcija', 'Izstrādājam telpisko virzienu, plānojumu un materiālu noskaņu.'],
  ['Projekts', 'Sagatavojam tehnisko dokumentāciju, tāmi un pārskatāmu darbu grafiku.'],
  ['Realizācija', 'Ražojam, būvējam un nododam gatavu māju ar vienu atbildīgo komandu.'],
];
---

<!doctype html>
<html lang="lv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#172019" />
    <title>Atelier Mājas — arhitektūra un koka māju būvniecība</title>
    <DemoShareMeta
      title="Atelier Mājas — arhitektūra un koka māju būvniecība"
      description="Mūsdienīgu koka māju arhitektūras un būvniecības veidnes demonstrācija."
      image="/images/social/atelier-majas-share-v2.jpg"
      imageAlt="Atelier Mājas interjers ar koku, akmeni un skatu uz priežu mežu"
    />
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="#sakums" aria-label="Atelier Mājas sākumlapa">
        <span>Atelier</span>
        <span>Mājas</span>
      </a>

      <nav class="desktop-nav" aria-label="Galvenā navigācija">
        <a href="#projekti">Projekti</a>
        <a href="#pieeja">Pieeja</a>
        <a href="#process">Process</a>
        <a href="#kontakti">Kontakti</a>
      </nav>

      <a class="header-action" href="#kontakti">
        Sākt projektu
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M5 15 15 5M7 5h8v8"></path>
        </svg>
      </a>

      <details class="mobile-nav">
        <summary aria-label="Atvērt navigāciju">
          <span></span><span></span>
        </summary>
        <nav aria-label="Mobilā navigācija">
          <a href="#projekti">Projekti</a>
          <a href="#pieeja">Pieeja</a>
          <a href="#process">Process</a>
          <a href="#kontakti">Kontakti</a>
        </nav>
      </details>
    </header>

    <main id="sakums">
      <section class="hero" aria-labelledby="hero-title">
        <img
          src="/images/templates/atelier-majas/atelier-hero.webp"
          alt="Tumša koka un gaiša akmens virtuve mūsdienīgā mājā pie priežu meža"
          width="1664"
          height="936"
          fetchpriority="high"
        />
        <div class="hero__shade" aria-hidden="true"></div>

        <div class="hero__content">
          <p class="hero__location">Liepāja · Latvija</p>
          <h1 id="hero-title">Mājas, kur materiāls kļūst par sajūtu.</h1>

          <div class="hero__bottom">
            <p>
              Projektējam un būvējam mūsdienīgas koka mājas, kurās arhitektūra, amatniecība un
              ikdiena veido vienu veselumu.
            </p>
            <a href="#projekti">Apskatīt projektus <span aria-hidden="true">↘</span></a>
          </div>
        </div>
      </section>

      <div class="disciplines" aria-label="Atelier Mājas darbības virzieni">
        <span>Arhitektūra</span><i aria-hidden="true"></i>
        <span>Koka konstrukcijas</span><i aria-hidden="true"></i>
        <span>Interjers</span><i aria-hidden="true"></i>
        <span>Būvniecība</span>
      </div>

      <section id="pieeja" class="intro" aria-labelledby="intro-title">
        <p class="section-label">Atelier pieeja</p>
        <div class="intro__copy">
          <h2 id="intro-title">Nevis māja katalogā. Māja tieši šai vietai un šai dzīvei.</h2>
          <p>
            Sākam ar ainavu, gaismu un sarunu. Tikai tad zīmējam telpas. Mūsu darbs apvieno
            arhitektūru un realizāciju, lai sākotnējā ideja nepazustu starp rasējumu un būvlaukumu.
          </p>
        </div>
        <figure class="intro__image intro__image--wide">
          <img
            src="/images/templates/atelier-majas/atelier-exterior.webp"
            alt="Gara melna koka māja priežu ielokā zilajā stundā"
            width="1536"
            height="1024"
            loading="lazy"
          />
          <figcaption>Meža māja · Grobiņas novads</figcaption>
        </figure>
        <figure class="intro__image intro__image--detail">
          <img
            src="/images/templates/atelier-majas/atelier-craft.webp"
            alt="Amatnieka rokas savieno precīzi izgatavotu ozolkoka tapu savienojumu"
            width="1456"
            height="1092"
            loading="lazy"
          />
          <figcaption>Konstrukcija · darbnīca</figcaption>
        </figure>
      </section>

      <section class="services" aria-labelledby="services-title">
        <div class="services__heading">
          <p class="section-label">Ko mēs darām</p>
          <h2 id="services-title">Viens pavediens no skices līdz atslēgai.</h2>
        </div>

        <div class="services__list">
          {
            services.map((service, index) => (
              <article>
                <span>0{index + 1}</span>
                <h3>{service.title}</h3>
                <p>{service.text}</p>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 19 19 5M8 5h11v11" />
                </svg>
              </article>
            ))
          }
        </div>
      </section>

      <section id="projekti" class="project" aria-labelledby="project-title">
        <img
          src="/images/templates/atelier-majas/atelier-exterior.webp"
          alt="Pabeigta melna koka māja ar siltu apgaismojumu mežmalā"
          width="1536"
          height="1024"
          loading="lazy"
        />
        <div class="project__overlay" aria-hidden="true"></div>
        <div class="project__meta">
          <p>Atlasīts projekts · 2026</p>
          <span>230 m²</span>
        </div>
        <div class="project__title">
          <h2 id="project-title">Meža māja</h2>
          <p>Dzīve starp priedēm, gaismu un siltu koku.</p>
        </div>
        <a href="#process" aria-label="Lasīt par Meža mājas projektu">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M8 5h11v11"></path></svg>
        </a>
      </section>

      <section id="process" class="process" aria-labelledby="process-title">
        <header>
          <p class="section-label">No pirmās sarunas līdz mājām</p>
          <h2 id="process-title">Skaidrs process.<br />Viena atbildība.</h2>
        </header>

        <ol>
          {
            process.map(([title, text], index) => (
              <li>
                <span>0{index + 1}</span>
                <div>
                  <h3>{title}</h3>
                  <p>{text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="craft" aria-labelledby="craft-title">
        <figure>
          <img
            src="/images/templates/atelier-majas/atelier-craft.webp"
            alt="Ozolkoka konstrukcijas mezgla izgatavošana ar rokām"
            width="1456"
            height="1092"
            loading="lazy"
          />
        </figure>
        <div class="craft__copy">
          <p class="section-label">Precizitāte, ko var sajust</p>
          <h2 id="craft-title">Labs mezgls nav redzams. Tas ir jūtams pēc desmit gadiem.</h2>
          <p>
            Ilgmūžība sākas ar detaļām — no konstrukcijas savienojuma līdz ēnas līnijai pie durvīm.
            Izvēlamies materiālus, kas noveco skaisti, un risinājumus, kurus var uzturēt.
          </p>
          <dl>
            <div><dt>Materiāli</dt><dd>Vietējs koks, akmens, kaļķa apmetums</dd></div>
            <div><dt>Enerģija</dt><dd>A klases risinājumi un zems patēriņš</dd></div>
            <div><dt>Garantija</dt><dd>Skaidra atbildība arī pēc nodošanas</dd></div>
          </dl>
        </div>
      </section>

      <section class="questions" aria-labelledby="questions-title">
        <header>
          <p class="section-label">Pirms sākam</p>
          <h2 id="questions-title">Bieži jautājumi</h2>
        </header>

        <div>
          <details>
            <summary>Cik ilgs ir mājas tapšanas process?<span aria-hidden="true">+</span></summary>
            <p>
              No pirmās koncepcijas līdz nodošanai parasti nepieciešami 10–16 mēneši. Precīzs
              grafiks atkarīgs no projekta apjoma, saskaņošanas un izvēlētajiem materiāliem.
            </p>
          </details>
          <details>
            <summary>Vai strādājat visā Latvijā?<span aria-hidden="true">+</span></summary>
            <p>
              Jā. Projektējam visā Latvijā, bet būvniecības iespējas un loģistiku izvērtējam pēc
              konkrētās vietas un projekta apjoma.
            </p>
          </details>
          <details>
            <summary
              >Vai iespējams sākt tikai ar koncepciju?<span aria-hidden="true">+</span></summary
            >
            <p>
              Jā. Koncepcijas posms ir atsevišķs pakalpojums, pēc kura varat pieņemt pamatotu lēmumu
              par pilna projekta un būvniecības turpināšanu.
            </p>
          </details>
        </div>
      </section>

      <section id="kontakti" class="contact" aria-labelledby="contact-title">
        <p>Jūsu māja sākas ar sarunu.</p>
        <h2 id="contact-title">Pastāstiet par vietu, kurā vēlaties dzīvot.</h2>
        <a href="mailto:studija@ateliermajas.lv">
          studija@ateliermajas.lv
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M8 5h11v11"></path></svg>
        </a>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand brand--footer" href="#sakums" aria-label="Atelier Mājas sākumlapa">
        <span>Atelier</span>
        <span>Mājas</span>
      </a>

      <div class="site-footer__columns">
        <nav aria-label="Lapas sadaļas">
          <p>Lapa</p>
          <a href="#projekti">Projekti</a>
          <a href="#pieeja">Pieeja</a>
          <a href="#process">Process</a>
        </nav>
        <div>
          <p>Studija</p>
          <span>Liepāja, Latvija</span>
          <a href="tel:+37120000000">+371 20 000 000</a>
          <a href="mailto:studija@ateliermajas.lv">studija@ateliermajas.lv</a>
        </div>
      </div>

      <div class="site-footer__bottom">
        <p>© 2026 Atelier Mājas</p>
        <p>Arhitektūra · Konstrukcijas · Būvniecība</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --paper: #f0f0ec;
    --surface: #dedfd8;
    --ink: #172019;
    --ink-soft: #465048;
    --moss: #6f7958;
    --acid: #dbe898;
    --line: rgb(23 32 25 / 18%);
    --white-line: rgb(255 255 255 / 24%);
    --gutter: clamp(1.25rem, 4.5vw, 4.5rem);
    --type-label: clamp(0.72rem, 0.85vw, 0.9rem);
    --type-title: clamp(1rem, 1.25vw, 1.25rem);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    font-family: 'Manrope Variable', Manrope, ui-sans-serif, system-ui, sans-serif;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    scroll-behavior: smooth;
    background: var(--paper);
  }

  body {
    min-width: 320px;
    margin: 0;
    overflow-x: clip;
    background: var(--paper);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  p,
  figure,
  dl,
  dd {
    margin: 0;
  }

  h1,
  h2,
  h3 {
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img,
  svg {
    display: block;
  }

  img {
    width: 100%;
    height: auto;
  }

  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--acid);
    outline-offset: 4px;
  }

  .site-header {
    position: absolute;
    z-index: 20;
    top: 0;
    right: 0;
    left: 0;
    display: grid;
    min-height: 5.5rem;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 2rem;
    border-bottom: 1px solid var(--white-line);
    padding-inline: var(--gutter);
    color: white;
  }

  .brand {
    display: grid;
    width: max-content;
    font-size: var(--type-title);
    font-weight: 760;
    letter-spacing: -0.035em;
    line-height: 0.8;
    text-transform: uppercase;
  }

  .brand span:last-child {
    margin-left: 0.8rem;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .desktop-nav a,
  .header-action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    font-size: var(--type-label);
    font-weight: 650;
    letter-spacing: 0.025em;
  }

  .desktop-nav a {
    position: relative;
    color: rgb(255 255 255 / 78%);
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: 0.55rem;
    left: 0;
    height: 1px;
    background: white;
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 300ms var(--ease);
  }

  .header-action {
    gap: 0.7rem;
    border: 1px solid rgb(255 255 255 / 54%);
    border-radius: 999px;
    padding: 0.55rem 1rem;
    transition:
      background-color 220ms ease,
      color 220ms ease;
  }

  .header-action svg,
  .contact svg,
  .project > a svg,
  .services article > svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .mobile-nav {
    display: none;
  }

  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    overflow: hidden;
    background: var(--ink);
    color: white;
  }

  .hero > img,
  .hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero > img {
    object-fit: cover;
    object-position: center;
    animation: hero-settle 1400ms var(--ease) both;
  }

  .hero__shade {
    background:
      linear-gradient(to bottom, rgb(7 12 8 / 50%), transparent 35%),
      linear-gradient(to top, rgb(7 12 8 / 78%), transparent 55%),
      linear-gradient(to right, rgb(7 12 8 / 46%), transparent 58%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: end;
    padding: clamp(9rem, 18vh, 13rem) var(--gutter) clamp(3rem, 7vw, 6rem);
  }

  .hero__location,
  .section-label,
  .project__meta,
  .disciplines {
    font-size: clamp(0.68rem, 0.8vw, 0.78rem);
    font-weight: 680;
    letter-spacing: 0.11em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero__location {
    margin-bottom: 1.5rem;
    color: rgb(255 255 255 / 68%);
  }

  .hero h1 {
    max-width: 13ch;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 390;
    letter-spacing: -0.04em;
    line-height: 0.96;
  }

  .hero__bottom {
    display: grid;
    gap: 1.75rem;
    margin-top: clamp(2.5rem, 7vw, 5.5rem);
  }

  .hero__bottom > p {
    max-width: 40rem;
    color: rgb(255 255 255 / 78%);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.7;
  }

  .hero__bottom > a {
    display: inline-flex;
    width: max-content;
    min-height: 3rem;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 54%);
    font-size: var(--type-label);
    font-weight: 720;
  }

  .disciplines {
    display: flex;
    min-height: 5.75rem;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 3vw, 3rem);
    padding: 1.5rem var(--gutter);
    background: var(--ink);
    color: rgb(255 255 255 / 72%);
  }

  .disciplines i {
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: var(--acid);
  }

  .section-label {
    color: var(--moss);
  }

  .intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
    padding: clamp(6rem, 11vw, 11rem) var(--gutter);
  }

  .intro > .section-label {
    grid-column: 1 / 4;
  }

  .intro__copy {
    display: grid;
    grid-column: 4 / 13;
    gap: 2rem;
  }

  .intro__copy h2,
  .services__heading h2,
  .process h2,
  .questions h2 {
    max-width: 16ch;
    font-size: clamp(2.4rem, 5vw, 5.2rem);
    font-weight: 420;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .intro__copy > p {
    max-width: 49rem;
    color: var(--ink-soft);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.75;
  }

  .intro__image {
    margin-top: clamp(3rem, 8vw, 7rem);
  }

  .intro__image img {
    height: 100%;
    object-fit: cover;
  }

  .intro__image figcaption {
    margin-top: 0.8rem;
    color: var(--ink-soft);
    font-size: var(--type-label);
    font-weight: 620;
  }

  .intro__image--wide {
    grid-column: 1 / 9;
  }

  .intro__image--wide img {
    aspect-ratio: 1.42;
  }

  .intro__image--detail {
    grid-column: 9 / 13;
    padding-top: clamp(5rem, 10vw, 10rem);
  }

  .intro__image--detail img {
    aspect-ratio: 0.78;
  }

  .services {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(4rem, 10vw, 10rem);
    padding: clamp(6rem, 10vw, 10rem) var(--gutter);
    background: var(--surface);
  }

  .services__heading {
    display: grid;
    align-content: start;
    gap: 1.5rem;
  }

  .services__list {
    border-top: 1px solid var(--line);
  }

  .services article {
    display: grid;
    min-height: 10rem;
    grid-template-columns: 2rem minmax(9rem, 0.65fr) minmax(14rem, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    border-bottom: 1px solid var(--line);
    padding: 1.75rem 0;
  }

  .services article > span {
    color: var(--moss);
    font-size: var(--type-label);
    font-weight: 700;
  }

  .services h3 {
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    font-weight: 560;
    letter-spacing: -0.035em;
  }

  .services article > p {
    max-width: 34rem;
    color: var(--ink-soft);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.65;
  }

  .services article > svg {
    color: var(--moss);
  }

  .project {
    position: relative;
    display: grid;
    min-height: min(88svh, 58rem);
    overflow: hidden;
    color: white;
  }

  .project > img,
  .project__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .project > img {
    object-fit: cover;
  }

  .project__overlay {
    background:
      linear-gradient(to bottom, rgb(6 10 7 / 54%), transparent 32%),
      linear-gradient(to top, rgb(6 10 7 / 76%), transparent 56%);
  }

  .project__meta,
  .project__title,
  .project > a {
    position: relative;
    z-index: 1;
  }

  .project__meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 2.5rem var(--gutter);
    color: rgb(255 255 255 / 70%);
  }

  .project__title {
    align-self: end;
    padding: 0 var(--gutter) clamp(3rem, 7vw, 6rem);
  }

  .project__title h2 {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 380;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .project__title p {
    margin-top: 1rem;
    color: rgb(255 255 255 / 74%);
    font-size: 1rem;
    font-weight: 500;
  }

  .project > a {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(3rem, 7vw, 6rem);
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 52%);
    border-radius: 50%;
    transition:
      background-color 220ms ease,
      color 220ms ease,
      transform 280ms var(--ease);
  }

