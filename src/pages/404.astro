---
import '@fontsource-variable/manrope';
import '@/styles/global.css';
---

<!doctype html>
<html lang="lv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#080305" />
    <title>Lapa nav atrasta | ROMADI</title>
    <meta
      name="description"
      content="Meklētā lapa nav atrasta. Atgriezieties ROMADI sākumlapā."
    />
    <link rel="icon" href="/favicon.svg" />
  </head>

  <body>
    <main class="not-found">
      <div class="not-found__background" aria-hidden="true">
        <i class="not-found__glow not-found__glow--left"></i>
        <i class="not-found__glow not-found__glow--bottom"></i>
        <i class="not-found__glow not-found__glow--right"></i>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none">
          <filter id="not-found-noise">
            <feTurbulence
              type="fractalNoise"
              baseFrequency="0.9"
              numOctaves="4"
              stitchTiles="stitch"></feTurbulence>
          </filter>
          <rect width="100" height="100" filter="url(#not-found-noise)" opacity="0.42"></rect>
        </svg>
      </div>

      <div class="not-found__content">
        <p class="not-found__code" aria-label="Kļūda 404">404</p>
        <h1>Lapa nav atrasta.</h1>
        <p class="not-found__description">
          Šķiet, ka šī adrese vairs nepastāv vai ceļā ieviesusies kļūda.
        </p>
        <a class="not-found__action" href="/">
          Atgriezties sākumā
        </a>
      </div>

      <p class="not-found__status" aria-hidden="true">
        <span></span>
        ERROR / 404
      </p>
    </main>
  </body>
</html>

<style>
  :global(html) {
    background: #080305;
  }

  :global(body) {
    min-height: 100vh;
    background: #080305;
  }

  .not-found {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 100svh;
    overflow: hidden;
    place-items: center;
    background: #080305;
  }

  .not-found__background {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 48%, transparent 12%, rgb(0 0 0 / 26%) 62%, rgb(0 0 0 / 58%) 100%),
      linear-gradient(118deg, #3c111c 0%, #100709 35%, #090506 67%, #3c2529 100%);
  }

  .not-found__background::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(0 0 0 / 9%), transparent 30%, rgb(0 0 0 / 22%));
    content: '';
  }

  .not-found__background > svg {
    position: absolute;
    z-index: 3;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.22;
    mix-blend-mode: soft-light;
  }

  .not-found__glow {
    position: absolute;
    border-radius: 48% 52% 60% 40%;
    background: radial-gradient(circle, rgb(224 35 78 / 74%), rgb(137 6 43 / 48%) 48%, transparent 72%);
    filter: blur(58px);
    opacity: 0.65;
    animation: not-found-drift 9s ease-in-out infinite alternate;
  }

  .not-found__glow--left {
    top: -24rem;
    left: -18rem;
    width: 52rem;
    height: 49rem;
  }

  .not-found__glow--bottom {
    bottom: -30rem;
    left: 30%;
    width: 50rem;
    height: 52rem;
    animation-delay: -3s;
  }

  .not-found__glow--right {
    top: -22rem;
    right: -21rem;
    width: 47rem;
    height: 45rem;
    opacity: 0.3;
    animation-delay: -6s;
  }

  .not-found__content {
    display: grid;
    justify-items: center;
    width: min(calc(100% - 2rem), 50rem);
    padding: 5rem 0;
    text-align: center;
  }

  .not-found__code {
    color: white;
    font-size: clamp(7rem, 14vw, 14rem);
    font-weight: 440;
    letter-spacing: -0.09em;
    line-height: 0.8;
    text-shadow: 0 2rem 5rem rgb(0 0 0 / 28%);
  }

  .not-found h1 {
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    color: white;
    font: 600 clamp(0.78rem, 0.9vw, 0.9rem)/1.3 var(--font-mono);
    letter-spacing: 0.02em;
  }

  .not-found__description {
    max-width: 34rem;
    margin-top: 0.65rem;
    color: rgb(255 255 255 / 52%);
    font: 500 clamp(0.7rem, 0.82vw, 0.82rem)/1.65 var(--font-mono);
  }

  .not-found__action {
    display: inline-grid;
    min-height: 4rem;
    margin-top: 2rem;
    place-items: center;
    border: 1px solid white;
    border-radius: 1rem;
    padding: 0.85rem 1.55rem;
    background: white;
    box-shadow: 0 1.25rem 3rem rgb(0 0 0 / 22%);
    color: #090909;
    font-size: 0.88rem;
    font-weight: 720;
    line-height: 1;
    transition: box-shadow 280ms ease, transform 280ms var(--ease-out-expo);
  }

  .not-found__action:hover {
    box-shadow: 0 1.6rem 3.5rem rgb(0 0 0 / 34%);
    transform: translateY(-3px);
  }

  .not-found__status {
    position: absolute;
    right: clamp(1.25rem, 3vw, 2.5rem);
    bottom: clamp(1.25rem, 3vw, 2.5rem);
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: rgb(255 255 255 / 32%);
    font: 550 0.58rem/1 var(--font-mono);
    letter-spacing: 0.06em;
  }

  .not-found__status > span {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px rgb(224 35 78 / 55%);
    animation: not-found-status 1.4s ease-in-out infinite;
  }

  @keyframes not-found-drift {
    from { transform: translate3d(-4%, 2%, 0) scale(0.95); }
    to { transform: translate3d(5%, -4%, 0) scale(1.07); }
  }

  @keyframes not-found-status {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }

  @media (max-width: 600px) {
    .not-found__code { font-size: clamp(6.5rem, 36vw, 9rem); }
    .not-found h1 { margin-top: 2.75rem; }
    .not-found__description { max-width: 19rem; }
    .not-found__status { display: none; }
    .not-found__glow--bottom { left: 5%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__glow,
    .not-found__status > span { animation: none; }
  }
</style>
