---
import '@/styles/portal.css';
---

<main class="portal-dashboard" data-portal-dashboard>
  <section class="portal-main">
    <header class="portal-topbar">
      <div>
        <h1>Uzdevumi</h1>
        <p>Vizuālās pārbaudes skats</p>
      </div>
      <button type="button" class="portal-primary-action" data-preview-dialog>Atvērt uzdevumu</button>
    </header>

    <div class="portal-task-grid is-editor-open">
      <section class="portal-task-board">
        <header><div><h2>Uzdevumi</h2><span>2 no 2 uzdevumiem</span></div></header>
        <div class="portal-task-list">
          <button type="button" class="portal-task-item" data-preview-dialog>
            <strong>Sagatavot GetAPro piedāvājumu</strong>
            <small>Roberts · Procesā · 30.09.2026.</small>
            <small>Piešķīra: Roberts</small>
            <b>Augsta</b>
          </button>
        </div>
      </section>

      <aside class="portal-user-directory">
        <header><div><h2>Komanda</h2><span>2 lietotāji</span></div></header>
        <div class="portal-user-list"></div>
      </aside>

      <section class="portal-task-editor">
        <header>
          <div><h2>Jauns uzdevums</h2><p>Piešķir darbu komandai.</p></div>
          <div class="portal-panel-actions">
            <span class="portal-draft-state">Nav saglabāts</span>
            <button type="button" class="portal-icon-action" aria-label="Aizvērt uzdevuma formu">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
            </button>
          </div>
        </header>
        <form class="portal-task-form">
          <div class="portal-form-fields">
            <label class="portal-field is-wide"><span>Nosaukums</span><input value="Sagatavot piedāvājumu" /></label>
            <label class="portal-field"><span>Kur atrasts?</span><select><option>GetAPro</option><option>Cits</option></select></label>
            <label class="portal-field"><span>Cits avots</span><input placeholder="Norādi, kur lead atrasts" /></label>
          </div>
        </form>
      </section>
    </div>
  </section>

  <dialog class="portal-detail-dialog" data-preview-detail>
    <article>
      <header>
        <div><span>Uzdevuma informācija</span><h2>Sagatavot GetAPro piedāvājumu</h2></div>
        <button type="button" class="portal-icon-action" data-preview-close aria-label="Aizvērt uzdevuma informāciju">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </header>
      <div class="portal-detail-content">
        <dl class="portal-detail-list">
          <div class="portal-detail-row"><dt>Statuss</dt><dd>Procesā</dd></div>
          <div class="portal-detail-row"><dt>Prioritāte</dt><dd>Augsta</dd></div>
          <div class="portal-detail-row"><dt>Piešķirts</dt><dd>Roberts</dd></div>
          <div class="portal-detail-row"><dt>Termiņš</dt><dd>30.09.2026.</dd></div>
        </dl>
      </div>
      <footer><button type="button" class="portal-secondary-action" data-preview-close>Aizvērt</button></footer>
    </article>
  </dialog>
</main>

<script>
  const dialog = document.querySelector('[data-preview-detail]');
  document.querySelectorAll('[data-preview-dialog]').forEach((button) => {
    button.addEventListener('click', () => dialog?.showModal());
  });
  document.querySelectorAll('[data-preview-close]').forEach((button) => {
    button.addEventListener('click', () => dialog?.close());
  });
</script>
