---
import { Icon } from 'astro-icon/components';
import { SITE } from '@/config/site';

interface ServiceOption {
  label: string;
  slug?: string;
}

const serviceOptions: ServiceOption[] = [
  ...SITE.services.map((service) => ({ label: service.label, slug: service.slug })),
  { label: 'Aplikāciju izstrāde' },
  { label: 'Mājaslapu, aplikāciju un digitālo produktu uzturēšana' },
  { label: 'Digitāls produkts vai sistēma' },
  { label: 'Cits' },
];

const socialItems = [
  {
    label: 'WhatsApp',
    icon: 'simple-icons:whatsapp',
    href: 'https://wa.me/37126625125',
  },
  {
    label: 'Facebook',
    icon: 'simple-icons:facebook',
    href: SITE.social.facebook,
  },
  {
    label: 'Instagram',
    icon: 'simple-icons:instagram',
    href: SITE.social.instagram,
  },
  {
    label: 'TikTok',
    icon: 'simple-icons:tiktok',
    href: SITE.social.tiktok,
  },
  {
    label: 'LinkedIn',
    icon: 'simple-icons:linkedin',
    href: SITE.social.linkedin,
  },
];
---

<section class="contact" aria-labelledby="contact-title">
  <div class="contact__layout">
    <div class="contact__primary">
      <header class="contact__intro">
        <p class="contact__eyebrow" aria-label="Sāksim sarunu">
          <span
            aria-hidden="true"
            data-typewriter
            data-typewriter-text="{ SĀKSIM SARUNU }"
            data-typewriter-speed="54"></span>
          <span class="contact__cursor" aria-hidden="true">_</span>
        </p>
        <h1 id="contact-title">Pastāstiet par savu ideju.</h1>
        <p class="contact__lead">
          Īsi aprakstiet ieceri, mērķi un vēlamo rezultātu. Atbildēsim vienas darba dienas laikā ar
          precizējošiem jautājumiem un saprotamu nākamo soli.
        </p>
      </header>

      <form
        class="contact-form"
        id="contact-form"
        action="https://formspree.io/f/mljergkn"
        method="POST"
        data-contact-form
        novalidate
      >
        <input type="hidden" name="_subject" value="Jauns projekta pieprasījums no ROMADI.lv" />
        <div class="contact-form__grid">
          <div class="contact-field">
            <label for="contact-name">Vārds <span aria-hidden="true">*</span></label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required />
            <span class="contact-field__error" id="contact-name-error" data-error-for="contact-name"
            ></span>
          </div>

          <div class="contact-field">
            <label for="contact-email">E-pasts <span aria-hidden="true">*</span></label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required />
            <span
              class="contact-field__error"
              id="contact-email-error"
              data-error-for="contact-email"></span>
          </div>

          <div class="contact-field">
            <label for="contact-phone">Tālrunis</label>
            <input id="contact-phone" name="phone" type="tel" autocomplete="tel" />
            <span
              class="contact-field__error"
              id="contact-phone-error"
              data-error-for="contact-phone"></span>
          </div>

          <div class="contact-field">
            <label for="contact-company">Uzņēmums</label>
            <input id="contact-company" name="company" type="text" autocomplete="organization" />
            <span
              class="contact-field__error"
              id="contact-company-error"
              data-error-for="contact-company"></span>
          </div>

          <div class="contact-field contact-field--wide">
            <label for="contact-service"
              >Kas jums nepieciešams? <span aria-hidden="true">*</span></label
            >
            <div class="contact-select">
              <select id="contact-service" name="service" required>
                <option value="">Izvēlieties pakalpojumu</option>
                {
                  serviceOptions.map((option) => (
                    <option value={option.label} data-service-slug={option.slug}>
                      {option.label}
                    </option>
                  ))
                }
              </select>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"></path></svg>
            </div>
            <span
              class="contact-field__error"
              id="contact-service-error"
              data-error-for="contact-service"></span>
          </div>

          <div class="contact-template-option" data-template-option hidden>
            <label for="contact-template">
              <input
                id="contact-template"
                name="templateWebsite"
                type="checkbox"
                value="Jā — interesē veidnes risinājums no 350 €"
                disabled
              />
              <span>
                <strong>Interesē veidnes risinājums no 350 €</strong>
                <small> Gatavu dizaina pamatu pielāgosim ar jūsu logo, krāsām un saturu. </small>
              </span>
            </label>
            <span
              class="contact-field__error"
              id="contact-template-error"
              data-error-for="contact-template"></span>
          </div>

          <div
            class="contact-field contact-field--wide contact-field--product-link"
            data-existing-product-field
            hidden
          >
            <label for="contact-product-link"
              >Esošā produkta saite <span class="contact-field__optional">(ja ir)</span></label
            >
            <input
              id="contact-product-link"
              name="productLink"
              type="url"
              inputmode="url"
              autocomplete="url"
              placeholder="https://"
              disabled
            />
            <span
              class="contact-field__error"
              id="contact-product-link-error"
              data-error-for="contact-product-link"></span>
          </div>

          <div class="contact-field">
            <label for="contact-timeline">Vēlamais termiņš <span aria-hidden="true">*</span></label>
            <div class="contact-select">
              <select id="contact-timeline" name="timeline" required>
                <option value="">Izvēlieties termiņu</option>
                <option>Steidzami</option>
                <option>1–2 mēneši</option>
                <option>3–4 mēneši</option>
                <option>5–6 mēneši</option>
                <option>Vēl nav noteikts</option>
              </select>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"></path></svg>
            </div>
            <span
              class="contact-field__error"
              id="contact-timeline-error"
              data-error-for="contact-timeline"></span>
          </div>

          <div class="contact-field contact-field--budget">
            <div class="contact-budget__heading">
              <label for="contact-budget">Aptuvenais budžets</label>
              <output for="contact-budget" data-budget-output>15 000 €</output>
            </div>
            <input
              id="contact-budget"
              name="budget"
              type="range"
              min="500"
              max="50000"
              step="500"
              value="15000"
            />
            <div class="contact-budget__limits" aria-hidden="true">
              <span>500 €</span><span>50 000 €+</span>
            </div>
          </div>

          <div class="contact-field contact-field--wide contact-field--message" data-message-field>
            <label for="contact-message"
              >Pastāstiet par projektu <span aria-hidden="true">*</span></label
            >
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              placeholder="Ko vēlaties izveidot, kam tas paredzēts un ko risinājumam būtu jāsasniedz?"
              required></textarea>
            <span
              class="contact-field__error"
              id="contact-message-error"
              data-error-for="contact-message"></span>
          </div>
        </div>

        <label class="contact-consent" for="contact-consent">
          <input id="contact-consent" name="consent" type="checkbox" required />
          <span
            >Piekrītu, ka ROMADI izmanto norādīto informāciju, lai sazinātos par manu pieprasījumu.</span
          >
        </label>
        <span
          class="contact-field__error contact-consent__error"
          id="contact-consent-error"
          data-error-for="contact-consent"></span>

        <div class="contact-form__actions">
          <button type="submit" data-submit-button>
            <span data-submit-label>Nosūtīt pieprasījumu</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5"></path></svg
            >
          </button>
          <p class="contact-form__status" data-form-status aria-live="polite"></p>
        </div>
      </form>
    </div>

    <div class="contact-card-shell" data-card-shell>
      <aside class="contact-card" aria-labelledby="contact-card-title">
        <div class="contact-card__content">
          <div>
            <p class="contact-card__label">Saziņa</p>
            <h2 id="contact-card-title">Runāsim par jūsu nākamo projektu.</h2>
            <p class="contact-card__copy">
              Sadarbojamies ar uzņēmumiem no pirmās idejas līdz gatavam, izmērāmam digitālam
              risinājumam.
            </p>
          </div>

          <dl class="contact-card__details">
            <div>
              <dt>E-pasts</dt>
              <dd><a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a></dd>
            </div>
            <div>
              <dt>Tālrunis</dt>
              <dd class="contact-card__phones">
                {SITE.contact.phones.map((phone) => <a href={phone.href}>{phone.display}</a>)}
              </dd>
            </div>
            <div>
              <dt>Atrašanās vieta</dt>
              <dd>{SITE.contact.location.city}, {SITE.contact.location.country}</dd>
            </div>
            <div>
              <dt>Darba laiks</dt>
              <dd>P.–Pk., 09.00–18.00</dd>
            </div>
            <div>
              <dt>Uzņēmums</dt>
              <dd>SIA "ROMADI"</dd>
            </div>
            <div>
              <dt>Reģ. nr.</dt>
              <dd aria-label="40203775218">40203775218</dd>
            </div>
          </dl>

          <div class="contact-card__availability">
            <span aria-hidden="true"></span>
            Pieņemam jaunus projektus
          </div>

          <div class="contact-card__socials" aria-label="ROMADI sociālie tīkli">
            {
              socialItems.map((item) =>
                item.href ? (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={item.label}
                  >
                    <Icon name={item.icon} aria-hidden="true" />
                  </a>
                ) : (
                  <span aria-label={`${item.label} saite tiks pievienota`} aria-disabled="true">
                    <Icon name={item.icon} aria-hidden="true" />
                  </span>
                ),
              )
            }
          </div>
          <p class="contact-card__response">Parasti atbildam vienas darba dienas laikā.</p>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  import { initTypewriters } from '@/lib/animations/typewriter';

  const formatBudget = (value: number): string =>
    new Intl.NumberFormat('lv-LV', {
      style: 'currency',
      currency: 'EUR',
      maximumFractionDigits: 0,
    }).format(value);

  const initContactForm = (): void => {
    initTypewriters();

    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    const budget = form.querySelector<HTMLInputElement>('#contact-budget');
    const budgetOutput = form.querySelector<HTMLOutputElement>('[data-budget-output]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const submitButton = form.querySelector<HTMLButtonElement>('[data-submit-button]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const consent = form.querySelector<HTMLInputElement>('#contact-consent');
    const service = form.querySelector<HTMLSelectElement>('#contact-service');
    const templateOption = form.querySelector<HTMLElement>('[data-template-option]');
    const templateCheckbox = form.querySelector<HTMLInputElement>('#contact-template');
    const productLinkField = form.querySelector<HTMLElement>('[data-existing-product-field]');
    const productLink = form.querySelector<HTMLInputElement>('#contact-product-link');
    const cardShell = document.querySelector<HTMLElement>('[data-card-shell]');
    const messageField = form.querySelector<HTMLElement>('[data-message-field]');
    const card = cardShell?.querySelector<HTMLElement>('.contact-card');

    const existingProductServices = new Set([
      'Mājaslapu, aplikāciju un digitālo produktu uzturēšana',
      'Pārbūve un ilgtermiņa atbalsts',
      'Zīmols un UI/UX dizains',
      'Digitālā izaugsme',
    ]);

    const applyRequestedService = (): void => {
      if (!service) return;
      const requestedSlug = new URLSearchParams(window.location.search).get('pakalpojums');
      if (!requestedSlug) return;

      const matchingOption = Array.from(service.options).find(
        (option) => option.dataset.serviceSlug === requestedSlug,
      );
      if (matchingOption) service.value = matchingOption.value;
    };

    const updateTemplateOption = (): void => {
      if (!service || !templateOption || !templateCheckbox) return;
      const selectedOption = service.options[service.selectedIndex];
      const shouldShow = selectedOption?.dataset.serviceSlug === 'majaslapu-izstrade';
      templateOption.hidden = !shouldShow;
      templateCheckbox.disabled = !shouldShow;
      if (!shouldShow) templateCheckbox.checked = false;
    };

    const applyRequestedTemplate = (): void => {
      if (!templateCheckbox || templateCheckbox.disabled) return;
      const requestedTemplate = new URLSearchParams(window.location.search).get('veidne');
      templateCheckbox.checked = requestedTemplate === '1';
    };

    const updateProductLink = (): void => {
      if (!service || !productLinkField || !productLink) return;
      const shouldShow = existingProductServices.has(service.value);
      productLinkField.hidden = !shouldShow;
      productLink.disabled = !shouldShow;
    };

    const updateCardTrack = (): void => {
      if (!cardShell || !messageField || !card) return;

      if (!window.matchMedia('(min-width: 64.0625rem)').matches) {
        cardShell.style.removeProperty('--contact-card-track');
        return;
      }

      const shellTop = cardShell.getBoundingClientRect().top + window.scrollY;
      const messageBottom = messageField.getBoundingClientRect().bottom + window.scrollY;
      const trackHeight = Math.max(card.offsetHeight, messageBottom - shellTop);
      cardShell.style.setProperty('--contact-card-track', `${trackHeight}px`);
    };

    const updateSubmitState = (): void => {
      if (!submitButton) return;
      submitButton.disabled = !consent?.checked;
    };

    const updateBudget = (): void => {
      if (!budget || !budgetOutput) return;
      const value = Number(budget.value);
      const progress =
        ((value - Number(budget.min)) / (Number(budget.max) - Number(budget.min))) * 100;
      budgetOutput.textContent =
        value === Number(budget.max) ? `${formatBudget(value)}+` : formatBudget(value);
      budget.style.setProperty('--budget-progress', `${progress}%`);
    };

    const validateField = (
      field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
    ): boolean => {
      const error = form.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`);
      let message = '';

      if (field.validity.valueMissing) message = 'Lūdzu, aizpildiet šo lauku.';
      if (field.validity.typeMismatch) message = 'Lūdzu, ievadiet derīgu e-pasta adresi.';

      field.setAttribute('aria-invalid', message ? 'true' : 'false');
      if (error) error.textContent = message;
      return !message;
    };

    form
      .querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        'input:not([type="hidden"]), select, textarea',
      )
      .forEach((field) => {
        if (field.type === 'range') return;
        field.setAttribute('aria-describedby', `${field.id}-error`);
        field.addEventListener(
          field.type === 'checkbox' || field instanceof HTMLSelectElement ? 'change' : 'blur',
          () => validateField(field),
        );
        field.addEventListener('input', () => {
          if (field.getAttribute('aria-invalid') === 'true') validateField(field);
        });
      });

    budget?.addEventListener('input', updateBudget);
    service?.addEventListener('change', () => {
      updateProductLink();
      updateTemplateOption();
      window.requestAnimationFrame(updateCardTrack);
    });
    consent?.addEventListener('change', updateSubmitState);
    applyRequestedService();
    updateBudget();
    updateProductLink();
    updateTemplateOption();
    applyRequestedTemplate();
    updateSubmitState();
    updateCardTrack();

    const cardTrackObserver = new ResizeObserver(updateCardTrack);
    cardTrackObserver.observe(form);
    if (card) cardTrackObserver.observe(card);
    window.addEventListener('resize', updateCardTrack);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const fields = [
        ...form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
          'input:not([type="hidden"]):not([disabled]), select:not([disabled]), textarea:not([disabled])',
        ),
      ].filter((field) => field.type !== 'range');
      const invalidField = fields.find((field) => !validateField(field));

      if (invalidField) {
        invalidField.focus();
        if (status) {
          status.dataset.state = 'error';
          status.textContent = 'Pārbaudiet atzīmētos laukus.';
        }
        return;
      }

      const data = new FormData(form);
      data.set('_subject', `Jauns projekta pieprasījums — ${data.get('name')}`);
      data.set('budget', formatBudget(Number(data.get('budget'))));
      data.set('consent', 'Jā — piekrišana saziņai saņemta');
      data.set('templateWebsite', String(data.get('templateWebsite') || 'Nē'));
      data.set('phone', String(data.get('phone') || 'Nav norādīts'));
      data.set('company', String(data.get('company') || 'Nav norādīts'));
      data.set('productLink', String(data.get('productLink') || 'Nav norādīta'));

      if (submitButton) submitButton.disabled = true;
      if (submitLabel) submitLabel.textContent = 'Nosūtām…';
      form.setAttribute('aria-busy', 'true');
      if (status) {
        delete status.dataset.state;
        status.textContent = 'Nosūtām pieprasījumu…';
      }

      try {
        const response = await fetch(form.action, {
          method: form.method,
          body: data,
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) {
          const result = (await response.json().catch(() => null)) as {
            errors?: Array<{ message?: string }>;
          } | null;
          const responseMessage = result?.errors
            ?.map((error) => error.message)
            .filter(Boolean)
            .join(' ');
          const fallbackMessage =
            response.status === 429
              ? 'Saņemts pārāk daudz pieprasījumu. Lūdzu, uzgaidiet un mēģiniet vēlreiz.'
              : 'Pieprasījumu neizdevās nosūtīt. Lūdzu, mēģiniet vēlreiz.';
          throw new Error(responseMessage || fallbackMessage);
        }

        form.reset();
        applyRequestedService();
        updateProductLink();
        updateTemplateOption();
        applyRequestedTemplate();
        updateBudget();

        if (status) {
          status.dataset.state = 'success';
          status.textContent =
            'Paldies! Pieprasījums nosūtīts. Sazināsimies vienas darba dienas laikā.';
        }
      } catch (error) {
        if (status) {
          status.dataset.state = 'error';
          status.textContent =
            error instanceof Error
              ? error.message
              : 'Pieprasījumu neizdevās nosūtīt. Lūdzu, mēģiniet vēlreiz.';
        }
      } finally {
        form.removeAttribute('aria-busy');
        updateSubmitState();
        if (submitLabel) submitLabel.textContent = 'Nosūtīt pieprasījumu';
      }
    });
  };

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    overflow: clip;
    padding: clamp(9.5rem, 13vw, 12.5rem) 2rem clamp(5rem, 8vw, 8rem);
    background:
      radial-gradient(circle at 79% 18%, rgb(91 7 29 / 24%), transparent 28rem),
      radial-gradient(circle at 9% 71%, rgb(117 9 38 / 12%), transparent 25rem), #050505;
  }

  .contact::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.92' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.32'/%3E%3C/svg%3E");
    content: '';
    opacity: 0.055;
    pointer-events: none;
  }

  .contact__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(21rem, 0.75fr);
    gap: clamp(3rem, 7vw, 7rem);
    width: min(100%, 88rem);
    margin-inline: auto;
    align-items: start;
  }

  .contact__primary {
    min-width: 0;
  }

  .contact__intro {
    max-width: 52rem;
  }

  .contact__eyebrow {
    display: flex;
    min-height: 0.85rem;
    align-items: baseline;
    gap: 0.6ch;
    margin: 0 0 1.4rem;
    color: rgb(255 255 255 / 46%);
    font: 600 0.66rem/1.2 var(--font-mono);
    letter-spacing: 0.04em;
  }

  .contact__cursor {
    margin-left: 0.4ch;
    opacity: 0;
    animation: contact-cursor 1.15s steps(1, end) infinite;
  }

  .contact__eyebrow span[data-typewriter-active='true'] + .contact__cursor {
    opacity: 1;
  }

  .contact h1 {
    max-width: 49rem;
    margin: 0;
    color: #fff;
    font-size: clamp(3rem, 5.2vw, 5.25rem);
    font-weight: 450;
    letter-spacing: -0.06em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .contact__lead {
    max-width: 46rem;
    margin: clamp(2rem, 4vw, 3.5rem) 0 0;
    color: rgb(255 255 255 / 58%);
    font: 500 clamp(0.84rem, 1.1vw, 0.95rem)/1.75 var(--font-mono);
  }

  .contact-form {
    margin-top: clamp(3.5rem, 6vw, 5.5rem);
  }

  .contact-form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.35rem clamp(1.5rem, 4vw, 3.5rem);
  }

  .contact-field {
    position: relative;
    min-width: 0;
  }
  .contact-field--wide {
    grid-column: 1 / -1;
  }
  .contact-field[hidden] {
    display: none;
  }

  .contact-template-option {
    grid-column: 1 / -1;
    margin-top: -0.75rem;
  }

  .contact-template-option[hidden] {
    display: none;
  }

  .contact-template-option label {
    display: flex;
    min-height: 4.5rem;
    align-items: flex-start;
    gap: 0.9rem;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 0.75rem;
    padding: 1rem 1.1rem;
    background: rgb(255 255 255 / 2.5%);
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .contact-template-option label:hover {
    border-color: rgb(255 255 255 / 25%);
    background: rgb(255 255 255 / 4%);
  }

  .contact-template-option input {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
    margin: 0.18rem 0 0;
    accent-color: var(--accent);
  }

  .contact-template-option label > span {
    display: grid;
    gap: 0.35rem;
  }

  .contact-template-option strong {
    color: white;
    font-size: 0.92rem;
    font-weight: 650;
    letter-spacing: -0.015em;
