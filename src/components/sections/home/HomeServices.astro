---
const services = [
  {
    number: '01',
    title: 'Mājaslapu izstrāde',
    description:
      'Ātras, pārdomātas un viegli uzturamas mājaslapas, kas palīdz apmeklētājam saprast piedāvājumu un spert nākamo soli.',
  },
  {
    number: '02',
    title: 'Interneta veikali',
    description:
      'E-komercijas risinājumi ar skaidru produktu struktūru, ērtu pirkšanas plūsmu un pamatiem mērīšanai, piegādei un izaugsmei.',
  },
  {
    number: '03',
    title: 'Digitālie produkti un sistēmas',
    description:
      'Portāli, klientu zonas, rezervācijas, iekšējie rīki un citas sistēmas, kas samazina manuālo darbu un sakārto procesus.',
  },
  {
    number: '04',
    title: 'Zīmols un dizains',
    description:
      'Vizuālā identitāte, interfeisa dizains un komunikācijas materiāli, kas palīdz zīmolam izskatīties pārliecinoši visos kanālos.',
  },
  {
    number: '05',
    title: 'AI un automatizācija',
    description:
      'Praktiski AI palīgi, automatizētas darbplūsmas un integrācijas, kas ietaupa laiku ikdienas komandai, nevis tikai izskatās gudri prezentācijā.',
  },
  {
    number: '06',
    title: 'Digitālā izaugsme',
    description:
      'Analītika, konversiju uzlabojumi, SEO pamati un kampaņu tehniskā puse, lai digitālais risinājums turpina pelnīt uzmanību.',
  },
  {
    number: '07',
    title: 'Pārbūve un ilgtermiņa atbalsts',
    description:
      'Esošu lapu sakārtošana, tehniskā pārbūve, uzturēšana un nepārtraukts atbalsts, kad projektam jāaug bez haosa.',
  },
];
---

<section class="home-services" aria-labelledby="home-services-title">
  <div class="home-services__inner">
    <div class="home-services__intro" data-reveal>
      <div class="home-services__heading-group">
        <p class="home-services__eyebrow" aria-label="Pakalpojumi">
          <span
            aria-hidden="true"
            data-typewriter
            data-typewriter-text="{ PAKALPOJUMI }"
            data-typewriter-speed="54"></span>
          <span class="home-services__cursor" aria-hidden="true">_</span>
        </p>

        <h2 id="home-services-title">
          Digitāli risinājumi, kas sākas ar skaidru domu un beidzas ar darbu, kas strādā.
        </h2>
      </div>

      <p class="home-services__description">
        Palīdzam uzņēmumiem izveidot, uzlabot un ilgtermiņā attīstīt digitālo klātbūtni: no
        mājaslapām un e-veikaliem līdz sistēmām, automatizācijai, dizainam un praktiskai izaugsmei
        pēc palaišanas.
      </p>
    </div>

    <div class="home-services__deck-wrap" data-reveal>
      <div
        class="home-services__deck"
        aria-label="ROMADI pakalpojumu kategorijas"
        data-services-carousel
      >
        {
          services.map((service, index) => (
            <article
              class="home-services__card"
              style={`--card-index: ${index};`}
              tabindex="0"
              data-service-card
            >
              <span class="home-services__sun" aria-hidden="true">
                <span class="home-services__sun-rays" />
              </span>

              <span class="home-services__number">{service.number}</span>

              <span class="home-services__icon-placeholder" aria-hidden="true">
                <span />
              </span>

              <div class="home-services__copy">
                <h3>{service.title}</h3>
                <p>{service.description}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="home-services__controls" aria-label="Pakalpojumu karuseļa vadība">
        <div class="home-services__arrows">
          <button
            class="home-services__arrow"
            type="button"
            aria-label="Iepriekšējais pakalpojums"
            data-services-carousel-prev
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M15 18L9 12L15 6"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>

          <button
            class="home-services__arrow"
            type="button"
            aria-label="Nākamais pakalpojums"
            data-services-carousel-next
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M9 6L15 12L9 18"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>

        <p class="home-services__count" aria-live="polite">
          <span data-services-carousel-index>1</span>
          <span aria-hidden="true">/</span>
          <span>{services.length}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initTypewriters } from '@/lib/animations/typewriter';

  const DESKTOP_QUERY = '(min-width: 901px)';

  const restingX = [0.02, 0.16, 0.31, 0.47, 0.62, 0.76, 0.89];
  const restingY = [0.02, -0.09, 0.05, 0.02, -0.04, 0.11, 0.02];
  const restingRotations = [0, 5, -5, 0, -5, 5, 0];
  const restingLayers = [1, 4, 5, 2, 4, 6, 2];

  const selectedX = [
    [0.08, 0.31, 0.43, 0.56, 0.68, 0.79, 0.92],
    [0.02, 0.23, 0.4, 0.54, 0.66, 0.78, 0.92],
    [0.02, 0.14, 0.35, 0.53, 0.66, 0.78, 0.92],
    [0.02, 0.13, 0.23, 0.51, 0.77, 0.87, 0.94],
    [0.02, 0.14, 0.26, 0.39, 0.61, 0.78, 0.93],
    [0.02, 0.14, 0.26, 0.39, 0.52, 0.73, 0.92],
    [0.02, 0.14, 0.26, 0.4, 0.53, 0.65, 0.89],
  ];

  const selectedY = [
    [0, -0.1, 0.05, 0.02, -0.08, 0.12, 0],
    [0, 0, 0.04, 0.02, -0.08, 0.13, 0],
    [0.02, -0.13, 0, 0.02, -0.08, 0.12, 0],
    [0.02, -0.13, 0.1, 0, -0.08, 0.12, 0],
    [0.02, -0.13, 0.1, 0.03, 0, 0.1, 0],
    [0.02, -0.13, 0.1, 0.03, -0.06, 0, 0],
    [0.02, -0.13, 0.1, 0.03, -0.06, 0.08, 0],
  ];

  const selectedRotations = [
    [0, 5, -5, 0, -5, 5, 0],
    [0, 0, -5, 0, -5, 5, 0],
    [0, 5, 0, 0, -5, 5, 0],
    [0, 5, -5, 0, -5, 5, 0],
    [0, 5, -5, 0, 0, 5, 0],
    [0, 5, -5, 0, -5, 0, 0],
    [0, 5, -5, 0, -5, 5, 0],
  ];

  const selectedLayers = [
    [50, 5, 6, 3, 7, 8, 4],
    [2, 50, 6, 4, 7, 8, 3],
    [1, 7, 50, 4, 8, 9, 3],
    [1, 7, 8, 50, 9, 10, 3],
    [1, 7, 8, 4, 50, 10, 3],
    [1, 7, 8, 4, 9, 50, 3],
    [1, 7, 8, 4, 9, 10, 50],
  ];

  const initServicesCarousels = (): void => {
    document.querySelectorAll<HTMLElement>('.home-services').forEach((section) => {
      if (section.dataset.servicesCarouselInitialized === 'true') {
        return;
      }

      const carousel = section.querySelector<HTMLElement>('[data-services-carousel]');
      const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-service-card]'));
      const previousButton = section.querySelector<HTMLButtonElement>(
        '[data-services-carousel-prev]',
      );
      const nextButton = section.querySelector<HTMLButtonElement>('[data-services-carousel-next]');
      const indexElement = section.querySelector<HTMLElement>('[data-services-carousel-index]');

      if (!carousel || !cards.length || !previousButton || !nextButton || !indexElement) {
        return;
      }

      section.dataset.servicesCarouselInitialized = 'true';

      const desktopMedia = window.matchMedia(DESKTOP_QUERY);
      let desktopActiveIndex: number | null = null;
      let scrollFrame = 0;
      let resizeFrame = 0;

      const getMobileActiveIndex = (): number => {
        const carouselBounds = carousel.getBoundingClientRect();
        const carouselCenter = carouselBounds.left + carouselBounds.width / 2;

        return cards.reduce(
          (closest, card, index) => {
            const cardBounds = card.getBoundingClientRect();
            const distance = Math.abs(cardBounds.left + cardBounds.width / 2 - carouselCenter);

            return distance < closest.distance ? { index, distance } : closest;
          },
          { index: 0, distance: Number.POSITIVE_INFINITY },
        ).index;
      };

      const updateMobileActiveCard = (): void => {
        if (desktopMedia.matches) {
          return;
        }

        const activeIndex = getMobileActiveIndex();
        indexElement.textContent = String(activeIndex + 1);

        cards.forEach((card, index) => {
          const isActive = index === activeIndex;
          card.dataset.active = String(isActive);
          card.setAttribute('aria-expanded', String(isActive));
        });
      };

      const applyDesktopLayout = (activeIndex: number | null): void => {
        if (!desktopMedia.matches) {
          carousel.removeAttribute('data-hovered');
          cards.forEach((card) => {
            card.style.removeProperty('--card-x');
            card.style.removeProperty('--card-y');
            card.style.removeProperty('--card-rotation');
            card.style.removeProperty('--card-layer');
            card.removeAttribute('data-side');
          });
          updateMobileActiveCard();
          return;
        }

        const deckWidth = carousel.clientWidth;
        const cardSize = cards[0]?.offsetWidth ?? 0;

        if (!deckWidth || !cardSize) {
          return;
        }

        const maxX = Math.max(deckWidth - cardSize, 0);

        if (activeIndex === null) {
          carousel.removeAttribute('data-hovered');
        } else {
          carousel.dataset.hovered = String(activeIndex);
        }

        const activeX = selectedX[activeIndex ?? -1];
        const xRatios = activeX ?? restingX;
        const rawCardXs = cards.map((_, index) => maxX * (xRatios[index] ?? restingX[index] ?? 0));
        const spreadStart = Math.min(...rawCardXs);
        const spreadEnd = Math.max(...rawCardXs.map((x) => x + cardSize));
        const spreadWidth = spreadEnd - spreadStart;
        const centerOffset = (deckWidth - spreadWidth) / 2 - spreadStart;

        cards.forEach((card, index) => {
          const activeY = selectedY[activeIndex ?? -1];
          const activeRotations = selectedRotations[activeIndex ?? -1];
          const activeLayers = selectedLayers[activeIndex ?? -1];

          const xRatio = xRatios[index] ?? 0;
          let yRatio = activeY?.[index] ?? restingY[index] ?? 0;
          let rotation = activeRotations?.[index] ?? restingRotations[index] ?? 0;
          let side = 'rest';
          let layer = activeLayers?.[index] ?? restingLayers[index] ?? index + 1;
          const isActive = index === activeIndex;
          const x = maxX * xRatio + centerOffset;

          if (activeIndex !== null) {
            if (index < activeIndex) {
              side = 'left';
            } else if (index > activeIndex) {
              side = 'right';
            } else {
              side = 'active';
            }
          }

          card.style.setProperty('--card-x', `${x.toFixed(2)}px`);
          card.style.setProperty('--card-y', `${(cardSize * yRatio).toFixed(2)}px`);
          card.style.setProperty('--card-rotation', `${rotation}deg`);
          card.style.setProperty('--card-layer', String(layer));
          card.dataset.side = side;
          card.dataset.active = String(isActive);
          card.setAttribute('aria-expanded', String(isActive));
        });
      };

      const setDesktopActiveCard = (index: number | null): void => {
        if (!desktopMedia.matches) {
          return;
        }

        desktopActiveIndex = index;
        applyDesktopLayout(index);
      };

      const scrollToCard = (index: number): void => {
        const currentIndex = desktopMedia.matches
          ? (desktopActiveIndex ?? 0)
          : getMobileActiveIndex();
        const nextIndex = (index + cards.length) % cards.length;

        if (desktopMedia.matches) {
          setDesktopActiveCard(nextIndex);
          cards[nextIndex]?.focus({ preventScroll: true });
          indexElement.textContent = String(nextIndex + 1);
          return;
        }

        cards[nextIndex]?.scrollIntoView({
          behavior: 'smooth',
          block: 'nearest',
          inline: 'center',
        });

        if (currentIndex === nextIndex) {
          updateMobileActiveCard();
        }
      };

      previousButton.addEventListener('click', () => {
        const currentIndex = desktopMedia.matches
          ? (desktopActiveIndex ?? 0)
          : getMobileActiveIndex();
        scrollToCard(currentIndex - 1);
      });

      nextButton.addEventListener('click', () => {
        const currentIndex = desktopMedia.matches
          ? (desktopActiveIndex ?? 0)
          : getMobileActiveIndex();
        scrollToCard(currentIndex + 1);
      });

      cards.forEach((card, index) => {
        card.addEventListener('pointerenter', () => {
          setDesktopActiveCard(index);
        });

        card.addEventListener('pointermove', (event) => {
          if (!desktopMedia.matches || desktopActiveIndex !== index) {
            return;
          }

          const bounds = card.getBoundingClientRect();
          const normalizedX = (event.clientX - bounds.left) / bounds.width - 0.5;
          const normalizedY = (event.clientY - bounds.top) / bounds.height - 0.5;

          card.style.setProperty('--sun-pointer-x', `${(normalizedX * 4.5).toFixed(2)}%`);
          card.style.setProperty('--sun-pointer-y', `${(normalizedY * 2.5).toFixed(2)}%`);
        });

        card.addEventListener('pointerleave', () => {
          card.style.removeProperty('--sun-pointer-x');
          card.style.removeProperty('--sun-pointer-y');
        });

        card.addEventListener('focus', () => {
          setDesktopActiveCard(index);
          indexElement.textContent = String(index + 1);
        });
      });

      carousel.addEventListener('pointerleave', () => {
        if (!desktopMedia.matches) {
          return;
        }

        const focusedIndex = cards.findIndex((card) => card === document.activeElement);

        setDesktopActiveCard(focusedIndex >= 0 ? focusedIndex : null);
      });

      carousel.addEventListener('focusout', () => {
        window.requestAnimationFrame(() => {
          if (!desktopMedia.matches || carousel.contains(document.activeElement)) {
            return;
          }

          setDesktopActiveCard(null);
        });
      });

      carousel.addEventListener('scroll', () => {
        window.cancelAnimationFrame(scrollFrame);
        scrollFrame = window.requestAnimationFrame(updateMobileActiveCard);
      });

      const handleResize = (): void => {
        window.cancelAnimationFrame(resizeFrame);
        resizeFrame = window.requestAnimationFrame(() => {
          applyDesktopLayout(desktopMedia.matches ? desktopActiveIndex : null);
        });
      };

      window.addEventListener('resize', handleResize, { passive: true });
      desktopMedia.addEventListener('change', handleResize);

      applyDesktopLayout(null);
      updateMobileActiveCard();
    });
  };

  const initializeServices = (): void => {
    initTypewriters();
    initServicesCarousels();
  };

  initializeServices();
  document.addEventListener('astro:page-load', initializeServices);
</script>

<style>
  .home-services {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 2.5vw, 2.5rem) 0 clamp(7rem, 11vw, 10rem);
    background: var(--color-ink-950);
  }

  .home-services::before {
    position: absolute;
    right: -18rem;
    bottom: 4rem;
    width: 38rem;
    height: 38rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 4%);
    filter: blur(120px);
    content: '';
    pointer-events: none;
  }

  .home-services__inner {
    position: relative;
    z-index: 1;
    width: min(calc(100% - 2rem), 118.75rem);
    margin-inline: auto;
  }

  .home-services__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem);
    gap: clamp(3rem, 10vw, 13rem);
    width: min(calc(100% - 3rem), 82rem);
    margin-inline: auto;
  }

  .home-services__heading-group {
    display: grid;
    gap: clamp(1.15rem, 2vw, 1.75rem);
  }

  .home-services__eyebrow {
    display: flex;
    min-height: 1.2rem;
    align-items: baseline;
    gap: 0.6ch;
    color: rgb(255 255 255 / 48%);
    font-family: var(--font-mono);
    font-size: clamp(0.66rem, 0.8vw, 0.78rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .home-services__cursor {
    opacity: 0;
    animation: home-services-cursor 1.15s steps(1, end) infinite;
  }

  .home-services__eyebrow span[data-typewriter-active='true'] + .home-services__cursor {
    opacity: 1;
  }

  .home-services h2 {
    max-width: 47rem;
    color: white;
    font-size: clamp(2rem, 3.4vw, 3.55rem);
    font-weight: 560;
    letter-spacing: 0;
    line-height: 1.26;
  }

  .home-services__description {
    align-self: start;
    margin-top: clamp(2.4rem, 4vw, 3.75rem);
    color: rgb(255 255 255 / 56%);
    font-family: var(--font-mono);
    font-size: clamp(0.88rem, 1vw, 1rem);
    font-weight: 500;
    line-height: 1.7;
  }

  .home-services__deck-wrap {
    width: 100%;
    margin-top: clamp(5.5rem, 9vw, 8.5rem);
    overflow: visible;
  }

  .home-services__controls {
    display: none;
  }

  .home-services__deck {
    --card-width: clamp(17rem, 21vw, 21.75rem);
    --card-height: clamp(19rem, 27vw, 25rem);

    position: relative;
    width: min(calc(100% - 2rem), 118.75rem);
    height: calc(var(--card-height) + 3.5rem);
    margin-inline: auto;
  }

  .home-services__card {
    --sun-pointer-x: 0%;
    --sun-pointer-y: 0%;

    position: absolute;
    z-index: var(--card-layer, 1);
    top: 1.6rem;
    left: 0;
    isolation: isolate;
    display: grid;
    width: var(--card-width);
    height: var(--card-height);
    overflow: hidden;
    grid-template-rows: auto 1fr auto;
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: 1.35rem;
    padding: clamp(1.1rem, 1.8vw, 1.45rem);
    background:
      linear-gradient(145deg, rgb(255 255 255 / 4.5%), transparent 34%),
      linear-gradient(rgb(255 255 255 / 3.5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 3.5%) 1px, transparent 1px), #171717;
    background-position:
      0 0,
      50% 50%,
      50% 50%,
      0 0;
    background-size:
      auto,
      4.6rem 4.6rem,
      4.6rem 4.6rem,
      auto;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 10%),
      inset 0 -1px 0 rgb(255 255 255 / 3%),
      0 1.75rem 4.6rem rgb(0 0 0 / 44%);
    color: white;
    cursor: default;
    outline: none;
    transform: translate3d(var(--card-x, 0), var(--card-y, 0), 0) rotate(var(--card-rotation, 0deg));
    transform-origin: center;
    will-change: transform;
    transition:
      transform 860ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 520ms ease,
      box-shadow 760ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 520ms ease,
      opacity 420ms ease;
  }

  .home-services__card::before,
  .home-services__card::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  .home-services__card::before {
    z-index: 0;
    background:
      radial-gradient(circle at 22% 29%, rgb(255 255 255 / 6%) 0 0.06rem, transparent 0.09rem),
      radial-gradient(circle at 71% 63%, rgb(255 255 255 / 5%) 0 0.055rem, transparent 0.085rem),
      radial-gradient(circle at 42% 81%, rgb(255 255 255 / 4%) 0 0.045rem, transparent 0.075rem);
    background-size:
      1.35rem 1.35rem,
      1.75rem 1.75rem,
      2.2rem 2.2rem;
    opacity: 0.26;
    mix-blend-mode: screen;
  }

  .home-services__card::after {
    z-index: 2;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 2.5%), transparent 19%),
      radial-gradient(ellipse at center, transparent 48%, rgb(0 0 0 / 17%) 100%);
    box-shadow: inset 0 0 4rem rgb(0 0 0 / 10%);
  }

  .home-services__sun {
    position: absolute;
    z-index: 1;
    inset: -32%;
    overflow: hidden;
    border-radius: 40%;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(calc(7% + var(--sun-pointer-x)), calc(-10% + var(--sun-pointer-y)), 0)
      rotate(-4deg) scale(1.04);
    transform-origin: 60% 20%;
    transition: opacity 420ms ease;
    will-change: transform, opacity;
  }

  .home-services__sun::before,
  .home-services__sun::after,
  .home-services__sun-rays {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
  }

  .home-services__sun::before {
    background:
      radial-gradient(
        ellipse 30% 20% at 59% 24%,
        rgb(255 255 255 / 39%) 0%,
        rgb(255 255 255 / 22%) 28%,
        rgb(255 255 255 / 8%) 49%,
        transparent 74%
      ),
      radial-gradient(
        ellipse 44% 30% at 66% 17%,
        rgb(255 255 255 / 17%) 0%,
        rgb(255 255 255 / 6%) 44%,
        transparent 76%
      );
    filter: blur(clamp(0.8rem, 1vw, 1.2rem));
    mix-blend-mode: screen;
  }

  .home-services__sun::after {
    background:
      linear-gradient(
        124deg,
        transparent 25%,
        rgb(255 255 255 / 3%) 34%,
        rgb(255 255 255 / 18%) 40%,
        rgb(255 255 255 / 5%) 46%,
        transparent 54%
      ),
      linear-gradient(
        112deg,
        transparent 41%,
        rgb(255 255 255 / 10%) 48%,
        rgb(255 255 255 / 3%) 54%,
        transparent 61%
      );
    filter: blur(clamp(0.55rem, 0.75vw, 0.9rem));
    mask-image: radial-gradient(ellipse 46% 37% at 61% 25%, #000 0 38%, transparent 82%);
    mix-blend-mode: screen;
    opacity: 0.95;
  }

  .home-services__sun-rays {
    background: conic-gradient(
      from 211deg at 61% 14%,
      transparent 0deg 9deg,
      rgb(255 255 255 / 14%) 14deg 20deg,
      transparent 25deg 39deg,
      rgb(255 255 255 / 8%) 44deg 51deg,
      transparent 57deg 78deg,
      rgb(255 255 255 / 12%) 83deg 89deg,
      transparent 96deg 360deg
    );
    filter: blur(clamp(0.8rem, 1.15vw, 1.35rem));
    mask-image: radial-gradient(ellipse 48% 40% at 60% 24%, #000 0 30%, transparent 78%);
    mix-blend-mode: screen;
    opacity: 0.78;
  }

  .home-services__number,
  .home-services__icon-placeholder,
  .home-services__copy {
    position: relative;
    z-index: 3;
  }

  .home-services__number {
    color: rgb(255 255 255 / 34%);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
    transition:
      color 380ms ease,
