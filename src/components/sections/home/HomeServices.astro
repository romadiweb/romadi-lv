---
const services = [
  {
    number: '01',
    title: 'Mājaslapu izstrāde',
    description:
      'Ātras, pārdomātas un viegli uzturamas mājaslapas, kas palīdz apmeklētājam saprast piedāvājumu un spert nākamo soli.',
  },
  {
    number: '02',
    title: 'Interneta veikali',
    description:
      'E-komercijas risinājumi ar skaidru produktu struktūru, ērtu pirkšanas plūsmu un pamatiem mērīšanai, piegādei un izaugsmei.',
  },
  {
    number: '03',
    title: 'Digitālie produkti un sistēmas',
    description:
      'Portāli, klientu zonas, rezervācijas, iekšējie rīki un citas sistēmas, kas samazina manuālo darbu un sakārto procesus.',
  },
  {
    number: '04',
    title: 'Zīmols un dizains',
    description:
      'Vizuālā identitāte, interfeisa dizains un komunikācijas materiāli, kas palīdz zīmolam izskatīties pārliecinoši visos kanālos.',
  },
  {
    number: '05',
    title: 'AI un automatizācija',
    description:
      'Praktiski AI palīgi, automatizētas darbplūsmas un integrācijas, kas ietaupa laiku ikdienas komandai, nevis tikai izskatās gudri prezentācijā.',
  },
  {
    number: '06',
    title: 'Digitālā izaugsme',
    description:
      'Analītika, konversiju uzlabojumi, SEO pamati un kampaņu tehniskā puse, lai digitālais risinājums turpina pelnīt uzmanību.',
  },
  {
    number: '07',
    title: 'Pārbūve un ilgtermiņa atbalsts',
    description:
      'Esošu lapu sakārtošana, tehniskā pārbūve, uzturēšana un nepārtraukts atbalsts, kad projektam jāaug bez haosa.',
  },
];
---

<section class="home-services" aria-labelledby="home-services-title">
  <div class="home-services__inner">
    <div class="home-services__intro" data-reveal>
      <div class="home-services__heading-group">
        <p class="home-services__eyebrow" aria-label="Pakalpojumi">
          <span
            aria-hidden="true"
            data-typewriter
            data-typewriter-text="{ PAKALPOJUMI }"
            data-typewriter-speed="54"></span>
          <span class="home-services__cursor" aria-hidden="true">_</span>
        </p>

        <h2 id="home-services-title">
          Digitāli risinājumi, kas sākas ar skaidru domu un beidzas ar darbu, kas strādā.
        </h2>
      </div>

      <p class="home-services__description">
        Palīdzam uzņēmumiem izveidot, uzlabot un ilgtermiņā attīstīt digitālo klātbūtni: no
        mājaslapām un e-veikaliem līdz sistēmām, automatizācijai, dizainam un praktiskai izaugsmei
        pēc palaišanas.
      </p>
    </div>

    <div class="home-services__deck-wrap" data-reveal>
      <div
        class="home-services__deck"
        aria-label="ROMADI pakalpojumu kategorijas"
        data-services-carousel
      >
        {
          services.map((service, index) => (
            <article class="home-services__card" style={`--card-index: ${index};`} tabindex="0">
              <span class="home-services__number">{service.number}</span>
              <span class="home-services__icon-placeholder" aria-hidden="true">
                <span />
              </span>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </article>
          ))
        }
      </div>

      <div class="home-services__controls" aria-label="Pakalpojumu karuseļa vadība">
        <div class="home-services__arrows">
          <button
            class="home-services__arrow"
            type="button"
            aria-label="Iepriekšējais pakalpojums"
            data-services-carousel-prev
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M15 18L9 12L15 6"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>

          <button
            class="home-services__arrow"
            type="button"
            aria-label="Nākamais pakalpojums"
            data-services-carousel-next
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M9 6L15 12L9 18"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>

        <p class="home-services__count" aria-live="polite">
          <span data-services-carousel-index>1</span>
          <span aria-hidden="true">/</span>
          <span>{services.length}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initTypewriters } from '@/lib/animations/typewriter';

  const initServicesCarousels = (): void => {
    document.querySelectorAll<HTMLElement>('.home-services').forEach((section) => {
      if (section.dataset.servicesCarouselInitialized === 'true') {
        return;
      }

      const carousel = section.querySelector<HTMLElement>('[data-services-carousel]');
      const cards = Array.from(section.querySelectorAll<HTMLElement>('.home-services__card'));
      const previousButton = section.querySelector<HTMLButtonElement>(
        '[data-services-carousel-prev]',
      );
      const nextButton = section.querySelector<HTMLButtonElement>('[data-services-carousel-next]');
      const indexElement = section.querySelector<HTMLElement>('[data-services-carousel-index]');

      if (!carousel || !cards.length || !previousButton || !nextButton || !indexElement) {
        return;
      }

      section.dataset.servicesCarouselInitialized = 'true';

      const getActiveIndex = (): number => {
        const carouselBounds = carousel.getBoundingClientRect();
        const carouselCenter = carouselBounds.left + carouselBounds.width / 2;

        return cards.reduce(
          (closest, card, index) => {
            const cardBounds = card.getBoundingClientRect();
            const distance = Math.abs(cardBounds.left + cardBounds.width / 2 - carouselCenter);

            return distance < closest.distance ? { index, distance } : closest;
          },
          { index: 0, distance: Number.POSITIVE_INFINITY },
        ).index;
      };

      const updateActiveCard = (): void => {
        const activeIndex = getActiveIndex();
        indexElement.textContent = String(activeIndex + 1);

        cards.forEach((card, index) => {
          card.dataset.active = index === activeIndex ? 'true' : 'false';
        });
      };

      const scrollToCard = (index: number): void => {
        const nextIndex = (index + cards.length) % cards.length;
        cards[nextIndex]?.scrollIntoView({
          behavior: 'smooth',
          block: 'nearest',
          inline: 'center',
        });
      };

      previousButton.addEventListener('click', () => {
        scrollToCard(getActiveIndex() - 1);
      });

      nextButton.addEventListener('click', () => {
        scrollToCard(getActiveIndex() + 1);
      });

      carousel.addEventListener('scroll', () => {
        window.requestAnimationFrame(updateActiveCard);
      });

      window.addEventListener('resize', updateActiveCard);
      updateActiveCard();
    });
  };

  const initializeServices = (): void => {
    initTypewriters();
    initServicesCarousels();
  };

  initializeServices();

  document.addEventListener('astro:page-load', initializeServices);
</script>

<style>
  .home-services {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 2.5vw, 2.5rem) 0 clamp(7rem, 11vw, 10rem);
    background: var(--color-ink-950);
  }

  .home-services::before {
    position: absolute;
    inset: auto -18rem 4rem auto;
    width: 38rem;
    height: 38rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 4%);
    filter: blur(120px);
    content: '';
    pointer-events: none;
  }

  .home-services__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 96rem);
    margin-inline: auto;
  }

  .home-services__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 28rem);
    gap: clamp(3rem, 10vw, 13rem);
    width: min(calc(100% - 3rem), 82rem);
    margin-inline: auto;
  }

  .home-services__heading-group {
    display: grid;
    gap: clamp(1.15rem, 2vw, 1.75rem);
  }

  .home-services__eyebrow {
    display: flex;
    min-height: 1.2rem;
    align-items: baseline;
    gap: 0.6ch;
    color: rgb(255 255 255 / 48%);
    font-family: var(--font-mono);
    font-size: clamp(0.66rem, 0.8vw, 0.78rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .home-services__cursor {
    opacity: 0;
    animation: home-services-cursor 1.15s steps(1, end) infinite;
  }

  .home-services__eyebrow span[data-typewriter-active='true'] + .home-services__cursor {
    opacity: 1;
  }

  .home-services h2 {
    max-width: 47rem;
    color: white;
    font-size: clamp(2rem, 3.4vw, 3.55rem);
    font-weight: 560;
    letter-spacing: 0;
    line-height: 1.26;
  }

  .home-services__description {
    align-self: start;
    margin-top: clamp(2.4rem, 4vw, 3.75rem);
    color: rgb(255 255 255 / 56%);
    font-family: var(--font-mono);
    font-size: clamp(0.88rem, 1vw, 1rem);
    font-weight: 500;
    line-height: 1.7;
  }

  .home-services__deck-wrap {
    width: 100%;
    margin-top: clamp(5.5rem, 9vw, 8.5rem);
    overflow: visible;
  }

  .home-services__controls {
    display: none;
  }

  .home-services__deck {
    --card-width: clamp(17rem, 21vw, 21.75rem);
    --card-height: clamp(19rem, 27vw, 25rem);

    position: relative;
    width: min(100%, 112rem);
    height: calc(var(--card-height) + 3.5rem);
    margin-inline: auto;
  }

  .home-services__card {
    position: absolute;
    top: 1.6rem;
    left: 50%;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    width: var(--card-width);
    height: var(--card-height);
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: 1.35rem;
    padding: clamp(1.1rem, 1.8vw, 1.45rem);
    background:
      linear-gradient(145deg, rgb(255 255 255 / 5%), transparent 38%),
      linear-gradient(rgb(255 255 255 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 4%) 1px, transparent 1px), #171717;
    background-position:
      0 0,
      50% 50%,
      50% 50%,
      0 0;
    background-size:
      auto,
      4.6rem 4.6rem,
      4.6rem 4.6rem,
      auto;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 10%),
      inset 0 -1px 0 rgb(255 255 255 / 4%),
      0 2rem 5rem rgb(0 0 0 / 42%);
    color: white;
    cursor: default;
    outline: none;
    transform: translate3d(calc(-50% + var(--idle-x)), var(--idle-y), 0)
      rotate(var(--idle-rotation));
    transition:
      transform 820ms var(--ease-out-expo),
      border-color 520ms ease,
      background-color 520ms ease,
      box-shadow 820ms var(--ease-out-expo),
      filter 600ms ease,
      opacity 500ms ease;
    transition-delay: calc(var(--card-index) * 24ms);
  }

  .home-services__card:nth-child(1) {
    z-index: 1;
    --idle-x: -38.5rem;
    --idle-y: 2.5rem;
    --idle-rotation: 0deg;
    --active-x: -48rem;
  }

  .home-services__card:nth-child(2) {
    z-index: 3;
    --idle-x: -25rem;
    --idle-y: -0.6rem;
    --idle-rotation: 5deg;
    --active-x: -32rem;
  }

  .home-services__card:nth-child(3) {
    z-index: 4;
    --idle-x: -12.4rem;
    --idle-y: 2.8rem;
    --idle-rotation: -4deg;
    --active-x: -16rem;
  }

  .home-services__card:nth-child(4) {
    z-index: 2;
    --idle-x: 0.8rem;
    --idle-y: 1.6rem;
    --idle-rotation: 0deg;
    --active-x: 0rem;
  }

  .home-services__card:nth-child(5) {
    z-index: 5;
    --idle-x: 13.8rem;
    --idle-y: 0.4rem;
    --idle-rotation: -5deg;
    --active-x: 16rem;
  }

  .home-services__card:nth-child(6) {
    z-index: 6;
    --idle-x: 26.2rem;
    --idle-y: 2.7rem;
    --idle-rotation: 5deg;
    --active-x: 32rem;
  }

  .home-services__card:nth-child(7) {
    z-index: 2;
    --idle-x: 39rem;
    --idle-y: 2.3rem;
    --idle-rotation: 0deg;
    --active-x: 48rem;
  }

  .home-services__card::before,
  .home-services__card::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  .home-services__card::before {
    z-index: -2;
    background:
      radial-gradient(circle at 30% 22%, rgb(255 255 255 / 7%), transparent 0.16rem),
      radial-gradient(circle at 70% 74%, rgb(255 255 255 / 5%), transparent 0.13rem);
    background-size:
      1.7rem 1.7rem,
      2.1rem 2.1rem;
    opacity: 0.2;
    mix-blend-mode: screen;
  }

  .home-services__card::after {
    z-index: -1;
    background:
      radial-gradient(ellipse at 86% 9%, rgb(255 255 255 / 30%) 0 8%, transparent 31%),
      linear-gradient(124deg, transparent 0 42%, rgb(255 255 255 / 16%) 48%, transparent 60%),
      linear-gradient(112deg, transparent 0 53%, rgb(255 255 255 / 9%) 58%, transparent 68%),
      radial-gradient(ellipse at 66% 0%, rgb(255 255 255 / 12%), transparent 42%);
    background-repeat: no-repeat;
    background-size: 100% 100%;
    filter: blur(0.35px);
    opacity: 0;
    transform: translate3d(0.25rem, -0.25rem, 0);
    transition:
      opacity 420ms ease,
      transform 900ms var(--ease-out-expo);
  }

  .home-services__number {
    color: rgb(255 255 255 / 38%);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .home-services__icon-placeholder {
    align-self: center;
    justify-self: center;
    display: grid;
    width: clamp(4.8rem, 7vw, 6.7rem);
    aspect-ratio: 1;
    place-items: center;
    color: rgb(255 255 255 / 64%);
    filter: drop-shadow(0 0.6rem 1.2rem rgb(255 255 255 / 8%));
  }

  .home-services__icon-placeholder,
  .home-services__icon-placeholder::before,
  .home-services__icon-placeholder::after,
  .home-services__icon-placeholder span {
    border: 1px solid currentColor;
    border-radius: 999px;
  }

  .home-services__icon-placeholder::before,
  .home-services__icon-placeholder::after,
  .home-services__icon-placeholder span {
    position: absolute;
    content: '';
  }

  .home-services__icon-placeholder::before {
    width: 74%;
    height: 28%;
    transform: rotate(31deg);
  }

  .home-services__icon-placeholder::after {
    width: 42%;
    height: 42%;
    border-color: rgb(255 255 255 / 35%);
    transform: translate(24%, -18%);
  }

  .home-services__icon-placeholder span {
    width: 26%;
    height: 76%;
    border-color: rgb(255 255 255 / 48%);
    transform: rotate(-34deg);
  }

  .home-services__card h3 {
    align-self: end;
    color: rgb(255 255 255 / 95%);
    font-size: clamp(1.05rem, 1.7vw, 1.4rem);
    font-weight: 820;
    letter-spacing: -0.045em;
    line-height: 1.08;
    text-align: center;
    text-wrap: balance;
  }

  .home-services__card p {
    max-width: 16.2rem;
    max-height: 0;
    overflow: hidden;
    justify-self: center;
    color: rgb(255 255 255 / 78%);
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 0.82vw, 0.82rem);
    font-weight: 600;
    line-height: 1.65;
    text-align: center;
    opacity: 0;
    transform: translateY(0.7rem);
    transition:
      max-height 540ms var(--ease-out-expo),
      margin-top 540ms var(--ease-out-expo),
      opacity 360ms ease,
      transform 540ms var(--ease-out-expo);
  }

  .home-services__deck:has(.home-services__card:is(:hover, :focus-visible)) .home-services__card {
    z-index: calc(10 + var(--card-index));
    filter: saturate(0.96);
    opacity: 0.96;
    transform: translate3d(calc(-50% + var(--active-x)), 0, 0) rotate(0deg);
  }

  .home-services__deck .home-services__card:is(:hover, :focus-visible) {
    z-index: 30;
    border-color: rgb(255 255 255 / 28%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 14%),
      inset 0 -1px 0 rgb(255 255 255 / 5%),
      0 2.6rem 6rem rgb(0 0 0 / 55%);
    opacity: 1;
    transform: translate3d(calc(-50% + var(--active-x)), -1.15rem, 0) rotate(0deg);
    transition-delay: 0ms;
  }

  .home-services__deck .home-services__card:is(:hover, :focus-visible)::after {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    animation:
      home-services-sun-drift 5.2s ease-in-out infinite,
      home-services-sun-flicker 3.6s steps(7, end) infinite;
  }

  .home-services__deck .home-services__card:is(:hover, :focus-visible) p {
    max-height: 9rem;
    margin-top: 1.15rem;
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes home-services-cursor {
    0%,
    46% {
      opacity: 1;
    }

    47%,
    100% {
      opacity: 0.25;
    }
  }

  @keyframes home-services-sun-drift {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }

    40% {
      transform: translate3d(-0.35rem, 0.22rem, 0);
    }

    68% {
      transform: translate3d(0.18rem, -0.16rem, 0);
    }
  }

  @keyframes home-services-sun-flicker {
    0%,
    100% {
      opacity: 0.74;
    }

    24% {
      opacity: 0.58;
    }

    39% {
      opacity: 0.88;
    }

    57% {
      opacity: 0.63;
    }

    76% {
      opacity: 0.82;
    }
  }

  @media (max-width: 1180px) {
    .home-services__deck {
      --card-width: clamp(15.5rem, 23vw, 19rem);
      --card-height: clamp(18rem, 29vw, 23rem);
    }

    .home-services__card:nth-child(1) {
      --idle-x: -33rem;
      --active-x: -39rem;
    }

    .home-services__card:nth-child(2) {
      --idle-x: -21rem;
      --active-x: -26rem;
    }

    .home-services__card:nth-child(3) {
      --idle-x: -10.5rem;
      --active-x: -13rem;
    }

    .home-services__card:nth-child(5) {
      --idle-x: 11rem;
      --active-x: 13rem;
    }

    .home-services__card:nth-child(6) {
      --idle-x: 21.8rem;
      --active-x: 26rem;
    }

    .home-services__card:nth-child(7) {
      --idle-x: 33rem;
      --active-x: 39rem;
    }
  }

  @media (max-width: 900px) {
    .home-services {
      padding-inline: 0;
    }

    .home-services__intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      width: min(calc(100% - 2.5rem), 42rem);
    }

    .home-services h2 {
      font-size: clamp(1.85rem, 7vw, 2.72rem);
    }

    .home-services__description {
      margin-top: 0;
    }

    .home-services__deck-wrap {
      overflow: hidden;
      padding-bottom: 0.2rem;
    }

    .home-services__deck {
      --card-width: min(20.1rem, 78vw);
      --card-height: var(--card-width);

      display: flex;
      width: 100%;
      height: auto;
      gap: clamp(1rem, 5vw, 1.6rem);
      margin-inline: 0;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      padding: 1rem calc((100vw - var(--card-width)) / 2);
      scroll-padding-inline: calc((100vw - var(--card-width)) / 2);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .home-services__deck::-webkit-scrollbar {
      display: none;
    }

    .home-services__card,
    .home-services__deck:has(.home-services__card:is(:hover, :focus-visible)) .home-services__card,
    .home-services__deck .home-services__card:is(:hover, :focus-visible) {
      position: relative;
      top: auto;
      left: auto;
      flex: 0 0 var(--card-width);
      transform: none;
      transition-delay: 0ms;
      scroll-snap-align: center;
    }

    .home-services__card p {
      max-height: 9rem;
      margin-top: 1rem;
      opacity: 1;
      transform: none;
    }

    .home-services__card[data-active='true']::after {
      opacity: 1;
      transform: translate3d(0, 0, 0);
      animation:
        home-services-sun-drift 5.2s ease-in-out infinite,
        home-services-sun-flicker 3.6s steps(7, end) infinite;
    }

    .home-services__controls {
      display: flex;
      width: min(20.1rem, 78vw);
      margin: 0.5rem auto 0;
      align-items: center;
      justify-content: space-between;
    }

    .home-services__arrows {
      display: flex;
      gap: 0.5rem;
    }

    .home-services__arrow {
      display: grid;
      width: 1.9rem;
      height: 1.9rem;
      place-items: center;
      border: 1px solid rgb(255 255 255 / 24%);
      border-radius: 999px;
      background: transparent;
      color: rgb(255 255 255 / 86%);
      cursor: pointer;
      transition:
        border-color 200ms ease,
        color 200ms ease,
        transform 220ms var(--ease-out-expo);
    }

    .home-services__arrow:hover,
    .home-services__arrow:focus-visible {
      border-color: rgb(255 255 255 / 48%);
      color: white;
      transform: translateY(-1px);
    }

    .home-services__count {
      display: flex;
      align-items: center;
      gap: 0.65ch;
      color: rgb(255 255 255 / 50%);
      font-family: var(--font-mono);
      font-size: 0.84rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      line-height: 1;
    }
  }

  @media (max-width: 600px) {
    .home-services {
      padding-bottom: 5.5rem;
    }

    .home-services__intro {
      width: min(calc(100% - 2rem), 34rem);
    }

    .home-services__deck-wrap {
