---
import { getPublishedClientPartners } from '@/lib/projects';

const partners = await getPublishedClientPartners();

const partnerLoop = [...partners, ...partners, ...partners];
---

<section
  hidden={partners.length === 0}
  class="home-partners"
  aria-labelledby="home-partners-heading"
>
  <div class="home-partners__inner">
    <p
      id="home-partners-heading"
      class="home-partners__eyebrow"
      aria-label="Partneri, kas mums uzticas"
    >
      <span
        aria-hidden="true"
        data-typewriter
        data-typewriter-text="{ PARTNERI, KAS MUMS UZTICAS }"
        data-typewriter-speed="54"></span>
      <span class="home-partners__cursor" aria-hidden="true">_</span>
    </p>

    <ul class="home-partners__logos" data-reveal aria-label="ROMADI partneru logo saraksts">
      {
        partnerLoop.map((partner, index) => (
          <li
            class:list={[
              'home-partners__logo-item',
              index >= partners.length && 'home-partners__logo-item--duplicate',
            ]}
            aria-hidden={index >= partners.length ? 'true' : undefined}
          >
            <a
              class="home-partners__logo"
              href={partner.href}
              aria-label={`Atvērt ${partner.name}`}
              target="_blank"
              rel="noopener noreferrer"
              tabindex={index >= partners.length ? '-1' : undefined}
            >
              {partner.logo ? (
                <img
                  class="home-partners__logo-image"
                  data-client-logo={partner.slug}
                  src={partner.logo}
                  alt={partner.name}
                  loading="lazy"
                />
              ) : (
                <span class="home-partners__logo-text">{partner.name}</span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { initTypewriters } from '@/lib/animations/typewriter';

  const initializePartners = (): void => {
    initTypewriters();
  };

  initializePartners();

  document.addEventListener('astro:page-load', initializePartners);
</script>

<style>
  .home-partners {
    position: relative;

    overflow: hidden;
    padding: clamp(0.9rem, 1.35vw, 1.45rem) 1.5rem clamp(3.75rem, 6.5vw, 6rem);

    background: var(--color-ink-950);
  }

  .home-partners__inner {
    width: min(100%, 82rem);
    margin-inline: auto;
  }

  .home-partners__eyebrow {
    display: flex;
    min-height: 1.2rem;

    align-items: baseline;
    justify-content: center;
    gap: 0.6ch;

    color: rgb(255 255 255 / 48%);

    font-family: var(--font-mono);
    font-size: clamp(0.66rem, 0.8vw, 0.78rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.3;
    text-align: center;
    text-transform: uppercase;
  }

  .home-partners__cursor {
    opacity: 0;

    animation: home-partners-cursor 1.15s steps(1, end) infinite;
  }

  .home-partners__eyebrow span[data-typewriter-active='true'] + .home-partners__cursor {
    opacity: 1;
  }

  .home-partners__logos {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    justify-content: center;
    gap: clamp(3rem, 5.5vw, 5rem) clamp(1.5rem, 4vw, 4rem);

    width: min(100%, 74rem);
    margin: clamp(3.75rem, 6vw, 5.25rem) auto 0;
    padding: 0;

    list-style: none;
  }

  .home-partners__logo-item {
    display: flex;
    min-height: clamp(3.3rem, 6vw, 4.8rem);
    min-width: 0;

    align-items: center;
    justify-content: center;
  }

  .home-partners__logo-item--duplicate {
    display: none;
  }

  .home-partners__logo {
    display: inline-flex;
    width: 100%;
    min-width: 0;
    min-height: 3rem;

    align-items: center;
    justify-content: center;

    color: #fff;

    font-size: clamp(1.35rem, 2.15vw, 2.55rem);
    font-weight: 850;
    letter-spacing: 0.02em;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;

    cursor: pointer;

    filter: blur(0);
    opacity: 1;
    transition:
      filter 260ms ease,
      opacity 260ms ease;
  }

  .home-partners__logo-text {
    display: inline-block;
    max-width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
    font-size: clamp(0.9rem, 1.4vw, 1.4rem);
  }

  .home-partners__logo-image {
    display: block;
    width: min(100%, 8rem);
    height: clamp(3rem, 4.5vw, 4.5rem);
    filter: grayscale(1);

    object-fit: contain;
  }

  .home-partners__logo-image[data-client-logo='lalu'] {
    filter: grayscale(1) invert(1) brightness(2);
  }

  .home-partners__logo-image[data-client-logo='diana-hunt'] {
    object-fit: cover;
    filter: grayscale(1) brightness(1.6) contrast(4);
  }

  .home-partners__logo:hover,
  .home-partners__logo:focus-visible {
    opacity: 1;
    outline: none;
  }

  .home-partners__logo:focus-visible {
    outline: 2px solid white;
    outline-offset: 6px;
  }

  .home-partners__logos:has(.home-partners__logo:is(:hover, :focus-visible))
    .home-partners__logo:not(:hover):not(:focus-visible) {
    filter: blur(4px);
    opacity: 0.28;
  }

  @keyframes home-partners-cursor {
    0%,
    46% {
      opacity: 1;
    }

    47%,
    100% {
      opacity: 0.25;
    }
  }

  @keyframes home-partners-mobile-loop {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-33.333%, 0, 0);
    }
  }

  @media (max-width: 840px) {
    .home-partners__logos {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 3.25rem 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .home-partners {
      padding: 0.95rem 0 3.5rem;
    }

    .home-partners__inner {
      width: 100%;
    }

    .home-partners__eyebrow {
      justify-content: flex-start;
      width: min(calc(100% - 2.5rem), 24rem);
      margin-inline: auto;
    }

    .home-partners__logos {
      display: flex;
      grid-template-columns: none;
      justify-content: flex-start;
      gap: clamp(2.2rem, 11vw, 3.7rem);

      width: max-content;
      margin-top: 2.6rem;
      padding-right: clamp(2.2rem, 11vw, 3.7rem);

      animation: home-partners-mobile-loop 18s linear infinite;
      will-change: transform;
    }

    .home-partners__logos:hover,
    .home-partners__logos:focus-within {
      animation-play-state: paused;
    }

    .home-partners__logo-item {
      flex: 0 0 auto;
      min-width: clamp(8.5rem, 38vw, 11rem);
      min-height: 3.4rem;
    }

    .home-partners__logo-item--duplicate {
      display: flex;
    }

    .home-partners__logo {
      min-width: auto;
      font-size: clamp(1.2rem, 6vw, 1.8rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-partners__cursor {
      animation: none;
      opacity: 1;
    }

    .home-partners__logo {
      transition: none;
    }

    .home-partners__logos {
      animation: none;
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      padding-inline: 1rem;
    }

    .home-partners__logo-item--duplicate {
      display: none;
    }
  }
</style>
