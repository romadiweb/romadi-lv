            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>

  <dl class="home-hero__details" data-reveal>
    <div>
      <dt>Projekti</dt>
      <dd>
        <span
          class="home-hero__count"
          data-count-up
          data-count-start="1"
          data-count-end="50"
          data-count-duration="2500">50</span
        >+
      </dd>
    </div>

    <div>
