<section class="home-hero" data-pointer-hero>
  <div class="home-hero__background" aria-hidden="true">
    <div class="home-hero__base"></div>

    <div class="home-hero__ambient">
      <div class="home-hero__goo home-hero__goo--left"></div>
      <div class="home-hero__goo home-hero__goo--bottom"></div>
      <div class="home-hero__goo home-hero__goo--right"></div>

      <div class="home-hero__goo home-hero__goo--satellite-left"></div>
      <div class="home-hero__goo home-hero__goo--satellite-right"></div>
    </div>

    <div class="home-hero__flashlight"></div>

    <div class="home-hero__color-crunch"></div>

    <svg class="home-hero__noise" viewBox="0 0 100 100" preserveAspectRatio="none">
      <filter id="romadi-hero-noise">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.78"
          numOctaves="4"
          seed="24"
          stitchTiles="stitch"></feTurbulence>

        <feColorMatrix type="saturate" values="0"></feColorMatrix>

        <feComponentTransfer>
          <feFuncA type="table" tableValues="0 0.58"></feFuncA>
        </feComponentTransfer>
      </filter>

      <rect width="100%" height="100%" filter="url(#romadi-hero-noise)"></rect>
    </svg>

    <div class="home-hero__vignette"></div>
  </div>

  <div class="home-hero__content">
    <h1 data-reveal>
      Vairāk nekā tikai
      <span>mājaslapa</span>
    </h1>

    <p class="home-hero__description" data-reveal>
      <strong>ROMADI</strong> — digitālais partneris mūsdienīgu, ātru un pārdomātu tīmekļa risinājumu
      izstrādei.
    </p>

    <div class="home-hero__actions" data-reveal>
      <a href="/kontakti" class="home-hero__primary-action" data-astro-prefetch> Sākt projektu </a>

      <a href="/portfolio" class="home-hero__secondary-action" data-astro-prefetch>
        Apskatīt darbus

        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M5 12H19M13 6L19 12L13 18"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>

  <dl class="home-hero__details" data-reveal>
    <div>
      <dt>Projekti</dt>
      <dd>
        <span
          class="home-hero__count"
          data-count-up
          data-count-start="1"
          data-count-end="50"
          data-count-duration="2500">50</span
        >+
      </dd>
    </div>

    <div>
      <dt>Pieredze</dt>
      <dd>5+ gadi</dd>
    </div>

    <div>
      <dt>Lokācija</dt>
      <dd>Liepāja / Latvija</dd>
    </div>
  </dl>
</section>

<script>
  import { initHeroPointer } from '@/lib/interactions/heroPointer';
  import { initCountUp } from '@/lib/animations/countUp';

  const initializeHero = (): void => {
    initHeroPointer();
    initCountUp();
  };

  initializeHero();

  document.addEventListener('astro:page-load', initializeHero);
</script>

