        sizes="100vw"
        width="1600"
        height="878"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <div class="home-hero__flashlight"></div>

    <div class="home-hero__color-crunch"></div>

    <svg class="home-hero__noise" viewBox="0 0 100 100" preserveAspectRatio="none">
      <filter id="romadi-hero-noise">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.78"
          numOctaves="4"
          seed="24"
          stitchTiles="stitch"></feTurbulence>

        <feColorMatrix type="saturate" values="0"></feColorMatrix>

        <feComponentTransfer>
          <feFuncA type="table" tableValues="0 0.58"></feFuncA>
        </feComponentTransfer>
      </filter>

      <rect width="100%" height="100%" filter="url(#romadi-hero-noise)"></rect>
    </svg>

    <div class="home-hero__vignette"></div>
  </div>

  <div class="home-hero__content">
    <div class="home-hero__meta" data-reveal>
      <span>ROMADI / Digit&#257;l&#257; pieredze</span>
      <span>56.5047&#176; N / 21.0108&#176; E</span>
    </div>

