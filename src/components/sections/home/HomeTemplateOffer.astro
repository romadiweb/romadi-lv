---
import { Icon } from 'astro-icon/components';

const benefits = [
  { label: 'Mobilā versija', icon: 'lucide:smartphone' },
  { label: 'Satura ievietošana', icon: 'lucide:file-text' },
  { label: 'Palaišanas atbalsts', icon: 'lucide:rocket' },
];

const previews = [
  {
    className: 'template-offer__preview--services',
    src: '/images/home/template-offer/premium-local-services.webp',
    alt: 'Gatavas vietējā pakalpojumu uzņēmuma mājaslapas dizaina piemērs',
  },
  {
    className: 'template-offer__preview--wellness',
    src: '/images/home/template-offer/wellness-beauty.webp',
    alt: 'Gatavas skaistumkopšanas un labsajūtas mājaslapas dizaina piemērs',
  },
  {
    className: 'template-offer__preview--hospitality',
    src: '/images/home/template-offer/hospitality-guesthouse.webp',
    alt: 'Gatavas viesu nama mājaslapas dizaina piemērs',
  },
];
---

<section class="template-offer" aria-labelledby="template-offer-title">
  <div class="template-offer__panel" data-reveal>
    <div class="template-offer__content">
      <p class="template-offer__eyebrow" aria-label="Veidņu mājaslapas">
        <span aria-hidden="true">{'{ VEIDŅU MĀJASLAPAS }'}</span>
        <i aria-hidden="true">_</i>
      </p>

      <h2 id="template-offer-title">Labs sākums bez ilgas izstrādes.</h2>
      <p class="template-offer__description">
        Izvēlieties gatavu dizaina pamatu. Mēs pievienosim jūsu logo, krāsas un saturu — bez
        individuālas dizaina izstrādes no nulles.
      </p>

      <ul class="template-offer__benefits" aria-label="Piedāvājumā iekļauts">
        {
          benefits.map((benefit) => (
            <li>
              <Icon name={benefit.icon} aria-hidden="true" />
              <span>{benefit.label}</span>
            </li>
          ))
        }
      </ul>

      <div class="template-offer__action-row">
        <a class="template-offer__action" href="/veidnes">
          Apskatīt veidnes
          <Icon name="lucide:arrow-up-right" aria-hidden="true" />
        </a>
        <p><span>No</span> 350 €</p>
      </div>
    </div>

    <div class="template-offer__visual" aria-label="Trīs pielāgojamu mājaslapu veidņu piemēri">
      {
        previews.map((preview) => (
          <figure class:list={['template-offer__preview', preview.className]}>
            <div class="template-offer__chrome" aria-hidden="true">
              <>
                <i />
                <i />
                <i />
              </>
            </div>
            <img
              src={preview.src}
              alt={preview.alt}
              width="960"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .template-offer {
    width: min(calc(100% - 1.5rem), 112rem);
    margin: 0 auto;
    padding: 1.5rem 0 clamp(5rem, 8vw, 8rem);
  }

  .template-offer__panel {
    position: relative;
    isolation: isolate;
    display: grid;
    overflow: hidden;
    background: #050505;
  }

  .template-offer__panel::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 12%) 0.55px, transparent 0.55px);
    background-size: 5px 5px;
    opacity: 0.09;
    content: '';
    pointer-events: none;
  }

  .template-offer__content {
    padding: 2.25rem 1.25rem 1.5rem;
  }

  .template-offer__eyebrow {
    display: flex;
    align-items: center;
    color: rgb(255 255 255 / 53%);
    font: 650 0.68rem/1.2 var(--font-mono);
    letter-spacing: 0.04em;
  }

  .template-offer__eyebrow i {
    margin-left: 0.4ch;
    color: rgb(255 255 255 / 72%);
    font-style: normal;
    animation: template-offer-cursor 1.15s steps(1, end) infinite;
  }

  .template-offer h2 {
    max-width: 30rem;
    margin-top: 1.25rem;
    color: white;
    font-size: clamp(2rem, 7.8vw, 3.35rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .template-offer__description {
    max-width: 40rem;
    margin-top: 1.25rem;
    color: rgb(255 255 255 / 66%);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.65;
  }

  .template-offer__benefits {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.75rem;
    list-style: none;
  }

  .template-offer__benefits li {
    display: flex;
    min-height: 2rem;
    align-items: center;
    gap: 0.65rem;
    color: rgb(255 255 255 / 78%);
    font: 550 0.78rem/1.35 var(--font-mono);
  }

  .template-offer__benefits :global(svg) {
    width: 1rem;
    height: 1rem;
    color: rgb(255 255 255 / 50%);
    stroke-width: 1.7;
  }

  .template-offer__action-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .template-offer__action {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    border: 0;
    border-radius: 0.85rem;
    padding: 0.85rem 1.2rem;
    background: var(--accent);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 20%),
      0 12px 34px rgb(224 35 78 / 18%);
    color: white;
    font-size: 0.9rem;
    font-weight: 720;
    transition:
      transform 220ms var(--ease-out-quart),
      background-color 180ms ease,
      box-shadow 220ms ease;
  }

  .template-offer__action :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
    transition: transform 220ms var(--ease-out-quart);
  }

  .template-offer__action-row p {
    color: white;
    font: 650 1rem/1.2 var(--font-mono);
  }

  .template-offer__action-row p span {
    color: rgb(255 255 255 / 42%);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .template-offer__visual {
    position: relative;
    min-height: 17rem;
    margin: 0 0.75rem 0.75rem;
    overflow: hidden;
    background: #050505;
  }

  .template-offer__preview {
    position: absolute;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 17%);
    border-radius: 0.65rem;
    background: #151518;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 9%),
      0 20px 44px rgb(0 0 0 / 55%);
  }

  .template-offer__chrome {
    display: flex;
    height: 1.35rem;
    align-items: center;
    gap: 0.3rem;
    border-bottom: 1px solid rgb(255 255 255 / 8%);
    padding-inline: 0.55rem;
    background: linear-gradient(180deg, #202025, #151519);
  }

  .template-offer__chrome i {
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 25%);
  }

  .template-offer__chrome i:first-child {
    background: rgb(224 35 78 / 78%);
  }

  .template-offer__preview img {
    width: 100%;
    height: calc(100% - 1.35rem);
    object-fit: cover;
  }

  .template-offer__preview--services {
    z-index: 3;
    top: 28%;
    left: 14%;
    width: 72%;
    aspect-ratio: 1.6;
  }

  .template-offer__preview--wellness {
    z-index: 2;
    top: 8%;
    left: 2%;
    width: 62%;
    aspect-ratio: 1.6;
    transform: rotate(-2.2deg);
  }

  .template-offer__preview--hospitality {
    z-index: 1;
    top: 4%;
    right: 2%;
    width: 65%;
    aspect-ratio: 1.6;
    transform: rotate(2.1deg);
  }

  @media (hover: hover) {
    .template-offer__action:hover {
      background: var(--accent-hover);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 25%),
        0 18px 44px rgb(224 35 78 / 25%);
      transform: translateY(-2px);
    }

    .template-offer__action:hover :global(svg) {
      transform: translate(2px, -2px);
    }
  }

  @keyframes template-offer-cursor {
    0%,
    46% {
      opacity: 1;
    }

    47%,
    100% {
      opacity: 0.2;
    }
  }

  @media (min-width: 42rem) {
    .template-offer {
      width: min(calc(100% - 4rem), 112rem);
      padding-top: 2rem;
    }

    .template-offer__content {
      padding: 3rem;
    }

    .template-offer__benefits {
      grid-template-columns: repeat(3, max-content);
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }

    .template-offer__visual {
      min-height: 23rem;
      margin: 0 1.5rem 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .template-offer__panel {
      grid-template-columns: minmax(30rem, 0.9fr) minmax(33rem, 1.1fr);
      min-height: 31rem;
    }

    .template-offer__content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(3rem, 5vw, 5rem);
    }

    .template-offer h2 {
      font-size: clamp(2.75rem, 4vw, 4.5rem);
    }

    .template-offer__description {
      max-width: 36rem;
    }

    .template-offer__visual {
      min-height: 100%;
      margin: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
    }

    .template-offer__preview--services {
      top: 23%;
      left: 10%;
      width: 76%;
    }

    .template-offer__preview--wellness {
      top: 9%;
      left: 2%;
      width: 66%;
    }

    .template-offer__preview--hospitality {
      top: 6%;
      right: 2%;
      width: 68%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .template-offer__eyebrow i {
      animation: none;
    }

    .template-offer__action,
    .template-offer__action :global(svg) {
      transition: none;
    }
  }
</style>
