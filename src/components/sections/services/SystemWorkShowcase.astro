---
import { Icon } from 'astro-icon/components';
import SectionEyebrow from '@/components/ui/SectionEyebrow.astro';

interface SystemWork {
  name: string;
  type: string;
  description: string;
  image: string;
  imageAlt: string;
  capabilities: readonly string[];
  href?: string;
}

interface Props {
  works?: readonly SystemWork[];
}

const defaultWorks: readonly SystemWork[] = [
  {
    name: 'Loadmaster Simulator',
    type: 'MĀCĪBU SISTĒMA / LOĢISTIKAS SIMULĀCIJA',
    description:
      'RTU Liepājas Jūrniecības koledžai izstrādāta interaktīva mācību vide, kur studenti simulē maršrutu, transporta un loģistikas lēmumus, bet pasniedzēji pārvalda mācību scenārijus un rezultātus.',
    image: '/images/projects/loadmaster-simulator.png?v=4',
    imageAlt: 'Loadmaster Simulator pieslēgšanās un mācību vides sākuma ekrāns',
    capabilities: ['Loģistikas scenāriji', 'Maršrutu simulācija', 'Studentu un pasniedzēju piekļuve', 'Rezultātu pārvaldība'],
  },
] as const;

const { works = defaultWorks } = Astro.props;
---

<section class="system-works" aria-labelledby="system-works-title">
  <header class="system-works__header" data-reveal>
    <div>
      <SectionEyebrow text="RISINĀJUMU PIEMĒRI" />
      <h2 id="system-works-title">Sistēmas, kas kļūst par darba daļu.</h2>
    </div>
    <p>
      Katrs risinājums sākas ar konkrētu procesu — ko klientam jāspēj izdarīt pašam un ko
      komandai nepieciešams pārvaldīt vienuviet.
    </p>
  </header>

  <div class="system-works__list">
    {works.map((work, index) => (
      <article class="system-work" data-reveal>
        <div class="system-work__media">
          <img
            src={work.image}
            alt={work.imageAlt}
            width="1600"
            height="900"
            loading="lazy"
            decoding="async"
          />
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <button
            type="button"
            class="system-work__expand"
            aria-label={`Atvērt ${work.name} attēlu pilnekrānā`}
            data-open-system-image={`system-image-${index}`}
          >
            <Icon name="lucide:maximize-2" aria-hidden="true" />
          </button>
        </div>

        <div class="system-work__content">
          <p>{work.type}</p>
          <h3>{work.name}</h3>
          <p>{work.description}</p>
          <ul aria-label={`${work.name} galvenās iespējas`}>
            {work.capabilities.map((capability) => <li>{capability}</li>)}
          </ul>
          {work.href && <a href={work.href}>Apskatīt projektu <span aria-hidden="true">↗</span></a>}
        </div>

        <dialog class="system-work__dialog" id={`system-image-${index}`} data-system-image-dialog>
          <button type="button" aria-label="Aizvērt pilnekrāna attēlu" data-close-system-image>
            <Icon name="lucide:x" aria-hidden="true" />
          </button>
          <img src={work.image} alt={work.imageAlt} width="1918" height="910" />
        </dialog>
      </article>
    ))}
  </div>
</section>

<script>
  const initSystemImageDialogs = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-open-system-image]').forEach((button) => {
      if (button.dataset.dialogBound === 'true') return;
      button.dataset.dialogBound = 'true';

      const dialogId = button.dataset.openSystemImage;
      const dialog = dialogId ? document.getElementById(dialogId) as HTMLDialogElement | null : null;
      if (!dialog) return;

      button.addEventListener('click', () => dialog.showModal());
      dialog.querySelector<HTMLElement>('[data-close-system-image]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  };

  initSystemImageDialogs();
  document.addEventListener('astro:page-load', initSystemImageDialogs);
</script>

<style>
  .system-works {
    padding-top: clamp(5rem, 9vw, 9rem);
  }

  .system-works__header {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.8fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .system-works__header > div > p,
  .system-work__content > p:first-child {
    margin: 0 0 1.25rem;
    color: var(--color-text-muted);
    font: 550 clamp(0.72rem, 0.85vw, 0.9rem)/1.6 var(--font-mono);
  }

  .system-works h2 {
    max-width: 15ch;
    margin: 0;
    color: white;
    font-size: clamp(2.3rem, 4.25vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    text-wrap: balance;
  }

  .system-works__header > p {
    max-width: 50ch;
    margin: 0;
    color: var(--color-text-secondary, #b5b5bb);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .system-works__list { display: grid; gap: 2rem; }

  .system-work {
    display: grid;
    overflow: hidden;
    grid-template-columns: minmax(0, 1.55fr) minmax(19rem, 0.75fr);
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: var(--radius-card);
    background: linear-gradient(135deg, rgb(255 255 255 / 5%), rgb(255 255 255 / 1.5%));
  }

  .system-work__media {
    position: relative;
    min-height: clamp(25rem, 42vw, 38rem);
    overflow: hidden;
    background: #111;
  }

  .system-work__media::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 62%, rgb(7 7 7 / 55%));
    content: '';
    pointer-events: none;
  }

  .system-work__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transform: scale(1.01);
    transition: transform 700ms var(--ease-out-expo);
  }

  .system-work:hover .system-work__media img { transform: scale(1.025); }

  .system-work__media > span {
    position: absolute;
    z-index: 1;
    top: 1.5rem;
    left: 1.5rem;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 50%;
    place-items: center;
    background: rgb(5 5 5 / 58%);
    color: white;
    font: 550 0.72rem/1 var(--font-mono);
    backdrop-filter: blur(14px);
  }

  .system-work__expand {
    position: absolute;
    z-index: 2;
    right: 1.5rem;
    bottom: 1.5rem;
    display: grid;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgb(255 255 255 / 24%);
    border-radius: 50%;
    place-items: center;
    background: rgb(5 5 5 / 68%);
    color: white;
    cursor: pointer;
    backdrop-filter: blur(16px);
    transition: background 220ms ease, transform 220ms var(--ease-out-expo);
  }

  .system-work__expand:hover,
  .system-work__expand:focus-visible {
    background: rgb(224 35 78 / 88%);
    transform: scale(1.06);
  }

  .system-work__expand :global(svg) { width: 1.15rem; height: 1.15rem; }

  .system-work__dialog {
    width: min(86vw, 90rem);
    max-width: none;
    max-height: 82svh;
    overflow: visible;
    margin: auto;
    border: 1px solid rgb(255 255 255 / 24%);
    border-radius: var(--radius-card);
    padding: 0.5rem;
    background: rgb(11 11 11 / 86%);
    box-shadow: 0 3rem 8rem rgb(0 0 0 / 72%);
    backdrop-filter: blur(24px) saturate(112%);
  }

  .system-work__dialog::backdrop {
    background: rgb(0 0 0 / 70%);
    backdrop-filter: blur(18px);
  }

  .system-work__dialog img {
    display: block;
    width: 100%;
    max-height: calc(82svh - 1rem);
    border-radius: calc(var(--radius-card) - 0.3rem);
    object-fit: contain;
  }

  .system-work__dialog button {
    position: absolute;
    z-index: 2;
    top: 1.25rem;
    right: 1.25rem;
    display: grid;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgb(255 255 255 / 30%);
    border-radius: 50%;
    place-items: center;
    background: rgb(5 5 5 / 78%);
    color: white;
    cursor: pointer;
    backdrop-filter: blur(16px);
  }

  .system-work__dialog button:hover,
  .system-work__dialog button:focus-visible { background: #e0234e; }
  .system-work__dialog button :global(svg) { width: 1.2rem; height: 1.2rem; }

  .system-work__content {
    display: flex;
    justify-content: center;
    padding: clamp(2rem, 5vw, 5rem);
    flex-direction: column;
  }

  .system-work__content h3 {
    margin: 0;
    color: white;
    font-size: clamp(1.8rem, 3vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .system-work__content > p:nth-of-type(2) {
    margin: 1.5rem 0 0;
    color: var(--color-text-secondary, #b5b5bb);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .system-work__content ul {
    display: grid;
    margin: 2rem 0 0;
    border-top: 1px solid rgb(255 255 255 / 12%);
    padding: 1.25rem 0 0;
    list-style: none;
  }

  .system-work__content li {
    position: relative;
    padding: 0.6rem 0 0.6rem 1.25rem;
    color: rgb(255 255 255 / 78%);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .system-work__content li::before {
    position: absolute;
    top: 1.05rem;
    left: 0;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: #e0234e;
    content: '';
  }

  .system-work__content a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2rem;
    border-top: 1px solid rgb(255 255 255 / 12%);
    padding-top: 1.25rem;
    color: white;
    font-size: 1rem;
    font-weight: 650;
  }

  .system-work__content a span { font-family: var(--font-mono); }

  @media (max-width: 850px) {
    .system-works__header,
    .system-work { grid-template-columns: 1fr; }
    .system-works__header { gap: 2rem; }
    .system-work__media { min-height: clamp(20rem, 64vw, 32rem); }
    .system-work__media::after { background: linear-gradient(180deg, transparent 72%, rgb(7 7 7 / 50%)); }
  }

  @media (max-width: 600px) {
    .system-work__content { padding: 2rem; }
    .system-work__media { min-height: 18rem; }
    .system-work__dialog {
      width: calc(100vw - 1rem);
      height: min(31rem, calc(100svh - 1rem));
      max-height: calc(100svh - 1rem);
      overflow: auto;
      border-radius: 1rem;
      padding: 4.25rem 0.5rem 0.5rem;
      overscroll-behavior: contain;
    }
    .system-work__dialog img {
      width: max(52rem, 220vw);
      max-width: none;
      max-height: none;
      border-radius: 0.65rem;
    }
    .system-work__dialog button {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      width: 3.25rem;
      height: 3.25rem;
      background: #151515;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .system-work__media img { transition: none; }
    .system-work__media img,
    .system-work:hover .system-work__media img { transform: scale(1.01); }
  }
</style>
