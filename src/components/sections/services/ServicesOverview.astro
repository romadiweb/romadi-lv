---
import { SERVICES } from '@/data/services';
---

<section class="services-overview" aria-labelledby="services-overview-title">
  <div class="services-overview__glow" aria-hidden="true"></div>

  <div class="services-overview__inner">
    <div class="services-overview__intro">
      <p class="services-overview__eyebrow" aria-label="Pakalpojumi">
        <span
          aria-hidden="true"
          data-typewriter
          data-typewriter-text="{ PAKALPOJUMI }"
          data-typewriter-speed="54"></span>
        <span class="services-overview__cursor" aria-hidden="true">_</span>
      </p>

      <h1 id="services-overview-title">Digitāli risinājumi.<br />Viena atbildīga komanda.</h1>

      <p>
        No pirmās idejas līdz palaišanai un attīstībai — apvienojam stratēģiju, dizainu un
        tehnoloģijas vienā pārskatāmā procesā.
      </p>
    </div>

    <nav class="services-overview__list" aria-label="Visi ROMADI pakalpojumi">
      {
        SERVICES.map((service) => (
          <a href={service.href} class="services-overview__item" data-astro-prefetch>
            <span class="services-overview__number">{service.number}</span>
            <span class="services-overview__copy">
              <strong>{service.label}</strong>
              <span>{service.description}</span>
            </span>
            <span class="services-overview__arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))
      }
    </nav>
  </div>
</section>

<script>
  import { initTypewriters } from '@/lib/animations/typewriter';

  initTypewriters();
  document.addEventListener('astro:page-load', initTypewriters);
</script>

<style>
  .services-overview {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #050505;
    color: #f7f5f4;
    isolation: isolate;
  }

  .services-overview__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 78% 18%, rgb(91 7 29 / 0.72), transparent 35%),
      radial-gradient(circle at 48% 84%, rgb(122 13 43 / 0.3), transparent 42%);
    filter: blur(1.5rem);
  }

  .services-overview__inner {
    width: min(82rem, calc(100% - 3rem));
    min-height: 100svh;
    margin: 0 auto;
    padding: clamp(10rem, 18vh, 13rem) 0 clamp(5rem, 9vh, 7rem);
    display: grid;
    grid-template-columns: minmax(18rem, 0.78fr) minmax(28rem, 1.22fr);
    gap: clamp(4rem, 8vw, 9rem);
    align-items: start;
  }

  .services-overview__intro {
    position: sticky;
    top: 10rem;
  }

  .services-overview__eyebrow,
  .services-overview__number {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: rgb(255 255 255 / 0.48);
  }

  .services-overview__cursor {
    margin-left: 0.25rem;
    animation: services-cursor 1.05s steps(1, end) infinite;
  }

  .services-overview h1 {
    max-width: 10ch;
    margin: 2.1rem 0 1.6rem;
    font-family: var(--font-sans);
    font-size: clamp(3.1rem, 5.4vw, 5.8rem);
    font-weight: 430;
    line-height: 0.96;
    letter-spacing: -0.065em;
  }

  .services-overview__intro > p:last-child {
    max-width: 35rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.75;
    color: rgb(255 255 255 / 0.58);
  }

  .services-overview__list {
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }

  .services-overview__item {
    display: grid;
    grid-template-columns: 2.4rem 1fr auto;
    gap: 1rem;
    align-items: start;
    padding: 1.75rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      color 180ms ease;
  }

  .services-overview__copy {
    display: grid;
    gap: 0.55rem;
  }

  .services-overview__copy strong {
    font-size: clamp(1.25rem, 2vw, 1.8rem);
    font-weight: 520;
    letter-spacing: -0.035em;
  }

  .services-overview__copy > span {
    max-width: 36rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.65;
    color: rgb(255 255 255 / 0.42);
    transition: color 180ms ease;
  }

  .services-overview__arrow {
    margin-top: 0.1rem;
    font-size: 1.2rem;
    color: rgb(255 255 255 / 0.4);
    transform: translate(-0.3rem, 0.3rem);
    transition:
      transform 180ms ease,
      color 180ms ease;
  }

  .services-overview__item:hover,
  .services-overview__item:focus-visible {
    border-color: rgb(255 255 255 / 0.46);
  }

  .services-overview__item:hover .services-overview__copy > span,
  .services-overview__item:focus-visible .services-overview__copy > span,
  .services-overview__item:hover .services-overview__arrow,
  .services-overview__item:focus-visible .services-overview__arrow {
    color: #fff;
  }

  .services-overview__item:hover .services-overview__arrow,
  .services-overview__item:focus-visible .services-overview__arrow {
    transform: translate(0, 0);
  }

  @keyframes services-cursor {
    0%,
    48% {
      opacity: 1;
    }
    49%,
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 62rem) {
    .services-overview__inner {
      grid-template-columns: 1fr;
      gap: 4rem;
    }

    .services-overview__intro {
      position: static;
    }

    .services-overview h1 {
      max-width: 12ch;
    }
  }

  @media (max-width: 40rem) {
    .services-overview__inner {
      width: min(100% - 2rem, 82rem);
      padding-top: 8.5rem;
    }

    .services-overview__item {
      grid-template-columns: 1.8rem 1fr auto;
      gap: 0.7rem;
      padding: 1.4rem 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services-overview__cursor {
      animation: none;
    }
  }
</style>
