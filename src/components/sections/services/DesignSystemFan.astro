---
import SectionEyebrow from '@/components/ui/SectionEyebrow.astro';

const artifacts = [
  { type: 'identity', label: 'Identitāte', meta: 'Atpazīstams pamats' },
  { type: 'type', label: 'Tipogrāfija', meta: 'Skaidra hierarhija' },
  { type: 'interface', label: 'UI komponentes', meta: 'Vienota pieredze' },
  { type: 'responsive', label: 'Mobilā vide', meta: 'Pielāgots ekrānam' },
  { type: 'system', label: 'Dizaina sistēma', meta: 'Gatava izaugsmei' },
] as const;
---

<section class="design-fan" aria-labelledby="design-fan-title">
  <div class="design-fan__stage" aria-hidden="true">
    <div class="design-fan__deck">
      {
        artifacts.map((artifact) => (
          <article class={`design-fan__card design-fan__card--${artifact.type}`}>
            <div class="design-fan__face">
              {artifact.type === 'identity' && (
                <div class="design-fan__identity">
                  <strong>R</strong>
                  <span>
                    <i />
                    <i />
                    <i />
                  </span>
                </div>
              )}

              {artifact.type === 'type' && (
                <div class="design-fan__type">
                  <strong>Aa</strong>
                  <span>Manrope</span>
                  <i>JetBrains Mono</i>
                </div>
              )}

              {artifact.type === 'interface' && (
                <div class="design-fan__interface">
                  <span />
                  <strong>Turpināt</strong>
                  <i />
                  <i />
                </div>
              )}

              {artifact.type === 'responsive' && (
                <div class="design-fan__phone">
                  <i />
                  <strong />
                  <span />
                  <span />
                  <b />
                </div>
              )}

              {artifact.type === 'system' && (
                <div class="design-fan__tokens">
                  <span>
                    <i />
                    <i />
                    <i />
                  </span>
                  <strong>8 · 16 · 24</strong>
                  <b />
                  <b />
                </div>
              )}
            </div>

            <footer>
              <strong>{artifact.label}</strong>
              <span>{artifact.meta}</span>
            </footer>
          </article>
        ))
      }
    </div>
  </div>

  <div class="design-fan__copy" data-reveal>
    <SectionEyebrow text="VIENA SISTĒMA" />
    <h2 id="design-fan-title">Zīmols, ko atpazīst.<br />Saskarne, ko saprot.</h2>
    <p>
      No pirmā iespaida līdz pēdējam klikšķim — savienojam identitāti, saturu un interfeisu vienā
      konsekventā pieredzē.
    </p>
  </div>
</section>

<style>
  .design-fan {
    width: min(100%, 118rem);
    overflow: hidden;
    margin-inline: auto;
    padding: clamp(1rem, 2vw, 2rem) 2rem clamp(6rem, 10vw, 10rem);
    background:
      radial-gradient(circle at 50% 22%, rgb(160 45 22 / 16%), transparent 32rem), #030303;
  }

  .design-fan__stage {
    position: relative;
    height: clamp(19rem, 29vw, 26rem);
    mask-image: linear-gradient(to bottom, black 75%, transparent 100%);
  }

  .design-fan__deck {
    position: absolute;
    top: 1.5rem;
    left: 50%;
    width: min(58rem, 86vw);
    height: 22rem;
    transform: translateX(-50%);
  }

  .design-fan__card {
    --card-x: 0rem;
    --card-y: 0rem;
    --card-rotate: 0deg;
    --card-scale: 1;
    position: absolute;
    bottom: 0;
    left: calc(50% - 8rem);
    width: 16rem;
    height: 21rem;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: 1rem;
    background: #090909;
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 45%);
    transform: translate(var(--card-x), var(--card-y)) rotate(var(--card-rotate))
      scale(var(--card-scale));
    transform-origin: 50% 115%;
    transition:
      transform 650ms var(--ease-out-expo),
      border-color 250ms ease;
  }

  .design-fan__card:nth-child(1) {
    --card-x: -17rem;
    --card-y: 2.8rem;
    --card-rotate: -15deg;
    --card-scale: 0.91;
    z-index: 1;
  }
  .design-fan__card:nth-child(2) {
    --card-x: -9rem;
    --card-y: 0.8rem;
    --card-rotate: -7deg;
    --card-scale: 0.96;
    z-index: 2;
  }
  .design-fan__card:nth-child(3) {
    --card-y: -0.3rem;
    z-index: 5;
  }
  .design-fan__card:nth-child(4) {
    --card-x: 9rem;
    --card-y: 0.8rem;
    --card-rotate: 7deg;
    --card-scale: 0.96;
    z-index: 4;
  }
  .design-fan__card:nth-child(5) {
    --card-x: 17rem;
    --card-y: 2.8rem;
    --card-rotate: 15deg;
    --card-scale: 0.91;
    z-index: 3;
  }

  .design-fan__deck:hover .design-fan__card:nth-child(1) {
    --card-x: -19rem;
    --card-rotate: -17deg;
  }
  .design-fan__deck:hover .design-fan__card:nth-child(2) {
    --card-x: -10rem;
    --card-y: 0;
  }
  .design-fan__deck:hover .design-fan__card:nth-child(3) {
    --card-y: -1.1rem;
  }
  .design-fan__deck:hover .design-fan__card:nth-child(4) {
    --card-x: 10rem;
    --card-y: 0;
  }
  .design-fan__deck:hover .design-fan__card:nth-child(5) {
    --card-x: 19rem;
    --card-rotate: 17deg;
  }

  .design-fan__face {
    display: grid;
    height: 14.25rem;
    place-items: center;
    border-bottom: 1px solid rgb(255 255 255 / 12%);
    background:
      radial-gradient(circle at 82% 8%, rgb(218 81 37 / 38%), transparent 9rem),
      linear-gradient(145deg, #511b0d, #160a08 68%, #080808);
  }

  .design-fan__card:nth-child(2) .design-fan__face,
  .design-fan__card:nth-child(4) .design-fan__face {
    background:
      radial-gradient(circle at 78% 8%, rgb(224 35 78 / 34%), transparent 9rem),
      linear-gradient(145deg, #481020, #14070b 68%, #080808);
  }

  .design-fan__card:nth-child(3) .design-fan__face {
    background:
      radial-gradient(circle at 76% 8%, rgb(232 102 42 / 44%), transparent 10rem),
      linear-gradient(145deg, #67250f, #190b08 66%, #080808);
  }

  .design-fan__card footer {
    display: grid;
    gap: 0.45rem;
    padding: 1.5rem;
    background:
      linear-gradient(rgb(214 218 224 / 7%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(214 218 224 / 7%) 1px, transparent 1px), #0a0707;
    background-size: 1.5rem 1.5rem;
  }

  .design-fan__card footer strong {
    color: white;
    font-size: 1rem;
    font-weight: 600;
  }
  .design-fan__card footer span {
    color: #8e8e93;
    font: 500 0.72rem/1.5 var(--font-mono);
  }

  .design-fan__identity {
    display: grid;
    gap: 1rem;
    place-items: center;
  }
  .design-fan__identity > strong {
    color: white;
    font-size: 5rem;
    font-weight: 400;
    line-height: 1;
  }
  .design-fan__identity > span {
    display: flex;
    gap: 0.45rem;
  }
  .design-fan__identity i {
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: #e0234e;
  }
  .design-fan__identity i:nth-child(2) {
    background: #e8662a;
  }
  .design-fan__identity i:nth-child(3) {
    background: #d6dae0;
  }

  .design-fan__type {
    display: grid;
    justify-items: start;
  }
  .design-fan__type strong {
    color: white;
    font-size: 4.75rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .design-fan__type span {
    margin-top: 1rem;
    color: white;
    font-size: 1rem;
    font-weight: 600;
  }
  .design-fan__type i {
    margin-top: 0.25rem;
    color: #a1a1a6;
    font: 500 0.7rem/1.4 var(--font-mono);
    font-style: normal;
  }

  .design-fan__interface {
    display: grid;
    width: 70%;
    gap: 0.7rem;
  }
  .design-fan__interface > span {
    width: 52%;
    height: 0.7rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 82%);
  }
  .design-fan__interface strong {
    display: grid;
    min-height: 2.5rem;
    place-items: center;
    border-radius: 999px;
    background: white;
    color: #101010;
    font-size: 0.8rem;
  }
  .design-fan__interface i {
    height: 1.8rem;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 0.45rem;
  }
  .design-fan__interface i:last-child {
    width: 68%;
  }

  .design-fan__phone {
    display: grid;
    width: 6.2rem;
    height: 10.5rem;
    gap: 0.55rem;
    align-content: start;
    border: 1px solid rgb(255 255 255 / 28%);
    border-radius: 1.2rem;
    padding: 1rem 0.75rem;
    background: rgb(0 0 0 / 38%);
  }
  .design-fan__phone i {
    width: 2.2rem;
    height: 0.28rem;
    margin-inline: auto;
    border-radius: 999px;
    background: rgb(255 255 255 / 25%);
  }
  .design-fan__phone strong {
    height: 2.8rem;
    margin-top: 0.25rem;
    border-radius: 0.5rem;
    background: linear-gradient(135deg, #e8662a, #e0234e);
  }
  .design-fan__phone span {
    height: 0.45rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 25%);
  }
  .design-fan__phone span:nth-of-type(2) {
    width: 65%;
  }
  .design-fan__phone b {
    height: 1.55rem;
    margin-top: 0.15rem;
    border-radius: 999px;
    background: white;
  }

  .design-fan__tokens {
    display: grid;
    width: 70%;
    gap: 0.8rem;
  }
  .design-fan__tokens > span {
    display: flex;
    gap: 0.45rem;
  }
  .design-fan__tokens i {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.45rem;
    background: #e0234e;
  }
  .design-fan__tokens i:nth-child(2) {
    background: #e8662a;
  }
  .design-fan__tokens i:nth-child(3) {
    background: #d6dae0;
  }
  .design-fan__tokens strong {
    color: white;
    font: 500 0.72rem/1.4 var(--font-mono);
  }
  .design-fan__tokens b {
    height: 0.55rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 22%);
  }
  .design-fan__tokens b:last-child {
    width: 68%;
  }

  .design-fan__copy {
    position: relative;
    z-index: 10;
    display: grid;
    justify-items: center;
    margin-top: -2rem;
    text-align: center;
  }

  .design-fan__copy h2 {
    max-width: 15ch;
    margin-top: 1.25rem;
    color: white;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .design-fan__copy > p {
    max-width: 60ch;
    margin-top: 2rem;
    color: var(--text-secondary);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.6;
    text-wrap: pretty;
  }

  @media (max-width: 700px) {
    .design-fan {
      padding: 3rem 1.5rem 6rem;
    }
    .design-fan__stage {
      height: 17rem;
      margin-inline: -1.25rem;
    }
    .design-fan__deck {
      top: 0;
      width: 46rem;
      height: 19.5rem;
      transform: translateX(-50%) scale(0.76);
      transform-origin: top center;
    }
    .design-fan__copy {
      margin-top: 3rem;
    }
    .design-fan__copy h2 {
      max-width: 11ch;
      font-size: clamp(2.65rem, 12vw, 4rem);
    }
    .design-fan__copy h2 br {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .design-fan__card {
      transition: none;
    }
  }
</style>
