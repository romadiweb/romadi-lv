---
import type { ServiceDefinition } from '@/data/services';
import BrowserPreviewFrame from './BrowserPreviewFrame.astro';

interface Props {
  service: ServiceDefinition;
}

const { service } = Astro.props;

const websiteProjects = [
  {
    name: 'Liepājas Teltis',
    slug: 'liepajas-teltis',
    height: 794,
  },
] as const;
---

<figure
  class="service-visual"
  data-kind={service.visual}
  aria-label={`${service.label} vizuāls piemērs`}
>
  <div class="service-visual__surface">
    <div class="service-visual__chrome" aria-hidden="true">
      {
        service.visualTabs.map((tab, index) => (
          <span data-active={index === 0 ? 'true' : undefined}>{tab}</span>
        ))
      }
    </div>

    <div class="service-visual__canvas" aria-hidden="true">
      {
        service.visual === 'website' && (
          <div class="visual-website">
            <div class="visual-website__desktop">
              {websiteProjects.map((project) => (
                <BrowserPreviewFrame
                  title={project.name}
                  src={`/images/projects/${project.slug}-1600.webp`}
                  width={1600}
                  height={project.height}
                />
              ))}
            </div>
            <div class="visual-website__mobile">
              <div class="visual-mobile-device visual-mobile-device--website">
                <span aria-hidden="true"></span>
                <img
                  src="/images/projects/liepajas-teltis-mobile.png"
                  alt=""
                  width="392"
                  height="825"
                  loading="eager"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        )
      }

      {
        service.visual === 'commerce' && (
          <div class="visual-commerce">
            <div class="visual-commerce__desktop">
              <BrowserPreviewFrame
                title="VELA · Your bag"
                src="/images/projects/commerce-cart-open.png"
                width={1600}
                height={900}
              />
            </div>
            <div class="visual-commerce__mobile">
              <div class="visual-mobile-device visual-mobile-device--commerce">
                <span aria-hidden="true"></span>
                <img
                  src="/images/projects/vela-mobile.png"
                  alt=""
                  width="390"
                  height="844"
                  loading="eager"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        )
      }

      {
        service.visual === 'product' && (
          <div class="visual-product-preview">
            <div class="visual-product-preview__desktop">
              <BrowserPreviewFrame
                title="Nova CMS · Dashboard"
                src="/images/projects/nova-cms-desktop.png?v=2"
                width={1448}
                height={980}
                fit="cover"
                imageBackground="#f5f7fb"
                objectPosition="left top"
                imageScale={1.11}
              />
            </div>
            <div class="visual-product-preview__mobile">
              <div class="visual-mobile-device visual-mobile-device--product">
                <span aria-hidden="true"></span>
                <img
                  src="/images/projects/nova-cms-mobile.png"
                  alt=""
                  width="940"
                  height="1675"
                  loading="eager"
                  decoding="async"
                />
              </div>
            </div>
          </div>
        )
      }

      {
        service.visual === 'design' && (
          <div class="visual-design">
            <BrowserPreviewFrame
              title="UI / UX dizaina sistēma"
              src="/images/projects/uiuxhero-pc-v2.png"
              mobileSrc="/images/projects/uiuxhero-mobile-v2.png"
              width={1448}
              height={1086}
              fit="cover"
              imageBackground="#030303"
              objectPosition="center"
            />
          </div>
        )
      }

      {
        service.visual === 'automation' && (
          <div class="visual-automation">
            <svg viewBox="0 0 760 520" preserveAspectRatio="none">
              <path d="M135 260 C240 260 228 125 344 125 S454 260 555 260" />
              <path d="M135 260 C240 260 228 395 344 395 S454 260 555 260" />
            </svg>
            <span class="visual-automation__node visual-automation__node--source">
              IEVADES DATI<small>CRM + E-PASTS</small>
            </span>
            <span class="visual-automation__node visual-automation__node--ai">
              AI<small>APSTRĀDE</small>
            </span>
            <span class="visual-automation__node visual-automation__node--review">
              PĀRBAUDE<small>CILVĒKA LĒMUMS</small>
            </span>
            <span class="visual-automation__node visual-automation__node--result">
              REZULTĀTS<small>GATAVS DARBĪBAI</small>
            </span>
          </div>
        )
      }

      {
        service.visual === 'growth' && (
          <div class="visual-growth">
            <div class="visual-growth__metrics">
              <span>
                <>
                  <small>ORGANISKĀ PLŪSMA</small>
                  <strong>+38%</strong>
                </>
              </span>
              <span>
                <>
                  <small>KONVERSIJA</small>
                  <strong>4.82%</strong>
                </>
              </span>
            </div>
            <svg viewBox="0 0 760 360" preserveAspectRatio="none">
              <defs>
                <linearGradient id="growth-area" x1="0" y1="0" x2="0" y2="1">
                  <>
                    <stop stop-color="#e0234e" stop-opacity=".34" />
                    <stop offset="1" stop-color="#e0234e" stop-opacity="0" />
                  </>
                </linearGradient>
              </defs>
              <path
                class="area"
                d="M0 320 C74 310 82 264 150 278 S246 205 316 222 S410 132 482 158 S580 62 642 95 S706 35 760 24 V360 H0 Z"
              />
              <path
                class="line"
                d="M0 320 C74 310 82 264 150 278 S246 205 316 222 S410 132 482 158 S580 62 642 95 S706 35 760 24"
              />
            </svg>
            <div class="visual-growth__legend">
              <>
                <span>REDZAMĪBA</span>
                <span>IESAISTE</span>
                <span>REZULTĀTS</span>
              </>
            </div>
          </div>
        )
      }

      {
        service.visual === 'support' && (
          <div class="visual-support">
            <header>
              <>
                <span>SISTĒMAS STĀVOKLIS</span>
                <strong>VISI SERVISI DARBOJAS</strong>
              </>
            </header>
            <div class="visual-support__score">
              <>
                <i>98</i>
                <span>
                  <>
                    <b>Veiktspēja</b>
                    <small>Pēdējā pārbaude pirms 4 min.</small>
                  </>
                </span>
              </>
            </div>
            <div class="visual-support__rows">
              <span>
                <>
                  <i />
                  <b>Drošības atjauninājumi</b>
                  <small>Aktuāli</small>
                </>
              </span>
              <span>
                <>
                  <i />
                  <b>Rezerves kopijas</b>
                  <small>Šodien, 03:10</small>
                </>
              </span>
              <span>
                <>
                  <i />
                  <b>Pieejamības uzraudzība</b>
                  <small>99.99%</small>
                </>
              </span>
            </div>
          </div>
        )
      }
    </div>
  </div>
</figure>

<style>
  .service-visual {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: clamp(30rem, calc(100svh - 15rem), 45rem);
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 26%);
    border-radius: var(--radius-card);
    padding: 0.78rem;
    background:
      linear-gradient(118deg, rgb(255 255 255 / 9%), rgb(91 7 29 / 14%) 48%, rgb(255 255 255 / 4%)),
      rgb(255 255 255 / 3%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 15%);
    backdrop-filter: blur(20px) saturate(112%);
  }

  .service-visual::before {
    position: absolute;
    z-index: -1;
    inset: -30% 8% -40% 45%;
    background: linear-gradient(90deg, transparent, rgb(153 24 59 / 18%), transparent);
    filter: blur(40px);
    transform: rotate(28deg);
    content: '';
    pointer-events: none;
  }

  .service-visual::after {
    position: absolute;
    z-index: 4;
    inset: 0.3rem;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: calc(var(--radius-card) - 0.08rem);
    content: '';
    pointer-events: none;
  }

  .service-visual__surface {
    position: relative;
    z-index: 1;
    display: flex;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 13%);
    border-radius: calc(var(--radius-card) - 0.28rem);
    flex-direction: column;
    background: rgb(20 20 20 / 92%);
  }

  .service-visual__chrome {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: clamp(4.75rem, 6vw, 5.8rem);
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    border-bottom: 1px solid rgb(255 255 255 / 10%);
    padding-inline: clamp(2.2rem, 5vw, 5rem);
    background: rgb(30 30 30 / 68%);
    backdrop-filter: blur(16px);
  }

  .service-visual__chrome span {
    color: rgb(255 255 255 / 34%);
    font-size: clamp(0.78rem, 1.1vw, 0.98rem);
    font-weight: 650;
  }

  .service-visual__chrome span[data-active='true'] {
    color: white;
  }

  .service-visual__canvas {
    position: relative;
    z-index: 1;
    min-height: 0;
    overflow: hidden;
    flex: 1;
    background: var(--color-ink-750);
  }

  .visual-website,
  .visual-commerce,
  .visual-product-preview,
  .visual-design {
    position: absolute;
    inset: clamp(1rem, 3vw, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .visual-product-preview__desktop {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
  }

  .visual-product-preview__mobile { display: none; }

  .visual-commerce__desktop {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
  }

  .visual-commerce__mobile { display: none; }

  .visual-website__desktop {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
  }

  .visual-website__mobile { display: none; }

  .visual-design {
    background: #030303;
  }

  .visual-automation {
    position: absolute;
    inset: 8% 7% 2%;
  }
  .visual-automation svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .visual-automation svg path {
    fill: none;
    stroke: rgb(224 35 78 / 48%);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .visual-automation__node {
    position: absolute;
    display: grid;
    min-width: 9rem;
    border: 1px solid rgb(255 255 255 / 13%);
    border-radius: 0.7rem;
    padding: 1rem;
    background: #0c0c0c;
    color: white;
    font-size: 0.68rem;
    font-weight: 700;
    box-shadow: 0 0.5rem 0.75rem rgb(0 0 0 / 38%);
  }
  .visual-automation__node small {
    margin-top: 0.45rem;
    color: rgb(255 255 255 / 38%);
    font: 500 0.52rem/1 var(--font-mono);
  }
  .visual-automation__node--source {
    top: 43%;
    left: 2%;
  }
  .visual-automation__node--ai {
    top: 9%;
    left: 42%;
    border-color: rgb(224 35 78 / 44%);
  }
  .visual-automation__node--review {
    bottom: 9%;
    left: 42%;
  }
  .visual-automation__node--result {
    top: 43%;
    right: 1%;
  }

  .visual-growth {
    position: absolute;
    inset: 10% 7% 0;
  }
  .visual-growth__metrics {
    display: flex;
    gap: clamp(2.5rem, 6vw, 6rem);
  }
  .visual-growth__metrics span {
    display: grid;
    gap: 0.5rem;
  }
  .visual-growth__metrics small,
  .visual-growth__legend {
    color: rgb(255 255 255 / 40%);
    font: 550 0.56rem/1 var(--font-mono);
  }
  .visual-growth__metrics strong {
    color: white;
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 450;
    letter-spacing: -0.05em;
  }
  .visual-growth svg {
    width: 100%;
    height: 22rem;
    margin-top: 1rem;
    overflow: visible;
  }
  .visual-growth .area {
    fill: url(#growth-area);
  }
  .visual-growth .line {
    fill: none;
    stroke: #e0234e;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .visual-growth__legend {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid rgb(255 255 255 / 10%);
    padding-top: 1rem;
  }

  .visual-support {
    position: absolute;
    inset: 9% 7% -5%;
    border: 1px solid rgb(255 255 255 / 11%);
    border-radius: 0.85rem;
    background: #090909;
    padding: clamp(1.4rem, 3vw, 2.5rem);
  }
  .visual-support header {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid rgb(255 255 255 / 10%);
    padding-bottom: 1.25rem;
    color: rgb(255 255 255 / 42%);
    font: 550 0.56rem/1 var(--font-mono);
  }
  .visual-support header strong {
    color: #f75f7f;
    font-size: 0.56rem;
  }
  .visual-support__score {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 0;
  }
  .visual-support__score > i {
    display: grid;
    width: 6rem;
    height: 6rem;
    border: 1px solid rgb(224 35 78 / 48%);
    border-radius: 50%;
    place-items: center;
    color: white;
    font-size: 2rem;
    font-style: normal;
  }
  .visual-support__score span {
    display: grid;
    gap: 0.4rem;
    color: white;
  }
  .visual-support__score small {
    color: rgb(255 255 255 / 40%);
    font: 500 0.58rem/1 var(--font-mono);
  }
  .visual-support__rows {
    display: grid;
  }
  .visual-support__rows span {
    display: grid;
    grid-template-columns: 1rem 1fr auto;
    align-items: center;
    gap: 0.8rem;
    min-height: 4.4rem;
    border-top: 1px solid rgb(255 255 255 / 8%);
  }
  .visual-support__rows i {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: #e0234e;
    box-shadow: 0 0 0.8rem rgb(224 35 78 / 56%);
  }
  .visual-support__rows b {
    color: rgb(255 255 255 / 78%);
    font-size: 0.78rem;
  }
  .visual-support__rows small {
    color: rgb(255 255 255 / 38%);
    font: 500 0.56rem/1 var(--font-mono);
  }

  @media (max-width: 720px) {
    .service-visual {
      height: auto;
      min-height: 31rem;
      border-radius: var(--radius-card);
      padding: 0.45rem;
    }
    .service-visual__chrome {
      min-height: 4.5rem;
      padding-inline: 1.2rem;
    }
    .service-visual__canvas {
      min-height: 27rem;
    }
    .visual-website,
    .visual-commerce,
    .visual-product-preview,
    .visual-design {
      inset: 0.8rem;
    }
    .service-visual[data-kind='product'] {
      min-height: 44rem;
    }
    .service-visual[data-kind='commerce'] {
      min-height: 44rem;
    }
    .service-visual[data-kind='website'] {
      min-height: 44rem;
    }
    .service-visual[data-kind='design'] {
      min-height: 42rem;
    }
    .service-visual[data-kind='website'] .service-visual__chrome,
    .service-visual[data-kind='commerce'] .service-visual__chrome,
    .service-visual[data-kind='product'] .service-visual__chrome,
    .service-visual[data-kind='design'] .service-visual__chrome {
      display: none;
    }
    .service-visual[data-kind='website'] .service-visual__canvas {
      min-height: 43rem;
      background:
        radial-gradient(circle at 50% 32%, rgb(118 137 79 / 14%), transparent 42%),
        #0a0a0b;
    }
    .service-visual[data-kind='commerce'] .service-visual__canvas {
      min-height: 43rem;
      background:
        radial-gradient(circle at 50% 32%, rgb(214 198 166 / 12%), transparent 42%),
        #0a0a0b;
    }
    .service-visual[data-kind='product'] .service-visual__canvas {
      min-height: 43rem;
      background:
        radial-gradient(circle at 50% 32%, rgb(104 125 246 / 12%), transparent 42%),
        #0a0a0b;
    }
    .service-visual[data-kind='design'] .service-visual__canvas {
      min-height: 41rem;
      background: #030303;
    }
    .service-visual[data-kind='website'] .visual-website,
    .service-visual[data-kind='commerce'] .visual-commerce,
    .service-visual[data-kind='product'] .visual-product-preview,
    .service-visual[data-kind='design'] .visual-design {
      inset: 0.75rem;
    }
    .visual-website__desktop,
    .visual-commerce__desktop,
    .visual-product-preview__desktop { display: none; }
    .visual-website__mobile,
    .visual-commerce__mobile,
    .visual-product-preview__mobile {
      display: grid;
      width: 100%;
      height: 100%;
      place-items: center;
    }
    .visual-mobile-device {
      position: relative;
      box-sizing: border-box;
      width: min(78vw, 20rem);
      overflow: hidden;
      border: 0.42rem solid #050505;
      border-radius: 2.7rem;
      background: white;
      box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 52%);
    }
    .visual-mobile-device--product { aspect-ratio: 940 / 1675; }
    .visual-mobile-device--commerce { aspect-ratio: 390 / 874; }
    .visual-mobile-device--website { aspect-ratio: 392 / 855; }
    .visual-mobile-device--commerce,
    .visual-mobile-device--website {
      padding-top: 1.25rem;
      background: #050505;
    }
    .visual-mobile-device--commerce > span,
    .visual-mobile-device--website > span {
      top: 0.48rem;
      width: 18%;
      height: 0.28rem;
      background: rgb(255 255 255 / 42%);
    }
    .visual-mobile-device > span {
      position: absolute;
      z-index: 2;
      top: 0.5rem;
      left: 50%;
      width: 28%;
      height: 1.05rem;
      border-radius: 999px;
      background: #050505;
      transform: translateX(-50%);
    }
    .visual-mobile-device img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
    }
    .visual-mobile-device--commerce img,
    .visual-mobile-device--website img {
      height: calc(100% - 1.25rem);
      border-radius: 1.75rem 1.75rem 2.05rem 2.05rem;
    }
    .visual-automation__node {
      min-width: 7rem;
      padding: 0.75rem;
    }
    .visual-automation__node--result {
      top: auto;
      right: 2%;
      bottom: 10%;
    }
    .visual-growth svg {
      height: 17rem;
    }
  }
</style>
