---
import type { ServiceDefinition } from '@/data/services';

interface Props {
  service: ServiceDefinition;
}

const { service } = Astro.props;
---

<figure
  class="service-visual"
  data-kind={service.visual}
  aria-label={`${service.label} vizuāls piemērs`}
>
  <div class="service-visual__surface">
    <div class="service-visual__chrome" aria-hidden="true">
      {
        service.visualTabs.map((tab, index) => (
          <span data-active={index === 0 ? 'true' : undefined}>{tab}</span>
        ))
      }
    </div>

    <div class="service-visual__canvas" aria-hidden="true">
      {
        service.visual === 'website' && (
          <div class="visual-website">
            <div class="visual-website__bar">
              <>
                <i />
                <span>romadi.lv / pieredze</span>
                <b>LV</b>
              </>
            </div>
            <div class="visual-website__hero">
              <small>DIGITĀLA PIEREDZE</small>
              <strong>
                Ideja kļūst
                <br />
                par rezultātu.
              </strong>
              <i />
            </div>
            <div class="visual-website__cards">
              <>
                <span />
                <span />
                <span />
              </>
            </div>
          </div>
        )
      }

      {
        service.visual === 'commerce' && (
          <div class="visual-commerce">
            <div class="visual-commerce__catalog">
              <small>JAUNĀ KOLEKCIJA</small>
              <strong>Atlasīts jums</strong>
              <div>
                <>
                  <i />
                  <i />
                  <i />
                  <i />
                </>
              </div>
            </div>
            <div class="visual-commerce__order">
              <span>PASŪTĪJUMS · 0248</span>
              <>
                <i />
                <i />
                <i />
              </>
              <strong>€ 186,00</strong>
              <b>APMAKSĀTS</b>
            </div>
          </div>
        )
      }

      {
        service.visual === 'product' && (
          <div class="visual-product">
            <aside>
              <>
                <b>R / SYS</b>
                <i />
                <i />
                <i />
                <i />
              </>
            </aside>
            <div class="visual-product__main">
              <header>
                <>
                  <span>Vadības panelis</span>
                  <b>ŠODIEN</b>
                </>
              </header>
              <div class="visual-product__stats">
                <>
                  <i />
                  <i />
                  <i />
                </>
              </div>
              <svg viewBox="0 0 620 210" preserveAspectRatio="none">
                <path d="M0 180 C70 175 94 120 158 138 S253 72 318 92 S415 30 478 57 S558 22 620 8" />
                <path d="M0 198 H620" />
              </svg>
              <div class="visual-product__rows">
                <>
                  <i />
                  <i />
                  <i />
                </>
              </div>
            </div>
          </div>
        )
      }

      {
        service.visual === 'design' && (
          <div class="visual-design">
            <div class="visual-design__type">
              <>
                <small>ROMADI / 01</small>
                <strong>R</strong>
                <span>
                  Manrope
                  <br />
                  JetBrains Mono
                </span>
              </>
            </div>
            <div class="visual-design__system">
              <div class="visual-design__swatches">
                <>
                  <i />
                  <i />
                  <i />
                  <i />
                </>
              </div>
              <b>Veidots, lai izceltos.</b>
              <>
                <span />
                <span />
                <span />
              </>
            </div>
          </div>
        )
      }

      {
        service.visual === 'automation' && (
          <div class="visual-automation">
            <svg viewBox="0 0 760 520" preserveAspectRatio="none">
              <path d="M135 260 C240 260 228 125 344 125 S454 260 555 260" />
              <path d="M135 260 C240 260 228 395 344 395 S454 260 555 260" />
            </svg>
            <span class="visual-automation__node visual-automation__node--source">
              IEVADES DATI<small>CRM + E-PASTS</small>
            </span>
            <span class="visual-automation__node visual-automation__node--ai">
              AI<small>APSTRĀDE</small>
            </span>
            <span class="visual-automation__node visual-automation__node--review">
              PĀRBAUDE<small>CILVĒKA LĒMUMS</small>
            </span>
            <span class="visual-automation__node visual-automation__node--result">
              REZULTĀTS<small>GATAVS DARBĪBAI</small>
            </span>
          </div>
        )
      }

      {
        service.visual === 'growth' && (
          <div class="visual-growth">
            <div class="visual-growth__metrics">
              <span>
                <>
                  <small>ORGANISKĀ PLŪSMA</small>
                  <strong>+38%</strong>
                </>
              </span>
              <span>
                <>
                  <small>KONVERSIJA</small>
                  <strong>4.82%</strong>
                </>
              </span>
            </div>
            <svg viewBox="0 0 760 360" preserveAspectRatio="none">
              <defs>
                <linearGradient id="growth-area" x1="0" y1="0" x2="0" y2="1">
                  <>
                    <stop stop-color="#e0234e" stop-opacity=".34" />
                    <stop offset="1" stop-color="#e0234e" stop-opacity="0" />
                  </>
                </linearGradient>
              </defs>
              <path
                class="area"
                d="M0 320 C74 310 82 264 150 278 S246 205 316 222 S410 132 482 158 S580 62 642 95 S706 35 760 24 V360 H0 Z"
              />
              <path
                class="line"
                d="M0 320 C74 310 82 264 150 278 S246 205 316 222 S410 132 482 158 S580 62 642 95 S706 35 760 24"
              />
            </svg>
            <div class="visual-growth__legend">
              <>
                <span>REDZAMĪBA</span>
                <span>IESAISTE</span>
                <span>REZULTĀTS</span>
              </>
            </div>
          </div>
        )
      }

      {
        service.visual === 'support' && (
          <div class="visual-support">
            <header>
              <>
                <span>SISTĒMAS STĀVOKLIS</span>
                <strong>VISI SERVISI DARBOJAS</strong>
              </>
            </header>
            <div class="visual-support__score">
              <>
                <i>98</i>
                <span>
                  <>
                    <b>Veiktspēja</b>
                    <small>Pēdējā pārbaude pirms 4 min.</small>
                  </>
                </span>
              </>
            </div>
            <div class="visual-support__rows">
              <span>
                <>
                  <i />
                  <b>Drošības atjauninājumi</b>
                  <small>Aktuāli</small>
                </>
              </span>
              <span>
                <>
                  <i />
                  <b>Rezerves kopijas</b>
                  <small>Šodien, 03:10</small>
                </>
              </span>
              <span>
                <>
                  <i />
                  <b>Pieejamības uzraudzība</b>
                  <small>99.99%</small>
                </>
              </span>
            </div>
          </div>
        )
      }
    </div>
  </div>
</figure>

<style>
  .service-visual {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: clamp(30rem, calc(100svh - 15rem), 45rem);
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 26%);
    border-radius: var(--radius-card);
    padding: 0.78rem;
    background:
      linear-gradient(118deg, rgb(255 255 255 / 9%), rgb(91 7 29 / 14%) 48%, rgb(255 255 255 / 4%)),
      rgb(255 255 255 / 3%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 15%);
    backdrop-filter: blur(20px) saturate(112%);
  }

  .service-visual::before {
    position: absolute;
    z-index: -1;
    inset: -30% 8% -40% 45%;
    background: linear-gradient(90deg, transparent, rgb(153 24 59 / 18%), transparent);
    filter: blur(40px);
    transform: rotate(28deg);
    content: '';
    pointer-events: none;
  }

  .service-visual::after {
    position: absolute;
    z-index: 4;
    inset: 0.3rem;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: calc(var(--radius-card) - 0.08rem);
    content: '';
    pointer-events: none;
  }

  .service-visual__surface {
    position: relative;
    z-index: 1;
    display: flex;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 13%);
    border-radius: calc(var(--radius-card) - 0.28rem);
    flex-direction: column;
    background: rgb(20 20 20 / 92%);
  }

  .service-visual__chrome {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: clamp(4.75rem, 6vw, 5.8rem);
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    border-bottom: 1px solid rgb(255 255 255 / 10%);
    padding-inline: clamp(2.2rem, 5vw, 5rem);
    background: rgb(30 30 30 / 68%);
    backdrop-filter: blur(16px);
  }

  .service-visual__chrome span {
    color: rgb(255 255 255 / 34%);
    font-size: clamp(0.78rem, 1.1vw, 0.98rem);
    font-weight: 650;
  }

  .service-visual__chrome span[data-active='true'] {
    color: white;
  }

  .service-visual__canvas {
    position: relative;
    z-index: 1;
    min-height: 0;
    overflow: hidden;
    flex: 1;
    background: var(--color-ink-750);
  }

  .visual-website {
    position: absolute;
    inset: 0;
    background: var(--color-ink-750);
    overflow: hidden;
  }
  .visual-website__bar {
    display: none;
  }
  .visual-website__bar i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #e0234e;
    box-shadow: 0 0 1rem rgb(224 35 78 / 58%);
  }
  .visual-website__bar b {
    margin-left: auto;
    color: rgb(255 255 255 / 64%);
  }
  .visual-website__hero {
    position: relative;
    min-height: clamp(25rem, 31vw, 32rem);
    padding: clamp(4rem, 7vw, 7rem) clamp(3rem, 8vw, 8rem);
    overflow: hidden;
  }
  .visual-website__hero small {
    color: rgb(255 255 255 / 42%);
    font: 550 0.58rem/1 var(--font-mono);
  }
  .visual-website__hero strong {
    position: relative;
    z-index: 1;
    display: block;
    max-width: 9ch;
    margin-top: 1.1rem;
    color: white;
    font-size: clamp(2.8rem, 4.7vw, 4.8rem);
    font-weight: 430;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }
  .visual-website__hero i {
    position: absolute;
    top: -38%;
    right: 1%;
    bottom: -70%;
    width: 34%;
    background: linear-gradient(90deg, transparent, rgb(146 18 52 / 62%), transparent);
    filter: blur(34px);
    transform: rotate(31deg);
  }
  .visual-website__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
    padding: 0 clamp(3rem, 8vw, 8rem) 1.2rem;
  }
  .visual-website__cards span {
    height: 7rem;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 0.55rem;
    background: rgb(255 255 255 / 3%);
  }

  .visual-commerce {
    position: absolute;
    inset: 9% 7% -5%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.58fr);
    gap: 1rem;
  }
  .visual-commerce__catalog,
  .visual-commerce__order {
    border: 1px solid rgb(255 255 255 / 11%);
    border-radius: 0.85rem;
    background: #090909;
  }
  .visual-commerce__catalog {
    padding: clamp(1.5rem, 3vw, 2.6rem);
  }
  .visual-commerce__catalog small,
  .visual-commerce__order span {
    color: rgb(255 255 255 / 42%);
    font: 550 0.58rem/1 var(--font-mono);
  }
  .visual-commerce__catalog strong {
    display: block;
    margin-top: 0.7rem;
    color: white;
    font-size: clamp(1.7rem, 3vw, 2.8rem);
    font-weight: 480;
    letter-spacing: -0.04em;
  }
  .visual-commerce__catalog > div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .visual-commerce__catalog i {
    aspect-ratio: 0.88;
    border-radius: 0.55rem;
    background: linear-gradient(145deg, #280810, #111 58%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 8%);
  }
  .visual-commerce__catalog i:nth-child(2),
  .visual-commerce__catalog i:nth-child(3) {
    background: linear-gradient(145deg, #202020, #0d0d0d);
  }
  .visual-commerce__order {
    align-self: center;
    padding: 1.5rem;
    box-shadow: 0 0.5rem 0.75rem rgb(0 0 0 / 40%);
  }
  .visual-commerce__order i {
    display: block;
    height: 1px;
    margin-top: 1.25rem;
    background: rgb(255 255 255 / 10%);
  }
  .visual-commerce__order strong {
    display: block;
    margin-top: 1.4rem;
    color: white;
    font-size: 1.65rem;
  }
  .visual-commerce__order b {
    display: inline-block;
    margin-top: 1rem;
    border-radius: 999px;
    padding: 0.45rem 0.65rem;
    background: rgb(224 35 78 / 16%);
    color: #f75f7f;
    font: 650 0.55rem/1 var(--font-mono);
  }

  .visual-product {
    position: absolute;
    inset: 8% 6% -9%;
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    border: 1px solid rgb(255 255 255 / 11%);
    border-radius: 0.85rem 0.85rem 0 0;
    background: #080808;
    overflow: hidden;
  }
  .visual-product aside {
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 1rem;
    border-right: 1px solid rgb(255 255 255 / 9%);
    padding-block: 1.2rem;
  }
  .visual-product aside b {
    margin-bottom: 0.8rem;
    color: white;
    font: 650 0.55rem/1 var(--font-mono);
  }
  .visual-product aside i {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.35rem;
    background: rgb(255 255 255 / 7%);
  }
  .visual-product__main {
    padding: clamp(1.2rem, 3vw, 2.5rem);
  }
  .visual-product__main header {
    display: flex;
    justify-content: space-between;
    color: white;
    font-weight: 650;
  }
  .visual-product__main header b {
    color: rgb(255 255 255 / 38%);
    font: 550 0.56rem/1 var(--font-mono);
  }
  .visual-product__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .visual-product__stats i {
    height: 5.5rem;
    border-radius: 0.55rem;
    background: rgb(255 255 255 / 4%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 8%);
  }
  .visual-product svg {
    width: 100%;
    height: 12rem;
    margin-top: 1rem;
    overflow: visible;
  }
  .visual-product svg path:first-child {
    fill: none;
    stroke: #e0234e;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .visual-product svg path:last-child {
    fill: none;
    stroke: rgb(255 255 255 / 8%);
  }
  .visual-product__rows {
    display: grid;
    gap: 0.6rem;
  }
  .visual-product__rows i {
    height: 1.8rem;
    border-radius: 0.25rem;
    background: rgb(255 255 255 / 3.5%);
  }

  .visual-design {
    position: absolute;
    inset: 9% 7% -6%;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 1rem;
  }
  .visual-design__type,
  .visual-design__system {
    border: 1px solid rgb(255 255 255 / 11%);
    border-radius: 0.85rem;
    background: #080808;
    padding: clamp(1.4rem, 3vw, 2.5rem);
  }
  .visual-design__type small {
    color: rgb(255 255 255 / 42%);
    font: 550 0.56rem/1 var(--font-mono);
  }
  .visual-design__type strong {
    display: block;
    color: white;
    font-size: clamp(8rem, 17vw, 15rem);
    font-weight: 600;
    letter-spacing: -0.1em;
    line-height: 0.8;
  }
  .visual-design__type span {
    color: rgb(255 255 255 / 48%);
    font: 500 0.65rem/1.65 var(--font-mono);
  }
  .visual-design__swatches {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.45rem;
  }
  .visual-design__swatches i {
    height: 4.5rem;
    border-radius: 0.4rem;
    background: #e0234e;
  }
  .visual-design__swatches i:nth-child(2) {
    background: #620b22;
  }
  .visual-design__swatches i:nth-child(3) {
    background: #171717;
  }
  .visual-design__swatches i:nth-child(4) {
    background: #f5f5f5;
  }
  .visual-design__system b {
    display: block;
    max-width: 9ch;
    margin: clamp(3rem, 7vw, 6rem) 0 2rem;
    color: white;
    font-size: clamp(1.8rem, 3.5vw, 3.4rem);
    font-weight: 440;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .visual-design__system > span {
    display: block;
    height: 1px;
    margin-top: 1.1rem;
    background: rgb(255 255 255 / 14%);
  }

  .visual-automation {
    position: absolute;
    inset: 8% 7% 2%;
  }
  .visual-automation svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .visual-automation svg path {
    fill: none;
    stroke: rgb(224 35 78 / 48%);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .visual-automation__node {
    position: absolute;
    display: grid;
    min-width: 9rem;
    border: 1px solid rgb(255 255 255 / 13%);
    border-radius: 0.7rem;
    padding: 1rem;
    background: #0c0c0c;
    color: white;
    font-size: 0.68rem;
    font-weight: 700;
    box-shadow: 0 0.5rem 0.75rem rgb(0 0 0 / 38%);
  }
  .visual-automation__node small {
    margin-top: 0.45rem;
    color: rgb(255 255 255 / 38%);
    font: 500 0.52rem/1 var(--font-mono);
  }
  .visual-automation__node--source {
    top: 43%;
    left: 2%;
  }
  .visual-automation__node--ai {
    top: 9%;
    left: 42%;
    border-color: rgb(224 35 78 / 44%);
  }
  .visual-automation__node--review {
    bottom: 9%;
    left: 42%;
  }
  .visual-automation__node--result {
    top: 43%;
    right: 1%;
  }

  .visual-growth {
    position: absolute;
    inset: 10% 7% 0;
  }
  .visual-growth__metrics {
    display: flex;
    gap: clamp(2.5rem, 6vw, 6rem);
  }
  .visual-growth__metrics span {
    display: grid;
    gap: 0.5rem;
  }
  .visual-growth__metrics small,
  .visual-growth__legend {
    color: rgb(255 255 255 / 40%);
    font: 550 0.56rem/1 var(--font-mono);
  }
  .visual-growth__metrics strong {
    color: white;
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 450;
    letter-spacing: -0.05em;
  }
  .visual-growth svg {
    width: 100%;
    height: 22rem;
    margin-top: 1rem;
    overflow: visible;
  }
  .visual-growth .area {
    fill: url(#growth-area);
  }
  .visual-growth .line {
    fill: none;
    stroke: #e0234e;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .visual-growth__legend {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid rgb(255 255 255 / 10%);
    padding-top: 1rem;
  }

  .visual-support {
    position: absolute;
    inset: 9% 7% -5%;
    border: 1px solid rgb(255 255 255 / 11%);
    border-radius: 0.85rem;
    background: #090909;
    padding: clamp(1.4rem, 3vw, 2.5rem);
  }
  .visual-support header {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid rgb(255 255 255 / 10%);
    padding-bottom: 1.25rem;
    color: rgb(255 255 255 / 42%);
    font: 550 0.56rem/1 var(--font-mono);
  }
  .visual-support header strong {
    color: #f75f7f;
    font-size: 0.56rem;
  }
  .visual-support__score {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 0;
  }
  .visual-support__score > i {
    display: grid;
    width: 6rem;
    height: 6rem;
    border: 1px solid rgb(224 35 78 / 48%);
    border-radius: 50%;
    place-items: center;
    color: white;
    font-size: 2rem;
    font-style: normal;
  }
  .visual-support__score span {
    display: grid;
    gap: 0.4rem;
    color: white;
  }
  .visual-support__score small {
    color: rgb(255 255 255 / 40%);
    font: 500 0.58rem/1 var(--font-mono);
  }
  .visual-support__rows {
    display: grid;
  }
  .visual-support__rows span {
    display: grid;
    grid-template-columns: 1rem 1fr auto;
    align-items: center;
    gap: 0.8rem;
    min-height: 4.4rem;
    border-top: 1px solid rgb(255 255 255 / 8%);
  }
  .visual-support__rows i {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: #e0234e;
    box-shadow: 0 0 0.8rem rgb(224 35 78 / 56%);
  }
  .visual-support__rows b {
    color: rgb(255 255 255 / 78%);
    font-size: 0.78rem;
  }
  .visual-support__rows small {
    color: rgb(255 255 255 / 38%);
    font: 500 0.56rem/1 var(--font-mono);
  }

  @media (max-width: 720px) {
    .service-visual {
      height: auto;
      min-height: 31rem;
      border-radius: var(--radius-card);
      padding: 0.45rem;
    }
    .service-visual__chrome {
      min-height: 4.5rem;
      padding-inline: 1.2rem;
    }
    .service-visual__canvas {
      min-height: 27rem;
    }
    .visual-commerce {
      inset: 6%;
      grid-template-columns: 1fr;
    }
    .visual-commerce__order {
      position: absolute;
      right: 0;
      bottom: 0;
      width: 48%;
    }
    .visual-design {
      inset: 6%;
    }
    .visual-automation__node {
      min-width: 7rem;
      padding: 0.75rem;
    }
    .visual-automation__node--result {
      top: auto;
      right: 2%;
      bottom: 10%;
    }
    .visual-growth svg {
      height: 17rem;
    }
  }
</style>
