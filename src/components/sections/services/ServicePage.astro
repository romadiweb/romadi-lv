---
import { Icon } from 'astro-icon/components';
import ServiceVisual from '@/components/sections/services/ServiceVisual.astro';
import WebsiteDevelopmentSections from '@/components/sections/services/WebsiteDevelopmentSections.astro';
import { SERVICES, type ServiceDefinition } from '@/data/services';

interface Props {
  service: ServiceDefinition;
}

const { service } = Astro.props;
const contactHref = `/kontakti?pakalpojums=${encodeURIComponent(service.slug)}`;
const whatsappHref = `https://wa.me/37126625125?text=${encodeURIComponent(
  `Labdien! Vēlos uzzināt vairāk par pakalpojumu “${service.label}”.`,
)}`;
---

<article class="service-page">
  <section class="service-hero" aria-labelledby="service-title">
    <div class="service-hero__atmosphere" aria-hidden="true"></div>

    <div class="service-hero__inner">
      <div class="service-hero__copy" data-reveal>
        <p class="service-hero__eyebrow" aria-label={service.eyebrow}>
          <span
            aria-hidden="true"
            data-typewriter
            data-typewriter-text={`{ ${service.eyebrow} }`}
            data-typewriter-speed="42"></span>
          <span class="service-hero__cursor" aria-hidden="true">_</span>
        </p>

        <h1 id="service-title">
          {
            service.headline.map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))
          }
        </h1>

        <p class="service-hero__intro">{service.intro}</p>

        <div class="service-hero__actions">
          <a
            class="service-hero__action service-hero__action--primary"
            href={contactHref}
            data-astro-reload
          >
            Pieteikt projektu
          </a>
          <a
            class="service-hero__action service-hero__action--whatsapp"
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="simple-icons:whatsapp" aria-hidden="true" />
            Sazināties WhatsApp
          </a>
        </div>
      </div>

      <div class="service-hero__visual" data-reveal>
        <ServiceVisual service={service} />
      </div>
    </div>

    <nav class="service-hero__navigation" aria-label="Citi pakalpojumi">
      <div class="service-hero__navigation-grid">
        {
          SERVICES.map((item) => (
            <a
              href={item.href}
              aria-current={item.slug === service.slug ? 'page' : undefined}
              data-astro-reload
            >
              <span>{item.number}</span>
              {item.shortLabel}
            </a>
          ))
        }
      </div>

      <details class="service-hero__switcher">
        <summary>
          <span>
            <small>Pakalpojums</small>
            <strong><i>{service.number}</i>{service.shortLabel}</strong>
          </span>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M7 10L12 15L17 10"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </summary>

        <div class="service-hero__switcher-list">
          {
            SERVICES.map((item) => (
              <a
                href={item.href}
                aria-current={item.slug === service.slug ? 'page' : undefined}
                data-astro-reload
              >
                <span>{item.number}</span>
                <strong>{item.shortLabel}</strong>
                {item.slug === service.slug && <small>Pašreizējais</small>}
              </a>
            ))
          }
        </div>
      </details>
    </nav>
  </section>

  {
    service.visual === 'website' ? (
      <WebsiteDevelopmentSections contactHref={contactHref} serviceKey={service.slug} />
    ) : (
      <section class="service-details" aria-labelledby="service-details-title">
        <div class="service-details__heading" data-reveal>
          <p>{service.number} / {service.label}</p>
          <h2 id="service-details-title">Ko iegūst jūsu uzņēmums.</h2>
        </div>

        <ol class="service-details__grid">
          {service.details.map((detail, index) => (
            <li data-reveal>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{detail.title}</h3>
              <p>{detail.text}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</article>

<script>
  import { initTypewriters } from '@/lib/animations/typewriter';

  initTypewriters();
  document.addEventListener('astro:page-load', initTypewriters);
</script>

<style>
  .service-page {
    background: #030303;
  }

  .service-hero {
    position: relative;
    isolation: isolate;
    width: min(calc(100% - 2rem), 118rem);
    min-height: 100svh;
    margin-inline: auto;
    overflow: hidden;
    background: #030303;
  }

  .service-hero__atmosphere {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .service-hero__atmosphere::before {
    position: absolute;
    top: 8%;
    right: 18%;
    bottom: -54%;
    width: min(25rem, 29vw);
    background: linear-gradient(90deg, transparent, rgb(133 15 47 / 58%), transparent);
    filter: blur(46px);
    transform: rotate(34deg);
    content: '';
  }

  .service-hero__atmosphere::after {
    position: absolute;
    top: 6%;
    right: -16%;
    width: 62%;
    height: 36%;
    background: linear-gradient(118deg, transparent 25%, rgb(255 255 255 / 5%), transparent 72%);
    filter: blur(28px);
    content: '';
  }

  .service-hero__inner {
    --service-content-offset: clamp(3.5rem, 8svh, 6rem);

    display: grid;
    width: min(100%, 108rem);
    margin-inline: auto;
    grid-template-columns: minmax(25rem, 0.76fr) minmax(0, 1.24fr);
    align-items: start;
    gap: clamp(3rem, 5vw, 5.5rem);
    padding: clamp(7.5rem, 14svh, 9rem) clamp(1.5rem, 4vw, 4rem) 5rem;
  }

  .service-hero__copy {
    margin-top: var(--service-content-offset);
  }

  .service-hero__eyebrow {
    display: flex;
    min-height: 0.85rem;
    align-items: baseline;
    gap: 0.6ch;
    margin-bottom: 1.8rem;
    color: rgb(255 255 255 / 48%);
    font: 550 0.72rem/1.6 var(--font-mono);
    letter-spacing: 0.04em;
  }

  .service-hero__cursor {
    margin-left: 0.4ch;
    opacity: 0;
    animation: service-cursor 1.15s steps(1, end) infinite;
  }

  .service-hero__eyebrow span[data-typewriter-active='true'] + .service-hero__cursor {
    opacity: 1;
  }

  .service-hero h1 {
    max-width: 14ch;
    color: white;
    font-size: clamp(3rem, 4vw, 4.4rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .service-hero__intro {
    max-width: 55ch;
    margin-top: clamp(2.5rem, 4vw, 4rem);
    color: var(--text-secondary);
    font: 500 1rem/1.6 var(--font-sans);
    text-wrap: pretty;
  }

  .service-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }

  .service-hero__action {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    border-radius: 0.75rem;
    padding-inline: 1.3rem;
    font-size: 1rem;
    font-weight: 680;
    line-height: 1;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .service-hero__action--primary {
    background: white;
    color: #090909;
  }

  .service-hero__action--whatsapp {
    border: 1px solid rgb(255 255 255 / 18%);
    color: rgb(255 255 255 / 78%);
  }

  .service-hero__action--whatsapp :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .service-hero__action:hover,
  .service-hero__action:focus-visible {
    transform: translateY(-1px);
  }

  .service-hero__action--primary:hover,
  .service-hero__action--primary:focus-visible {
    background: rgb(255 255 255 / 88%);
  }

  .service-hero__action--whatsapp:hover,
  .service-hero__action--whatsapp:focus-visible {
    border-color: rgb(255 255 255 / 34%);
    color: white;
  }

  .service-hero__visual {
    width: clamp(48rem, 59vw, 72rem);
    min-width: 0;
    margin-right: max(-12rem, calc((100vw - 108rem) / -2));
    margin-top: var(--service-content-offset);
  }

  .service-hero__navigation {
    position: relative;
    z-index: 2;
    width: min(calc(100% - 3rem), 94rem);
    margin-inline: auto;
    background: #030303;
  }

  .service-hero__navigation-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    border-top: 1px solid rgb(255 255 255 / 11%);
  }

  .service-hero__navigation-grid a {
    display: grid;
    min-width: 0;
    min-height: 5rem;
    align-content: center;
    gap: 0.5rem;
    padding-inline: 0.8rem;
    color: rgb(255 255 255 / 40%);
    font-size: clamp(0.72rem, 0.85vw, 0.9rem);
    font-weight: 630;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  .service-hero__navigation-grid a + a {
    border-left: 1px solid rgb(255 255 255 / 8%);
  }
  .service-hero__navigation-grid a span {
    color: rgb(255 255 255 / 25%);
    font: 550 0.55rem/1 var(--font-mono);
  }
  .service-hero__navigation-grid a:hover,
  .service-hero__navigation-grid a[aria-current='page'] {
    color: white;
    background: rgb(255 255 255 / 3.5%);
  }
  .service-hero__navigation-grid a[aria-current='page'] span {
    color: #f75f7f;
  }

  .service-hero__switcher {
    display: none;
  }

  .service-details {
    display: grid;
    width: min(calc(100% - 4rem), 86rem);
    margin-inline: auto;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(4rem, 9vw, 10rem);
    padding: clamp(7rem, 11vw, 11rem) 0 clamp(8rem, 12vw, 12rem);
  }

  .service-details__heading p {
    margin-bottom: 1.5rem;
    color: rgb(255 255 255 / 38%);
    font: 550 0.72rem/1.6 var(--font-mono);
  }

  .service-details h2 {
    max-width: 11ch;
    color: white;
    font-size: clamp(2.7rem, 4.4vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .service-details__grid {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-details__grid li {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 0.72fr) minmax(0, 1fr);
    align-items: start;
    gap: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 12%);
    padding: 2.25rem 0;
  }

  .service-details__grid li:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 12%);
  }
  .service-details__grid span {
    color: rgb(255 255 255 / 32%);
    font: 550 0.62rem/1.5 var(--font-mono);
  }
  .service-details__grid h3 {
    color: white;
    font-size: clamp(1.05rem, 1.35vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.35;
  }
  .service-details__grid p {
    max-width: 65ch;
    color: var(--text-secondary);
    font: 500 1rem/1.6 var(--font-sans);
  }

  @keyframes service-cursor {
    0%,
    46% {
      opacity: 1;
    }
    47%,
    100% {
      opacity: 0.25;
    }
  }

  @media (max-width: 1050px) {
    .service-hero__inner {
      grid-template-columns: minmax(20rem, 0.82fr) minmax(0, 1.18fr);
      gap: 3rem;
    }
    .service-hero__visual {
      width: clamp(42rem, 61vw, 54rem);
      margin-right: -10rem;
    }
    .service-hero__navigation-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .service-hero__navigation-grid a:nth-child(5) {
      border-left: 0;
    }
    .service-hero__navigation-grid a:nth-child(n + 5) {
      border-top: 1px solid rgb(255 255 255 / 8%);
    }
  }

  @media (max-width: 800px) {
    .service-hero {
      width: calc(100% - 1rem);
    }
    .service-hero__inner {
      grid-template-columns: 1fr;
      gap: 4rem;
      padding: 9rem 0.75rem 4rem;
    }
    .service-hero__copy {
      margin-top: 0;
    }
    .service-hero h1 {
      max-width: 12ch;
      font-size: clamp(2.8rem, 12vw, 4.35rem);
    }
    .service-hero__intro {
      max-width: 48ch;
    }
    .service-hero__visual {
      width: 100%;
      margin-right: 0;
      margin-top: 0;
    }
    .service-hero__navigation {
      width: calc(100% - 1.5rem);
      border-top: 1px solid rgb(255 255 255 / 11%);
    }

    .service-hero__navigation-grid {
      display: none;
    }

    .service-hero__switcher {
      display: block;
    }

    .service-hero__switcher summary {
      display: flex;
      min-height: 5rem;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.85rem 1rem;
      color: white;
      cursor: pointer;
      list-style: none;
    }

    .service-hero__switcher summary::-webkit-details-marker {
      display: none;
    }

    .service-hero__switcher summary > span {
      display: grid;
      min-width: 0;
      gap: 0.45rem;
    }

    .service-hero__switcher summary small {
      color: rgb(255 255 255 / 38%);
      font: 550 0.72rem/1.6 var(--font-mono);
    }

    .service-hero__switcher summary strong {
      display: flex;
      min-width: 0;
      align-items: baseline;
      gap: 0.7rem;
      font-size: 1rem;
      font-weight: 600;
    }

    .service-hero__switcher summary i {
      color: #f75f7f;
      font: 550 0.72rem/1.6 var(--font-mono);
      font-style: normal;
    }

    .service-hero__switcher summary svg {
      width: 1.25rem;
      height: 1.25rem;
      flex: none;
      color: rgb(255 255 255 / 54%);
      transition: transform 240ms var(--ease-out-expo);
    }

    .service-hero__switcher[open] summary svg {
      transform: rotate(180deg);
    }

    .service-hero__switcher-list {
      display: grid;
      border-top: 1px solid rgb(255 255 255 / 8%);
    }

    .service-hero__switcher-list a {
      display: grid;
      min-height: 3.75rem;
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.65rem;
      border-bottom: 1px solid rgb(255 255 255 / 7%);
      padding-inline: 1rem;
      color: rgb(255 255 255 / 58%);
    }

    .service-hero__switcher-list a:last-child {
      border-bottom: 0;
    }

    .service-hero__switcher-list a[aria-current='page'] {
      background: rgb(255 255 255 / 3.5%);
      color: white;
    }

    .service-hero__switcher-list a > span {
      color: rgb(255 255 255 / 30%);
      font: 550 0.58rem/1 var(--font-mono);
    }

    .service-hero__switcher-list a[aria-current='page'] > span {
      color: #f75f7f;
    }

    .service-hero__switcher-list a > strong {
      font-size: 1rem;
      font-weight: 600;
    }

    .service-hero__switcher-list a > small {
      color: rgb(255 255 255 / 32%);
      font: 550 0.72rem/1.6 var(--font-mono);
    }
    .service-details {
      width: calc(100% - 2.5rem);
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }

  @media (max-width: 560px) {
    .service-hero__actions {
      align-items: stretch;
      flex-direction: column;
    }
    .service-hero__action {
      width: 100%;
    }
    .service-details__grid li {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.6rem 0.9rem;
    }
    .service-details__grid h3,
    .service-details__grid p {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-hero__cursor {
      animation: none;
      opacity: 1;
    }
    .service-hero__action {
      transition: none;
    }
  }
</style>
