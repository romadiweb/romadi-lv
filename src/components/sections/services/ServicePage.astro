---
import { Icon } from 'astro-icon/components';
import ServiceVisual from '@/components/sections/services/ServiceVisual.astro';
import ServicePricing from '@/components/sections/services/ServicePricing.astro';
import WebsiteDevelopmentSections from '@/components/sections/services/WebsiteDevelopmentSections.astro';
import EcommerceSalesSection from '@/components/sections/services/EcommerceSalesSection.astro';
import EcommerceReachSection from '@/components/sections/services/EcommerceReachSection.astro';
import DigitalProductsSections from '@/components/sections/services/DigitalProductsSections.astro';
import DesignSystemFan from '@/components/sections/services/DesignSystemFan.astro';
import ServiceProcess from '@/components/sections/services/ServiceProcess.astro';
import DesignBeforeAfter from '@/components/sections/services/DesignBeforeAfter.astro';
import SectionEyebrow from '@/components/ui/SectionEyebrow.astro';
import { SERVICES, type ServiceDefinition } from '@/data/services';

interface Props {
  service: ServiceDefinition;
}

const { service } = Astro.props;
const contactHref = `/kontakti?pakalpojums=${encodeURIComponent(service.slug)}`;
const whatsappHref = `https://wa.me/37126625125?text=${encodeURIComponent(
  `Labdien! Vēlos uzzināt vairāk par pakalpojumu “${service.label}”.`,
)}`;

const ecommercePricing = [
  {
    name: 'Pamata veikals',
    price: '1 200 €',
    text: 'Nelielam produktu klāstam un uzņēmumam, kas vēlas sākt pārdot tiešsaistē bez liekas sarežģītības.',
    features: ['Līdz 30 produktiem', 'Maksājumu integrācija', 'Piegādes veidu uzstādīšana', 'Responsīvs dizains'],
    action: 'Pārrunāt pamata veikalu',
  },
  {
    name: 'Izaugsmes veikals',
    price: '2 400 €',
    text: 'Augošam uzņēmumam ar plašāku katalogu, pārdomātu pirkuma ceļu un nepieciešamām biznesa integrācijām.',
    features: ['Neierobežots produktu katalogs', 'UX un pārdošanas struktūra', 'Noliktavas vai CRM integrācija', 'Analītika un tehniskais SEO'],
    action: 'Pārrunāt izaugsmes veikalu',
  },
  {
    name: 'Individuāla e-komercija',
    price: '4 200 €',
    text: 'Pielāgots e-komercijas risinājums sarežģītākiem procesiem, automatizācijai un lielākam pārdošanas apjomam.',
    features: ['Individuāla funkcionalitāte', 'ERP un ārējo sistēmu integrācijas', 'Procesu automatizācija', 'Mērogojama arhitektūra'],
    action: 'Pārrunāt individuālu veikalu',
  },
];

const digitalProductScope = [
  {
    name: 'Vispirms izprotam prasības',
    price: '',
    text: 'Rezervāciju sistēmas, klientu portāli, CMS un iekšējie rīki atšķiras pēc darbplūsmas, lietotāju lomām, datiem un integrācijām. Tāpēc precīzu darba apjomu nosakām tikai pēc prasību izpētes.',
    features: [
      'Vajadzību un esošo procesu izpēte',
      'Funkcionalitātes un lietotāju lomu definēšana',
      'Integrāciju un datu plūsmas izvērtēšana',
      'Skaidrs darba apjoms, termiņš un piedāvājums',
    ],
    action: 'Pārrunāt prasības',
  },
];

const brandDesignPricing = [
  {
    name: 'Logo un vizuālais sākums',
    price: '350 €',
    text: 'Uzņēmumam, kam vajadzīga pārliecinoša un praktiski izmantojama vizuālā identitāte bez liekas sarežģītības.',
    features: ['Logo dizains', 'Krāsu un burtveidolu izvēle', 'Logo lietošanas varianti', 'Faili digitālai videi un drukai'],
    action: 'Pārrunāt vizuālo sākumu',
  },
  {
    name: 'Zīmola identitāte',
    price: '750 €',
    text: 'Vienota zīmola sistēma uzņēmumam, kas vēlas būt viegli atpazīstams visos klienta saskares punktos.',
    features: ['Logo un vizuālā valoda', 'Zīmola krāsu sistēma', 'Tipogrāfija un grafiskie elementi', 'Sociālo tīklu sagataves'],
    action: 'Pārrunāt zīmola identitāti',
  },
  {
    name: 'Pilna dizaina sistēma',
    price: '1 400 €',
    text: 'Plašāka identitāte un digitālā dizaina sistēma uzņēmumam, kam vajadzīga konsekvence vairākos produktos un kanālos.',
    features: ['Pilna zīmola identitāte', 'UI komponentu sistēma', 'Mājaslapas vai produkta dizains', 'Detalizētas lietošanas vadlīnijas'],
    action: 'Pārrunāt dizaina sistēmu',
  },
];

const brandDesignProcess = [
  {
    icon: 'lucide:scan-search',
    title: 'Izpēte un virziens',
    text: 'Sākam ar biznesu, auditoriju un kontekstu, lai dizains risinātu pareizo problēmu, nevis būtu tikai dekorācija.',
    points: ['Zīmola un auditorijas izpēte', 'Konkurentu vizuālais audits', 'Mērķi un radošais virziens'],
  },
  {
    icon: 'lucide:waypoints',
    title: 'Koncepts un UX struktūra',
    text: 'Veidojam zīmola ideju, informācijas hierarhiju un lietotāja ceļus pirms pievēršamies detaļām.',
    points: ['Noskaņas un koncepta virziens', 'Informācijas arhitektūra', 'Lietotāju plūsmas un skices'],
  },
  {
    icon: 'lucide:panels-top-left',
    title: 'Identitāte un UI dizains',
    text: 'Pārvēršam izvēlēto virzienu konsekventā vizuālajā valodā un skaidrās digitālo produktu saskarnēs.',
    points: ['Logo un vizuālā valoda', 'Augstas precizitātes UI maketi', 'Responsīvie skati un stāvokļi'],
  },
  {
    icon: 'lucide:badge-check',
    title: 'Testēšana un sistēma',
    text: 'Pārbaudām lietojamību, sakārtojam komponentes un nododam sistēmu, ko komanda var turpināt izmantot.',
    points: ['Prototipa un UX pārbaude', 'Komponentes un dizaina tokeni', 'Vadlīnijas un nodošana komandai'],
  },
];
---

<article class="service-page">
  <section class="service-hero" aria-labelledby="service-title">
    <div class="service-hero__atmosphere" aria-hidden="true"></div>

    <div class="service-hero__inner">
      <div class="service-hero__copy" data-reveal>
        <SectionEyebrow text={service.eyebrow} class="service-hero__eyebrow" />

        <h1 id="service-title">
          {
            service.headline.map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))
          }
        </h1>

        <p class="service-hero__intro">{service.intro}</p>

        <div class="service-hero__actions">
          <a
            class="service-hero__action service-hero__action--primary"
            href={contactHref}
            data-astro-reload
          >
            Pieteikt projektu
          </a>
          <a
            class="service-hero__action service-hero__action--whatsapp"
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="simple-icons:whatsapp" aria-hidden="true" />
            Sazināties WhatsApp
          </a>
        </div>
      </div>

      <div class="service-hero__visual" data-reveal>
        <ServiceVisual service={service} />
      </div>
    </div>

    <nav class="service-hero__navigation" aria-label="Citi pakalpojumi">
      <div class="service-hero__navigation-grid">
        {
          SERVICES.map((item) => (
            <a
              href={item.href}
              aria-current={item.slug === service.slug ? 'page' : undefined}
              data-astro-reload
            >
              <span>{item.number}</span>
              {item.shortLabel}
            </a>
          ))
        }
      </div>

      <details class="service-hero__switcher">
        <summary>
          <span>
            <small>Pakalpojums</small>
            <strong><i>{service.number}</i>{service.shortLabel}</strong>
          </span>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M7 10L12 15L17 10"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </summary>

        <div class="service-hero__switcher-list">
          {
            SERVICES.map((item) => (
              <a
                href={item.href}
                aria-current={item.slug === service.slug ? 'page' : undefined}
                data-astro-reload
              >
                <span>{item.number}</span>
                <strong>{item.shortLabel}</strong>
                {item.slug === service.slug && <small>Pašreizējais</small>}
              </a>
            ))
          }
        </div>
      </details>
    </nav>
  </section>

  {
    service.visual === 'website' ? (
      <WebsiteDevelopmentSections contactHref={contactHref} serviceKey={service.slug} />
    ) : (
      <>
        {service.visual === 'commerce' ? (
          <EcommerceSalesSection />
        ) : service.visual === 'product' ? (
          <>
            <DigitalProductsSections contactHref={contactHref} />
            <ServicePricing
              serviceKey={service.slug}
              contactHref={contactHref}
              intro="Šādiem risinājumiem nav vienas fiksētas cenas — vispirms jāizprot process, lietotāji un nepieciešamās integrācijas."
              fallbackPlans={digitalProductScope}
              showPrice={false}
              maxPlans={1}
            />
          </>
        ) : service.visual === 'design' ? (
          <ServiceProcess
            intro="Spēcīgs zīmols nav tikai skaists logo. Identitātei, saturam un saskarnei jāstrādā kā vienai sistēmai — no pirmā iespaida līdz pēdējam klikšķim."
            steps={brandDesignProcess}
            theme="orange"
            compactAfter
          />
        ) : (
          <section class="service-details" aria-labelledby="service-details-title">
            <div class="service-details__heading" data-reveal>
              <p>{service.number} / {service.label}</p>
              <h2 id="service-details-title">Ko iegūst jūsu uzņēmums.</h2>
            </div>

            <ol class="service-details__grid">
              {service.details.map((detail, index) => (
                <li data-reveal>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <h3>{detail.title}</h3>
                  <p>{detail.text}</p>
                </li>
              ))}
            </ol>
          </section>
        )}

        {service.visual === 'commerce' && (
          <>
            <ServicePricing
              serviceKey={service.slug}
              contactHref={contactHref}
              intro="Trīs sākuma līmeņi interneta veikalam — no drošas pirmās versijas līdz pielāgotai e-komercijas sistēmai."
              fallbackPlans={ecommercePricing}
            />
            <EcommerceReachSection contactHref={contactHref} />
          </>
        )}

        {service.visual === 'design' && (
          <>
            <DesignSystemFan />
            <ServicePricing
              serviceKey={service.slug}
              contactHref={contactHref}
              intro="Trīs sākuma līmeņi — no skaidra vizuālā pamata līdz pilnai zīmola un digitālā produkta dizaina sistēmai."
              fallbackPlans={brandDesignPricing}
              theme="orange"
            />
            <DesignBeforeAfter />
          </>
        )}
      </>
    )
  }
</article>

<script>
  import { initTypewriters } from '@/lib/animations/typewriter';

  initTypewriters();
  document.addEventListener('astro:page-load', initTypewriters);
</script>

<style>
  .service-page {
    background: #030303;
  }

  .service-hero {
    position: relative;
    isolation: isolate;
    width: min(calc(100% - 2rem), 118rem);
    min-height: 100svh;
    margin-inline: auto;
    overflow: hidden;
    background: #030303;
  }

  .service-hero__atmosphere {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .service-hero__atmosphere::before {
    position: absolute;
    top: 8%;
    right: 18%;
    bottom: -54%;
    width: min(25rem, 29vw);
    background: linear-gradient(90deg, transparent, rgb(133 15 47 / 58%), transparent);
    filter: blur(46px);
    transform: rotate(34deg);
    content: '';
  }

  .service-hero__atmosphere::after {
    position: absolute;
    top: 6%;
    right: -16%;
    width: 62%;
    height: 36%;
    background: linear-gradient(118deg, transparent 25%, rgb(255 255 255 / 5%), transparent 72%);
    filter: blur(28px);
    content: '';
  }

  .service-hero__inner {
    --service-content-offset: clamp(3.5rem, 8svh, 6rem);

    display: grid;
    width: min(100%, 108rem);
    margin-inline: auto;
    grid-template-columns: minmax(25rem, 0.76fr) minmax(0, 1.24fr);
    align-items: start;
    gap: clamp(3rem, 5vw, 5.5rem);
    padding: clamp(7.5rem, 14svh, 9rem) clamp(1.5rem, 4vw, 4rem) 5rem;
  }

  .service-hero__copy {
    margin-top: var(--service-content-offset);
  }

  :global(.service-hero__eyebrow) {
    margin-bottom: 1.8rem;
  }

  .service-hero h1 {
    max-width: 14ch;
    color: white;
    font-size: clamp(3rem, 4vw, 4.4rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .service-hero__intro {
    max-width: 55ch;
    margin-top: clamp(2.5rem, 4vw, 4rem);
    color: var(--text-secondary);
    font: 500 1rem/1.6 var(--font-sans);
    text-wrap: pretty;
  }

  .service-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }

  .service-hero__action {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    border-radius: 0.75rem;
    padding-inline: 1.3rem;
    font-size: 1rem;
    font-weight: 680;
    line-height: 1;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .service-hero__action--primary {
    background: white;
    color: #090909;
  }

  .service-hero__action--whatsapp {
    border: 1px solid rgb(255 255 255 / 18%);
    color: rgb(255 255 255 / 78%);
  }

  .service-hero__action--whatsapp :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .service-hero__action:hover,
  .service-hero__action:focus-visible {
    transform: translateY(-1px);
  }

  .service-hero__action--primary:hover,
  .service-hero__action--primary:focus-visible {
    background: rgb(255 255 255 / 88%);
  }

  .service-hero__action--whatsapp:hover,
  .service-hero__action--whatsapp:focus-visible {
    border-color: rgb(255 255 255 / 34%);
    color: white;
  }

  .service-hero__visual {
    width: clamp(48rem, 59vw, 72rem);
    min-width: 0;
    margin-right: max(-12rem, calc((100vw - 108rem) / -2));
    margin-top: var(--service-content-offset);
  }

  .service-hero__navigation {
    position: relative;
    z-index: 2;
    width: min(calc(100% - 3rem), 94rem);
    margin-inline: auto;
    background: #030303;
  }

  .service-hero__navigation-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    border-top: 1px solid rgb(255 255 255 / 11%);
  }

  .service-hero__navigation-grid a {
    display: grid;
    min-width: 0;
    min-height: 5rem;
    align-content: center;
    gap: 0.5rem;
    padding-inline: 0.8rem;
    color: rgb(255 255 255 / 40%);
    font-size: clamp(0.72rem, 0.85vw, 0.9rem);
    font-weight: 630;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  .service-hero__navigation-grid a + a {
    border-left: 1px solid rgb(255 255 255 / 8%);
  }
  .service-hero__navigation-grid a span {
    color: rgb(255 255 255 / 25%);
    font: 550 0.55rem/1 var(--font-mono);
  }
  .service-hero__navigation-grid a:hover,
  .service-hero__navigation-grid a[aria-current='page'] {
    color: white;
    background: rgb(255 255 255 / 3.5%);
  }
  .service-hero__navigation-grid a[aria-current='page'] span {
    color: #f75f7f;
  }

  .service-hero__switcher {
    display: none;
  }

  .service-details {
    display: grid;
    width: min(calc(100% - 4rem), 86rem);
    margin-inline: auto;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(4rem, 9vw, 10rem);
    padding: clamp(7rem, 11vw, 11rem) 0 clamp(8rem, 12vw, 12rem);
  }

  .service-details__heading p {
    margin-bottom: 1.5rem;
    color: rgb(255 255 255 / 38%);
    font: 550 0.72rem/1.6 var(--font-mono);
  }

  .service-details h2 {
    max-width: 11ch;
    color: white;
    font-size: clamp(2.7rem, 4.4vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .service-details__grid {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-details__grid li {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 0.72fr) minmax(0, 1fr);
    align-items: start;
    gap: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 12%);
    padding: 2.25rem 0;
  }

  .service-details__grid li:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 12%);
  }
  .service-details__grid span {
    color: rgb(255 255 255 / 32%);
    font: 550 0.62rem/1.5 var(--font-mono);
  }
  .service-details__grid h3 {
    color: white;
    font-size: clamp(1.05rem, 1.35vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.35;
  }
  .service-details__grid p {
    max-width: 65ch;
    color: var(--text-secondary);
    font: 500 1rem/1.6 var(--font-sans);
  }

  @keyframes service-cursor {
    0%,
    46% {
      opacity: 1;
    }
    47%,
    100% {
      opacity: 0.25;
    }
  }

  @media (max-width: 1050px) {
    .service-hero__inner {
      grid-template-columns: minmax(20rem, 0.82fr) minmax(0, 1.18fr);
      gap: 3rem;
    }
    .service-hero__visual {
      width: clamp(42rem, 61vw, 54rem);
      margin-right: -10rem;
    }
    .service-hero__navigation-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .service-hero__navigation-grid a:nth-child(5) {
      border-left: 0;
    }
    .service-hero__navigation-grid a:nth-child(n + 5) {
      border-top: 1px solid rgb(255 255 255 / 8%);
    }
  }

  @media (max-width: 800px) {
    .service-hero {
      width: calc(100% - 1rem);
    }
    .service-hero__inner {
      grid-template-columns: 1fr;
      gap: 4rem;
      padding: 9rem 0.75rem 4rem;
    }
    .service-hero__copy {
      margin-top: 0;
    }
    .service-hero h1 {
      max-width: 12ch;
      font-size: clamp(2.8rem, 12vw, 4.35rem);
    }
    .service-hero__intro {
      max-width: 48ch;
    }
    .service-hero__visual {
      width: 100%;
      margin-right: 0;
      margin-top: 0;
    }
    .service-hero__navigation {
      width: calc(100% - 1.5rem);
      border-top: 1px solid rgb(255 255 255 / 11%);
    }

    .service-hero__navigation-grid {
      display: none;
    }

    .service-hero__switcher {
      display: block;
    }

    .service-hero__switcher summary {
      display: flex;
      min-height: 5rem;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.85rem 1rem;
      color: white;
      cursor: pointer;
      list-style: none;
    }

    .service-hero__switcher summary::-webkit-details-marker {
      display: none;
    }

    .service-hero__switcher summary > span {
      display: grid;
      min-width: 0;
      gap: 0.45rem;
    }

    .service-hero__switcher summary small {
      color: rgb(255 255 255 / 38%);
      font: 550 0.72rem/1.6 var(--font-mono);
    }

    .service-hero__switcher summary strong {
      display: flex;
      min-width: 0;
      align-items: baseline;
      gap: 0.7rem;
      font-size: 1rem;
      font-weight: 600;
    }

    .service-hero__switcher summary i {
      color: #f75f7f;
      font: 550 0.72rem/1.6 var(--font-mono);
      font-style: normal;
    }

    .service-hero__switcher summary svg {
      width: 1.25rem;
      height: 1.25rem;
      flex: none;
      color: rgb(255 255 255 / 54%);
      transition: transform 240ms var(--ease-out-expo);
    }

    .service-hero__switcher[open] summary svg {
      transform: rotate(180deg);
    }

    .service-hero__switcher-list {
      display: grid;
      border-top: 1px solid rgb(255 255 255 / 8%);
    }

    .service-hero__switcher-list a {
      display: grid;
      min-height: 3.75rem;
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.65rem;
      border-bottom: 1px solid rgb(255 255 255 / 7%);
      padding-inline: 1rem;
      color: rgb(255 255 255 / 58%);
    }

    .service-hero__switcher-list a:last-child {
      border-bottom: 0;
    }

    .service-hero__switcher-list a[aria-current='page'] {
      background: rgb(255 255 255 / 3.5%);
      color: white;
    }

    .service-hero__switcher-list a > span {
      color: rgb(255 255 255 / 30%);
      font: 550 0.58rem/1 var(--font-mono);
    }

    .service-hero__switcher-list a[aria-current='page'] > span {
      color: #f75f7f;
    }

    .service-hero__switcher-list a > strong {
      font-size: 1rem;
      font-weight: 600;
    }

    .service-hero__switcher-list a > small {
      color: rgb(255 255 255 / 32%);
      font: 550 0.72rem/1.6 var(--font-mono);
    }
    .service-details {
      width: calc(100% - 2.5rem);
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }

  @media (max-width: 560px) {
    .service-hero__actions {
      align-items: stretch;
      flex-direction: column;
    }
    .service-hero__action {
      width: 100%;
    }
    .service-details__grid li {
      grid-template-columns: 2rem minmax(0, 1fr);
