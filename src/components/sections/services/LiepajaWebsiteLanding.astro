---
import { Icon } from 'astro-icon/components';
import RomadiGlobe from './RomadiGlobe.astro';
import RomadiWhyChoose from './RomadiWhyChoose.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: readonly FaqItem[];
}
const { faqs } = Astro.props;
const contactHref = '/kontakti?pakalpojums=majaslapu-izstrade';

const regionFacts = [
  {
    icon: 'lucide:building-2',
    title: 'Birojs Liepājā',
    text: 'Varam tikties klātienē, izrunāt mērķus un strādāt vienā laika joslā.',
  },
  {
    icon: 'lucide:map-pinned',
    title: 'Sadarbība bez robežām',
    text: 'Liepāja ir mūsu bāze, bet projektus veidojam uzņēmumiem visā Latvijā un ārpus tās.',
  },
  {
    icon: 'lucide:orbit',
    title: 'Darba lauks — pasaule',
    text: 'Vietēja, tieša saziņa ar procesu, kas tikpat labi darbojas pāri pilsētu un valstu robežām.',
  },
] as const;

const scopes = [
  {
    id: 'landing',
    label: 'Landing lapa',
    icon: 'lucide:mouse-pointer-click',
    phrase: 'vienu skaidru mērķi',
    eyebrow: 'Fokuss bez lieka apjoma',
    lead: 'Maksā par ceļu līdz pieteikumam',
    price: 'no 500 €',
    priceMeta: 'vienreizēja izstrāde',
    description:
      'Koncentrēta lapa vienam pakalpojumam, produktam vai kampaņai. Viss saturs un interakcijas ved uz vienu prioritāru darbību.',
    flowStart: 'Apmeklētājs',
    flowEnd: 'Pieteikums',
    flowNote: 'Viena prioritāte no pirmā ekrāna līdz nosūtītai formai.',
    flow: [
      { icon: 'lucide:megaphone', label: 'Satiksme' },
      { icon: 'lucide:layout-template', label: 'Lapa' },
      { icon: 'lucide:mouse-pointer-click', label: 'CTA' },
      { icon: 'lucide:send', label: 'Forma' },
    ],
    detailCards: [
      {
        title: 'Dizains',
        value: 'Individuāls',
        text: 'Nevis gatava tēma — vizuālais risinājums tiek veidots konkrētajam piedāvājumam.',
        tags: ['Responsīvs UI', 'Konversijas fokuss'],
      },
      {
        title: 'Izstrāde',
        value: 'Līdz 5 sadaļām',
        text: 'Ātra, semantiska un tehniski tīra lapa ar skaidru satura hierarhiju.',
        tags: ['Pieteikuma forma', 'Tehniskais SEO'],
      },
      {
        title: 'Palaišana',
        value: 'Gatava darbam',
        text: 'Pārbaudām responsivitāti, pamata veiktspēju un svarīgākos lietotāja ceļus.',
        tags: ['QA pārbaude', 'Analītikas pamati'],
      },
    ],
  },
  {
    id: 'business',
    label: 'Biznesa mājaslapa',
    icon: 'lucide:building-2',
    phrase: 'vajadzīgo apjomu',
    eyebrow: 'Pilna uzņēmuma klātbūtne',
    lead: 'Maksā par sistēmu, kas izskaidro un pārdod',
    price: 'no 1 100 €',
    priceMeta: 'vienreizēja izstrāde',
    description:
      'Pilnvērtīga uzņēmuma vietne, kur pakalpojumi, uzticības elementi, saturs un pieteikumi strādā vienā konsekventā sistēmā.',
    flowStart: 'Apmeklētājs',
    flowEnd: 'Klients',
    flowNote: 'Vienots ceļš no pirmā iespaida līdz informētam pieteikumam.',
    flow: [
      { icon: 'lucide:house', label: 'Sākums' },
      { icon: 'lucide:panels-top-left', label: 'Pakalpojumi' },
      { icon: 'lucide:badge-check', label: 'Uzticība' },
      { icon: 'lucide:messages-square', label: 'Kontakts' },
      { icon: 'lucide:chart-no-axes-combined', label: 'Analītika' },
    ],
    detailCards: [
      {
        title: 'Struktūra',
        value: 'Līdz 12 lapām',
        text: 'Satura arhitektūra tiek veidota ap pakalpojumiem, auditoriju un biznesa prioritātēm.',
        tags: ['UX struktūra', 'Satura loģika'],
      },
      {
        title: 'Izaugsme',
        value: 'SEO + analītika',
        text: 'Tehniskie pamati meklētājiem un mērījumi, lai pēc palaišanas var pieņemt lēmumus ar datiem.',
        tags: ['Tehniskais SEO', 'Analītika'],
      },
      {
        title: 'Integrācijas',
        value: 'Pēc vajadzības',
        text: 'Formas, ārējie servisi un biznesa rīki tiek pieslēgti tur, kur tie reāli samazina manuālu darbu.',
        tags: ['Formas', 'Ārējie servisi'],
      },
    ],
  },
  {
    id: 'custom',
    label: 'Individuāls risinājums',
    icon: 'lucide:blocks',
    phrase: 'reālu funkcionalitāti',
    eyebrow: 'Kad ar standarta lapu nepietiek',
    lead: 'Maksā par funkcionalitāti, kas atrisina procesu',
    price: 'no 2 700 €',
    priceMeta: 'apjoms pēc prasībām',
    description:
      'Pielāgots digitāls produkts ar specifisku loģiku, integrācijām, datiem vai satura pārvaldību — būvēts ap jūsu procesu, nevis šablonu.',
    flowStart: 'Lietotājs',
    flowEnd: 'Rezultāts',
    flowNote: 'Interfeiss, biznesa loģika un dati savienoti vienā uzturamā plūsmā.',
    flow: [
      { icon: 'lucide:user-round', label: 'Lietotājs' },
      { icon: 'lucide:workflow', label: 'Loģika' },
      { icon: 'lucide:plug-zap', label: 'API' },
      { icon: 'lucide:database', label: 'Dati' },
      { icon: 'lucide:shield-check', label: 'Admin' },
    ],
    detailCards: [
      {
        title: 'Arhitektūra',
        value: 'Pielāgota',
        text: 'Risinājums tiek strukturēts konkrētajai loģikai, datiem un tam, kā sistēmai jāaug nākotnē.',
        tags: ['Mērogojama', 'Uzturama'],
      },
      {
        title: 'Integrācijas',
        value: 'API + dati',
        text: 'Savienojam ārējās sistēmas, datubāzes, automatizāciju vai AI tur, kur tas rada praktisku vērtību.',
        tags: ['API', 'Automatizācija', 'AI'],
      },
      {
        title: 'Attīstība',
        value: 'Bez griestiem',
        text: 'Pēc pirmās versijas sistēmu var turpināt paplašināt, saglabājot vienotu tehnisko pamatu.',
        tags: ['Jauni moduļi', 'Prioritāra attīstība'],
      },
    ],
  },
] as const;

const process = [
  {
    icon: 'lucide:messages-square',
    title: 'Saruna un izpēte',
    text: 'Noskaidrojam biznesa mērķi, auditoriju un to, kam vietnē jānotiek.',
  },
  {
    icon: 'lucide:panels-top-left',
    title: 'Saturs un dizains',
    text: 'Saliekam informācijas secību un izveidojam individuālu interfeisu.',
  },
  {
    icon: 'lucide:code-xml',
    title: 'Izstrāde',
    text: 'Uzbūvējam ātru, responsīvu un uzturamu tehnisko risinājumu.',
  },
  {
    icon: 'lucide:rocket',
    title: 'Palaišana',
    text: 'Pārbaudām kvalitāti, pieslēdzam analītiku un paliekam sasniedzami.',
  },
] as const;

const reviewSignals = [
  { icon: 'lucide:building-2', label: 'Liepājas Teltis', active: true },
  { icon: 'lucide:trending-up', label: 'Pasūtījumu pieaugums', active: false },
  { icon: 'lucide:search', label: 'Meklētāju pozīcijas', active: false },
  { icon: 'lucide:life-buoy', label: 'Atbalsts pēc palaišanas', active: false },
  { icon: 'lucide:code-xml', label: 'Individuāla izstrāde', active: false },
] as const;

const reviewFacts = [
  {
    icon: 'lucide:badge-check',
    title: 'Pozitīvi rezultāti',
    text: 'Pēc sadarbības pieauga pieprasījumi un nostiprinājās organiskā redzamība.',
  },
  {
    icon: 'lucide:trending-up',
    title: 'Pasūtījumu pieaugums',
    text: 'Lapa palīdzēja pārvērst apmeklējumus skaidrākos pieteikumos.',
  },
  {
    icon: 'lucide:search',
    title: 'Labākas pozīcijas',
    text: 'Tehniskais pamats un struktūra uzlaboja atrastību meklētājos.',
  },
] as const;

const ctaFloaters = [
  { icon: 'lucide:pen-tool', label: 'Dizains' },
  { icon: 'lucide:code-xml', label: 'Izstrāde' },
  { icon: 'lucide:mouse-pointer-click', label: 'Konversija' },
  { icon: 'lucide:search', label: 'SEO' },
  { icon: 'lucide:rocket', label: 'Palaišana' },
] as const;

const ctaBelt = [
  { icon: 'lucide:layout-template', text: 'Individuāls dizains bez šablonu sajūtas' },
  { icon: 'lucide:zap', text: 'Ātra izstrāde ar skaidriem nākamajiem soļiem' },
  { icon: 'lucide:search', text: 'SEO pamati un tehniska kārtība no paša sākuma' },
  { icon: 'lucide:life-buoy', text: 'Atbalsts arī pēc palaišanas' },
] as const;
---

<article class="liepaja-page">
  <section class="liepaja-hero liepaja-shell" aria-labelledby="liepaja-title">
    <div class="liepaja-hero__field">
      <div class="liepaja-hero__signal" aria-hidden="true"></div>
      <div class="liepaja-hero__copy">
        <h1 id="liepaja-title">Mājaslapu izstrāde Liepājā, kas virza biznesu uz priekšu.</h1>
        <p>
          ROMADI apvieno stratēģiju, individuālu dizainu un ātru izstrādi vienā skaidrā procesā -
          tepat Liepājā.
        </p>
        <div class="liepaja-hero__actions">
          <a class="liepaja-button liepaja-button--light" href={contactHref} data-astro-reload>
            Pārrunāt mājaslapu <Icon name="lucide:arrow-up-right" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div class="liepaja-hero__proof">
        <div class="liepaja-hero__facts" aria-label="ROMADI vietējās sadarbības fakti">
          <div>
            <span>56.5047° N / 21.0108° E</span>
            <strong>Bāzēti Liepājā</strong>
          </div>
          <div>
            <span>Klātienē + attālināti</span>
            <strong>Viena komanda visam projektam</strong>
          </div>
          <div>
            <span>Pēc palaišanas</span>
            <strong>Atbalsts un attīstība turpinās</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="liepaja-region liepaja-shell" aria-labelledby="liepaja-region-title">
    <div
      class="liepaja-globe"
      data-reveal
      aria-label="ROMADI bāze Liepājā, projekti bez ģeogrāfiskām robežām"
    >
      <RomadiGlobe
        eyebrow=""
        title="Liepājā radīts. Pasaulei gatavs."
        subtitle="Vietējā bāze, tieša saziņa un digitāls process, kas darbojas arī pāri pilsētu un valstu robežām."
        embedded
      />
    </div>

    <div class="liepaja-region__facts">
      {
        regionFacts.map((fact) => (
          <article data-reveal>
            <Icon name={fact.icon} aria-hidden="true" />
            <h3>{fact.title}</h3>
            <p>{fact.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="liepaja-scope liepaja-shell"
    aria-labelledby="liepaja-scope-title"
    data-scope-switcher
  >
    <header class="liepaja-centered-heading liepaja-scope__heading">
      <h2 id="liepaja-scope-title">
        Maksā tikai par
        <span class="liepaja-scope__phrase" aria-live="polite">
          <span data-scope-phrase>{scopes[0].phrase}</span>
        </span>
      </h2>
      <p>(Nevis par funkcijām, kas projektam nav vajadzīgas.)</p>
    </header>

    <div class="liepaja-scope__tabs" role="tablist" aria-label="Mājaslapas apjoms">
      {
        scopes.map((scope, index) => (
          <button
            type="button"
            role="tab"
            id={`scope-tab-${scope.id}`}
            aria-controls={`scope-panel-${scope.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            data-scope-tab={scope.id}
            data-scope-phrase-value={scope.phrase}
          >
            <Icon name={scope.icon} aria-hidden="true" />
            <span>{scope.label}</span>
          </button>
        ))
      }
    </div>

    <div class="liepaja-scope__panels">
      {
        scopes.map((scope, index) => (
          <article
            role="tabpanel"
            id={`scope-panel-${scope.id}`}
            aria-labelledby={`scope-tab-${scope.id}`}
            data-scope-panel={scope.id}
            hidden={index !== 0}
          >
            <div class="liepaja-scope__handle liepaja-scope__handle--tl" aria-hidden="true" />
            <div class="liepaja-scope__handle liepaja-scope__handle--tr" aria-hidden="true" />
            <div class="liepaja-scope__handle liepaja-scope__handle--bl" aria-hidden="true" />
            <div class="liepaja-scope__handle liepaja-scope__handle--br" aria-hidden="true" />

            <div class="liepaja-scope__overview">
              <div class="liepaja-scope__summary">
                <span class="liepaja-scope__eyebrow">{scope.eyebrow}</span>
                <h3>{scope.lead}</h3>
                <p>{scope.description}</p>
                <div class="liepaja-scope__price">
                  <strong>{scope.price}</strong>
                  <span>{scope.priceMeta}</span>
                </div>
                <a href={contactHref} data-astro-reload>
                  Pārrunāt apjomu <Icon name="lucide:arrow-up-right" aria-hidden="true" />
                </a>
              </div>

              <div class="liepaja-scope__visual" aria-label={`${scope.label} darba plūsma`}>
                <div class="liepaja-scope__visual-head">
                  <span>{scope.flowStart}</span>
                  <span>{scope.flowEnd}</span>
                </div>
                <div
                  class="liepaja-scope__flow"
                  style={`--scope-nodes:${scope.flow.length}`}
                  aria-hidden="true"
                >
                  <span class="liepaja-scope__flow-line" />
                  {scope.flow.map((item, flowIndex) => (
                    <div
                      class="liepaja-scope__flow-node"
                      style={`--scope-delay:${flowIndex * 85}ms`}
                    >
                      <Icon name={item.icon} />
                      <span>{item.label}</span>
                    </div>
                  ))}
                </div>
                <p>{scope.flowNote}</p>
              </div>
            </div>

            <div class="liepaja-scope__details">
              {scope.detailCards.map((card) => (
                <section>
                  <span>{card.title}</span>
                  <strong>{card.value}</strong>
                  <p>{card.text}</p>
                  <div class="liepaja-scope__tags">
                    {card.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="liepaja-kapec-romadi liepaja-shell" aria-labelledby="liepaja-kapec-romaadi-title">
    <RomadiWhyChoose />
  </section>

  <section class="liepaja-process liepaja-shell" aria-labelledby="liepaja-process-title">
    <header class="liepaja-split-heading" data-reveal>
      <h2 id="liepaja-process-title">Četri posmi. Bez miglas starp tiem.</h2>
      <p>Jūs zināt, kas notiek, kāds lēmums vajadzīgs un ko saņemsiet nākamajā solī.</p>
    </header>
    <ol>
      {
        process.map((step) => (
          <li data-reveal>
            <Icon name={step.icon} aria-hidden="true" />
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="liepaja-review liepaja-shell" aria-labelledby="liepaja-review-title">
    <h2 id="liepaja-review-title" class="sr-only">Liepājas klienta atsauksme</h2>

    <div class="liepaja-review__stack" data-reveal>
      <div class="liepaja-review__tabs" aria-label="Klienta ieguvumu akcenti">
        {
          reviewSignals.map((item) => (
            <span class:list={['liepaja-review__tab', { 'is-active': item.active }]}>
              <Icon name={item.icon} aria-hidden="true" />
              <span>{item.label}</span>
            </span>
          ))
        }
      </div>

      <blockquote class="liepaja-review__panel">
        <div class="liepaja-review__quote">
          <span class="liepaja-review__eyebrow">KLIENTA ATSAUKSME / LIEPĀJA</span>
          <p>
            “Pateicoties sadarbībai ar ROMADI, ieguvām pozitīvus rezultātus pasūtījumu pieaugumā un
            meklētāju pozīcijās.”
          </p>
          <footer>
            <strong>Liepājas Teltis</strong>
            <span>liepajasteltis.lv</span>
          </footer>
        </div>

        <div class="liepaja-review__brand" aria-label="Liepājas Teltis">
          <div class="liepaja-review__brand-mark">
            <img
              src="/images/projects/liepajasteltis-logo-metallic.webp"
              width="512"
              height="512"
              alt="Liepājas Teltis logotips"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="liepaja-review__facts">
            {
              reviewFacts.map((fact) => (
                <article>
                  <Icon name={fact.icon} aria-hidden="true" />
                  <div>
                    <strong>{fact.title}</strong>
                    <p>{fact.text}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>

        <div class="liepaja-review__belt" aria-label="Sadarbības ieguvumi">
          <span>
            <Icon name="lucide:map-pinned" aria-hidden="true" />
            Liepāja + attālināti
          </span>
          <span>
            <Icon name="lucide:messages-square" aria-hidden="true" />
            Tieša saziņa visā procesā
          </span>
          <span>
            <Icon name="lucide:life-buoy" aria-hidden="true" />
            Atbalsts arī pēc palaišanas
          </span>
        </div>
      </blockquote>
    </div>
  </section>

  <section class="liepaja-faq liepaja-shell" aria-labelledby="liepaja-faq-title">
    <header data-reveal>
      <h2 id="liepaja-faq-title">Praktiski pirms sākam.</h2>
      <p>Īsas atbildes par cenu, dizainu, satura pārvaldību un SEO.</p>
    </header>
    <div class="liepaja-faq__list">
      {
        faqs.map((faq, index) => (
          <details open={index === 0} data-reveal>
            <summary>
              <>
                <span>{faq.question}</span>
                <Icon name="lucide:plus" aria-hidden="true" />
              </>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <aside class="liepaja-related liepaja-shell" aria-labelledby="liepaja-related-title" data-reveal>
    <div>
      <h2 id="liepaja-related-title">Vajadzīgs pilns pakalpojuma pārskats?</h2>
      <p>Apskatiet tehnisko pieeju un visas mājaslapu izstrādes iespējas bez vietas piesaistes.</p>
    </div>
    <a href="/pakalpojumi/majaslapu-izstrade" data-astro-prefetch>
      Pilns mājaslapu izstrādes pakalpojums <Icon name="lucide:arrow-right" aria-hidden="true" />
    </a>
  </aside>

  <section class="liepaja-cta liepaja-shell" aria-labelledby="liepaja-cta-title">
    <div class="liepaja-cta__field" data-reveal>
      <div class="liepaja-cta__dots" aria-hidden="true"></div>
      <div class="liepaja-cta__glow" aria-hidden="true"></div>

      {
        ctaFloaters.map((item, index) => (
          <div
            class:list={['liepaja-cta__floater', `liepaja-cta__floater--${index + 1}`]}
            aria-hidden="true"
          >
            <Icon name={item.icon} aria-hidden="true" />
          </div>
        ))
      }

      <div class="liepaja-cta__copy">
        <h2 id="liepaja-cta-title">Izveidosim mājaslapu, kas Liepājā tiek pamanīta.</h2>
        <p>Pastāstiet par uzņēmumu un ieceri. Atbildēsim ar skaidru nākamo soli.</p>

        <div class="liepaja-cta__actions">
          <a href={contactHref} data-astro-reload>
            Pieteikt projektu <Icon name="lucide:arrow-up-right" aria-hidden="true" />
          </a>
          <a class="liepaja-cta__ghost" href="/pakalpojumi/majaslapu-izstrade" data-astro-prefetch>
            Skatīt pakalpojumu <Icon name="lucide:arrow-right" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div class="liepaja-cta__belt" data-cta-belt aria-label="ROMADI sadarbības ieguvumi">
        <div class="liepaja-cta__belt-track" data-cta-belt-track>
          <div class="liepaja-cta__belt-group" data-cta-belt-group>
            {
              ctaBelt.map((item) => (
                <span>
                  <Icon name={item.icon} aria-hidden="true" />
                  {item.text}
                </span>
              ))
            }
          </div>
          <div class="liepaja-cta__belt-group" aria-hidden="true">
            {
              ctaBelt.map((item) => (
                <span>
                  <Icon name={item.icon} aria-hidden="true" />
                  {item.text}
                </span>
              ))
            }
          </div>
          <div class="liepaja-cta__belt-group" aria-hidden="true">
            {
              ctaBelt.map((item) => (
                <span>
                  <Icon name={item.icon} aria-hidden="true" />
                  {item.text}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</article>

<script>
  const initCtaBelt = (): void => {
    document.querySelectorAll<HTMLElement>('[data-cta-belt]').forEach((belt) => {
      const track = belt.querySelector<HTMLElement>('[data-cta-belt-track]');
      const firstGroup = belt.querySelector<HTMLElement>('[data-cta-belt-group]');
      if (!track || !firstGroup) return;

      let frame = 0;

      const syncBelt = (): void => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const distance = firstGroup.getBoundingClientRect().width;
          if (distance <= 0) return;

          // Pixel-exact travel distance prevents the duplicated content from
          // drifting by sub-pixels at the animation reset point.
          track.style.setProperty('--cta-belt-distance', `${distance}px`);

          // Keep a stable visual speed (~54 px/s) on every viewport size.
          const duration = Math.max(18, distance / 54);
          track.style.setProperty('--cta-belt-duration', `${duration}s`);
        });
      };

      syncBelt();

      if (belt.dataset.beltInitialized !== 'true') {
        belt.dataset.beltInitialized = 'true';
        const observer = new ResizeObserver(syncBelt);
        observer.observe(belt);
        observer.observe(firstGroup);
      }
    });
  };

  const initScopeSwitcher = (): void => {
    document.querySelectorAll<HTMLElement>('[data-scope-switcher]').forEach((switcher) => {
      if (switcher.dataset.initialized === 'true') return;
      switcher.dataset.initialized = 'true';

      const tabs = Array.from(switcher.querySelectorAll<HTMLButtonElement>('[data-scope-tab]'));
      const panels = Array.from(switcher.querySelectorAll<HTMLElement>('[data-scope-panel]'));
      const panelHost = switcher.querySelector<HTMLElement>('.liepaja-scope__panels');
      const phrase = switcher.querySelector<HTMLElement>('[data-scope-phrase]');
      const phraseShell = phrase?.closest<HTMLElement>('.liepaja-scope__phrase') ?? null;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const compactViewport = window.matchMedia('(max-width: 720px), (pointer: coarse)');
      let activeIndex = 0;
      let rotationTimer = 0;
      let resizeFrame = 0;
      let lastMeasuredWidth = 0;
      let rotationStoppedByUser = false;
      let phraseAnimation: Animation | null = null;

      const lockPanelHeight = (): void => {
        if (!panelHost || panels.length === 0) return;
        if (compactViewport.matches) {
          panelHost.style.minHeight = '';
          lastMeasuredWidth = 0;
          return;
        }

        const hostWidth = panelHost.getBoundingClientRect().width;
        if (hostWidth <= 0) return;
        if (Math.abs(hostWidth - lastMeasuredWidth) < 1) return;
        lastMeasuredWidth = hostWidth;

        let tallest = 0;
        const snapshots = panels.map((panel) => ({
          hidden: panel.hidden,
          style: panel.getAttribute('style'),
        }));

        panels.forEach((panel) => {
          panel.hidden = false;
          panel.style.position = 'absolute';
          panel.style.inset = '0 auto auto 0';
          panel.style.width = `${hostWidth}px`;
          panel.style.visibility = 'hidden';
          panel.style.pointerEvents = 'none';
          panel.style.animation = 'none';
          panel.style.display = 'block';
          tallest = Math.max(tallest, panel.scrollHeight);
        });

        panels.forEach((panel, index) => {
          const snapshot = snapshots[index];
          if (snapshot?.style == null) panel.removeAttribute('style');
          else panel.setAttribute('style', snapshot.style);
          panel.hidden = snapshot?.hidden ?? index !== activeIndex;
        });

        panelHost.style.minHeight = `${Math.ceil(tallest)}px`;
      };

      const schedulePanelHeightLock = (): void => {
        cancelAnimationFrame(resizeFrame);
        resizeFrame = requestAnimationFrame(lockPanelHeight);
      };

      const animatePhrase = async (value: string): Promise<void> => {
        if (!phrase) return;

        phraseAnimation?.cancel();
        phraseShell?.setAttribute('data-changing', 'true');

        if (reducedMotion) {
          phrase.textContent = value;
          phraseShell?.removeAttribute('data-changing');
          return;
        }

        try {
          phraseAnimation = phrase.animate(
            [
              { opacity: 1, transform: 'translateY(0)' },
              { opacity: 0, transform: 'translateY(-0.42rem)' },
            ],
            { duration: 190, easing: 'cubic-bezier(.4,0,1,1)', fill: 'forwards' },
          );
          await phraseAnimation.finished;

          const previousWidth = phraseShell?.getBoundingClientRect().width ?? 0;
          phrase.textContent = value;

          if (phraseShell && previousWidth > 0 && window.innerWidth > 560) {
            phraseShell.style.width = 'fit-content';
            const nextWidth = phraseShell.getBoundingClientRect().width;
            phraseShell.style.width = `${previousWidth}px`;
            void phraseShell.offsetWidth;
            phraseShell.style.width = `${nextWidth}px`;
            window.setTimeout(() => {
              if (phraseShell) phraseShell.style.width = '';
            }, 560);
          }

          phraseAnimation = phrase.animate(
            [
              { opacity: 0, transform: 'translateY(0.58rem)' },
              { opacity: 1, transform: 'translateY(0)' },
            ],
            { duration: 520, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'forwards' },
          );
          await phraseAnimation.finished;
        } catch {
          // A new tab selection can intentionally cancel the current transition.
        } finally {
          phraseShell?.removeAttribute('data-changing');
        }
      };

      const selectTab = (nextIndex: number, moveFocus = false): void => {
        const normalizedIndex = (nextIndex + tabs.length) % tabs.length;
        const nextTab = tabs[normalizedIndex];
        if (!nextTab || normalizedIndex === activeIndex) return;

        activeIndex = normalizedIndex;
        tabs.forEach((tab, index) => {
          const isActive = index === activeIndex;
          tab.setAttribute('aria-selected', String(isActive));
          tab.tabIndex = isActive ? 0 : -1;
          if (isActive && moveFocus) tab.focus();
        });
        panels.forEach((panel, index) => {
          panel.hidden = index !== activeIndex;
        });

        animatePhrase(nextTab.dataset.scopePhraseValue ?? '');
      };

      lockPanelHeight();
      window.addEventListener('resize', schedulePanelHeightLock, { passive: true });

      const canAutoRotate =
        !reducedMotion && window.matchMedia('(min-width: 721px) and (hover: hover)').matches;
      const stopRotation = (): void => {
        window.clearInterval(rotationTimer);
        rotationTimer = 0;
      };
      const startRotation = (): void => {
        if (!canAutoRotate || rotationStoppedByUser || rotationTimer) return;
        rotationTimer = window.setInterval(() => selectTab(activeIndex + 1), 5200);
      };

      if (canAutoRotate) {
        const observer = new IntersectionObserver(
          ([entry]) => {
            if (entry?.isIntersecting) startRotation();
            else stopRotation();
          },
          { threshold: 0.18 },
        );
        observer.observe(switcher);
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => {
          rotationStoppedByUser = true;
          stopRotation();
          if (index !== activeIndex) selectTab(index);
        });
        tab.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          rotationStoppedByUser = true;
          stopRotation();
          selectTab(activeIndex + (event.key === 'ArrowRight' ? 1 : -1), true);
        });
      });
    });
  };

  initCtaBelt();
  initScopeSwitcher();
  document.addEventListener('astro:page-load', () => {
    initCtaBelt();
    initScopeSwitcher();
  });
</script>

