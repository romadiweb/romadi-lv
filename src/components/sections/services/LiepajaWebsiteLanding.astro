    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 4%),
      0 0 2.25rem rgb(218 39 92 / 12%);
  }

  .liepaja-scope__phrase[data-changing='true']::before {
    opacity: 0.95;
    transform: translate3d(4%, 0, 0) scale(1.08);
  }

  .liepaja-scope__phrase[data-changing='true']::after {
    animation: scope-phrase-sheen 720ms var(--ease-out-expo) both;
  }

  .liepaja-scope__phrase > span {
    display: block;
    line-height: 1.08;
    white-space: nowrap;
    will-change: transform, opacity;
  }

  .liepaja-scope__heading > p {
    margin-top: 1rem;
    color: rgb(255 255 255 / 67%);
    font-size: 0.95rem;
  }

  @keyframes scope-phrase-sheen {
    0% {
      opacity: 0;
      transform: translateX(-65%);
    }
    24% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(80%);
    }
  }

  .liepaja-scope__tabs {
    display: flex;
    width: fit-content;
    margin: 3.25rem auto 0;
    gap: 0.25rem;
    border: 1px solid rgb(255 255 255 / 13%);
    border-radius: 999px;
    padding: 0.28rem;
    background: rgb(8 8 8 / 88%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 3%);
  }

  .liepaja-scope__tabs button {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    gap: 0.55rem;
    border: 0;
    border-radius: 999px;
    padding-inline: 1.05rem;
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 680;
    cursor: pointer;
    transition:
      color 220ms ease,
      background-color 260ms ease,
      transform 260ms var(--ease-out-expo),
      box-shadow 260ms ease;
  }

  .liepaja-scope__tabs button:hover {
    color: white;
  }

  .liepaja-scope__tabs button[aria-selected='true'] {
    background: linear-gradient(135deg, var(--accent), var(--accent-hover));
    color: white;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 16%),
      0 0.5rem 1.5rem rgb(157 14 52 / 18%);
  }

  .liepaja-scope__tabs button :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .liepaja-scope__panels {
    position: relative;
    margin: 2.25rem auto 0;
    transition: none;
  }

  .liepaja-scope__panels article {
    position: relative;
    border: 1px solid rgb(255 255 255 / 11%);
    background: #0a0a0a;
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 20%);
    animation: scope-enter 620ms var(--ease-out-expo) both;
  }

  .liepaja-scope__panels article:not([hidden]) {
    display: block;
  }

  .liepaja-scope__panels article[hidden] {
    display: none;
  }

  .liepaja-scope__handle {
    position: absolute;
    z-index: 5;
    width: 0.72rem;
    height: 0.72rem;
    border: 1px solid rgb(255 255 255 / 17%);
    background: #111;
    pointer-events: none;
  }

  .liepaja-scope__handle--tl {
    top: 0;
    left: 0;
    transform: translate(-50%, -50%);
  }
  .liepaja-scope__handle--tr {
    top: 0;
    right: 0;
    transform: translate(50%, -50%);
  }
  .liepaja-scope__handle--bl {
    bottom: 0;
    left: 0;
    transform: translate(-50%, 50%);
  }
  .liepaja-scope__handle--br {
    right: 0;
    bottom: 0;
    transform: translate(50%, 50%);
  }

  .liepaja-scope__overview {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(29rem, 1.08fr);
    min-height: 18rem;
    border-bottom: 1px solid rgb(255 255 255 / 11%);
  }

  .liepaja-scope__summary {
    display: grid;
    align-content: center;
    justify-items: start;
    padding: clamp(2rem, 4vw, 3.25rem);
  }

  .liepaja-scope__eyebrow {
    color: var(--accent-hover);
    font: 680 0.7rem/1.4 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .liepaja-scope__summary h3 {
    max-width: 18ch;
    margin-top: 0.7rem;
    color: white;
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    font-weight: 580;
    letter-spacing: -0.035em;
    line-height: 1.06;
    text-wrap: balance;
  }

  .liepaja-scope__summary > p {
    max-width: 49ch;
    margin-top: 0.9rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.58;
  }

  .liepaja-scope__price {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .liepaja-scope__price strong {
    color: white;
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    font-weight: 560;
    letter-spacing: -0.045em;
  }

  .liepaja-scope__price span {
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .liepaja-scope__summary > a {
    width: fit-content;
    min-height: 2.8rem;
    margin-top: 1.35rem;
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: 999px;
    padding-inline: 1rem;
    background: white;
    color: #090909;
    font-size: 0.78rem;
    font-weight: 720;
  }

  .liepaja-scope__visual {
    position: relative;
    display: grid;
    align-content: center;
    margin: 2.25rem 2.25rem 2.25rem 0;
    border: 1px solid rgb(255 255 255 / 11%);
    padding: 1.45rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 42%, rgb(222 40 93 / 8%), transparent 48%), rgb(10 10 10 / 78%);
  }

  .liepaja-scope__visual::before {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgb(255 255 255 / 10%) 0.8px, transparent 1px);
    background-size: 12px 12px;
    mask-image: linear-gradient(to bottom, transparent, black 18%, black 82%, transparent);
    content: '';
    opacity: 0.22;
    pointer-events: none;
  }

  .liepaja-scope__visual-head {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--text-muted);
    font: 600 0.68rem/1.4 var(--font-mono);
  }

  .liepaja-scope__visual-head span:last-child {
    color: var(--accent-hover);
  }

  .liepaja-scope__flow {
    --scope-nodes: 4;
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(var(--scope-nodes), minmax(0, 1fr));
    gap: 0.62rem;
    margin-top: 1rem;
  }

  .liepaja-scope__flow-line {
    position: absolute;
    z-index: -1;
    top: 50%;
    right: 6%;
    left: 6%;
    height: 1px;
    background: linear-gradient(90deg, rgb(222 40 93 / 10%), var(--accent), rgb(222 40 93 / 10%));
    box-shadow: 0 0 1rem rgb(222 40 93 / 18%);
    transform: translateY(-50%) scaleX(0);
    transform-origin: left;
    animation: scope-flow-line 900ms 180ms var(--ease-out-expo) forwards;
  }

  .liepaja-scope__flow-node {
    display: grid;
    min-width: 0;
    min-height: 4.1rem;
    place-items: center;
    align-content: center;
    gap: 0.35rem;
    border: 1px solid rgb(255 255 255 / 11%);
    background: #0d0d0d;
    color: rgb(255 255 255 / 82%);
    opacity: 0;
    transform: translateY(0.55rem);
    animation: scope-flow-node 520ms var(--scope-delay) var(--ease-out-expo) forwards;
  }

  .liepaja-scope__flow-node :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--accent-hover);
  }

  .liepaja-scope__flow-node span {
    overflow: hidden;
    max-width: 100%;
    padding-inline: 0.25rem;
    font-size: 0.68rem;
    font-weight: 650;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .liepaja-scope__visual > p {
    position: relative;
    z-index: 1;
    margin: 1rem auto 0;
    color: var(--text-muted);
    font-size: 0.72rem;
    line-height: 1.45;
    text-align: center;
  }

  .liepaja-scope__details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .liepaja-scope__details > section {
    min-height: 14.75rem;
    padding: 1.75rem;
    background: rgb(8 8 8 / 72%);
  }

  .liepaja-scope__details > section + section {
    border-left: 1px solid rgb(255 255 255 / 11%);
  }

  .liepaja-scope__details > section > span {
    color: white;
    font-size: 0.78rem;
    font-weight: 720;
  }

  .liepaja-scope__details strong {
    display: block;
    margin-top: 0.65rem;
    color: white;
    font-size: 1.55rem;
    font-weight: 560;
    letter-spacing: -0.04em;
  }

  .liepaja-scope__details p {
    max-width: 40ch;
    margin-top: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .liepaja-scope__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .liepaja-scope__tags span {
    border: 1px dashed rgb(255 255 255 / 12%);
    border-radius: 0.35rem;
    padding: 0.35rem 0.5rem;
    color: rgb(255 255 255 / 72%);
    font-size: 0.67rem;
    line-height: 1;
  }

  @keyframes scope-enter {
    from {
      opacity: 0;
      transform: translateY(0.8rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes scope-flow-line {
    to {
      transform: translateY(-50%) scaleX(1);
    }
  }

  @keyframes scope-flow-node {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .liepaja-split-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
    align-items: end;
    gap: 3rem;
  }

  .liepaja-split-heading h2 {
    max-width: 18ch;
  }

  .liepaja-process ol {
    display: grid;
    margin-top: 2.5rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgb(255 255 255 / 11%);
    border-left: 1px solid rgb(255 255 255 / 11%);
    list-style: none;
  }

  .liepaja-process li {
    min-height: 14rem;
    border-right: 1px solid rgb(255 255 255 / 11%);
    border-bottom: 1px solid rgb(255 255 255 / 11%);
    padding: 1.6rem;
  }

  .liepaja-faq {
    display: grid;
    grid-template-columns: minmax(16rem, 0.65fr) minmax(0, 1.35fr);
    gap: 4rem;
    border-top: 1px solid rgb(255 255 255 / 10%);
  }

  .liepaja-faq h2 {
    max-width: 10ch;
  }
  .liepaja-faq__list {
    border-top: 1px solid rgb(255 255 255 / 12%);
  }
  .liepaja-faq details {
    border-bottom: 1px solid rgb(255 255 255 / 12%);
  }

  .liepaja-faq summary {
    display: flex;
    min-height: 4.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    color: rgb(255 255 255 / 86%);
    cursor: pointer;
    font-size: 0.96rem;
    font-weight: 650;
    list-style: none;
  }

  .liepaja-faq summary::-webkit-details-marker {
    display: none;
  }

  .liepaja-faq summary :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: none;
    color: var(--accent-hover);
    transition: transform 220ms var(--ease-out-expo);
  }

  .liepaja-faq details[open] summary :global(svg) {
    transform: rotate(45deg);
  }

  .liepaja-faq details > p {
    max-width: 66ch;
    padding: 0 3rem 1.75rem 0;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .liepaja-related {
    display: flex;
    min-height: 10rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid rgb(255 255 255 / 11%);
    border-bottom: 1px solid rgb(255 255 255 / 11%);
    padding-block: 1.75rem;
  }

  .liepaja-related h2 {
    font-size: 1.3rem;
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .liepaja-related p {
    max-width: 62ch;
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .liepaja-related > a {
    flex: none;
    border: 1px solid rgb(255 255 255 / 18%);
    color: white;
  }
  .liepaja-cta {
    width: calc(100% - 4rem);
    max-width: none;
    padding-block: clamp(5rem, 8vw, 7rem) 0;
  }

  .liepaja-cta__field {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 34rem;
    place-items: center;
    align-content: center;
    overflow: hidden;
    border-radius: 1.5rem 1.5rem 0 0;
    padding: 4.25rem 2rem 6.8rem;
    text-align: center;
    background:
      radial-gradient(circle at 50% 108%, rgb(255 235 220 / 32%), transparent 15rem),
      linear-gradient(180deg, rgb(255 255 255 / 5%), transparent 26%),
      linear-gradient(135deg, #b3113a, #d02156 38%, #7f0b2b 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 8%),
      0 32px 100px rgb(0 0 0 / 34%);
  }

  .liepaja-cta__dots,
  .liepaja-cta__glow {
    position: absolute;
    pointer-events: none;
  }

  .liepaja-cta__dots {
    inset: 0;
    background-image: radial-gradient(circle, rgb(255 255 255 / 26%) 0.8px, transparent 1px);
    background-size: 8px 8px;
    mask-image: linear-gradient(to bottom, rgb(0 0 0 / 92%), black 68%, transparent 96%);
    opacity: 0.44;
  }

  .liepaja-cta__glow {
    left: 50%;
    bottom: -8rem;
    width: min(34rem, 84vw);
    height: 15rem;
    transform: translateX(-50%);
    border-radius: 50%;
    background: rgb(255 249 216 / 82%);
    filter: blur(42px);
    opacity: 0.92;
  }

  .liepaja-cta__copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    max-width: 52rem;
  }

  .liepaja-cta h2 {
    max-width: 15ch;
  }

  .liepaja-cta p {
    max-width: 44rem;
    margin-top: 1.35rem;
    color: rgb(255 255 255 / 88%);
    font-size: 1rem;
    line-height: 1.6;
  }

  .liepaja-cta__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .liepaja-cta a {
    margin-top: 0;
    background: white;
    color: #090909;
  }

  .liepaja-cta__ghost {
    border: 1px solid rgb(255 255 255 / 28%);
    background: rgb(255 255 255 / 12%) !important;
    color: white !important;
    backdrop-filter: blur(8px);
  }

  .liepaja-cta__floater {
    position: absolute;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 4.05rem;
    aspect-ratio: 1;
    border: 1px dashed rgb(255 255 255 / 40%);
    border-radius: 1rem;
    background: rgb(255 255 255 / 5%);
    color: rgb(255 255 255 / 94%);
    backdrop-filter: blur(7px);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 8%);
    animation: cta-float 9s ease-in-out infinite;
  }

  .liepaja-cta__floater :global(svg) {
    width: 1.28rem;
    height: 1.28rem;
  }

  .liepaja-cta__floater--1 {
    top: 1.7rem;
    left: 14%;
    --r: 9deg;
    transform: rotate(var(--r));
    animation-delay: -1.4s;
  }

  .liepaja-cta__floater--2 {
    top: 2.4rem;
    right: 15%;
    --r: -10deg;
    transform: rotate(var(--r));
    animation-delay: -4.7s;
  }

  .liepaja-cta__floater--3 {
    top: 8.9rem;
    left: 8%;
    --r: -6deg;
    transform: rotate(var(--r));
    animation-delay: -2.8s;
  }

  .liepaja-cta__floater--4 {
    top: 9.2rem;
    right: 9%;
    --r: 11deg;
    transform: rotate(var(--r));
    animation-delay: -5.2s;
  }

  .liepaja-cta__floater--5 {
    top: 11.4rem;
    right: 23%;
    --r: -4deg;
    transform: rotate(var(--r));
    animation-delay: -7.1s;
  }

  .liepaja-cta__belt {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    overflow: hidden;
    border-top: 1px solid rgb(255 255 255 / 14%);
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 8%),
      rgb(255 255 255 / 2%) 18%,
      rgb(255 255 255 / 2%) 82%,
      rgb(255 255 255 / 8%)
    );
    backdrop-filter: blur(8px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .liepaja-cta__belt-track {
    --cta-belt-distance: 0px;
    --cta-belt-duration: 28s;
    display: flex;
    width: max-content;
    transform: translate3d(0, 0, 0);
    will-change: transform;
    animation: cta-belt-scroll var(--cta-belt-duration) linear infinite;
    backface-visibility: hidden;
  }

  .liepaja-cta__belt:hover .liepaja-cta__belt-track {
    animation-play-state: paused;
  }

  .liepaja-cta__belt-group {
    display: flex;
    flex: none;
    align-items: stretch;
  }

  .liepaja-cta__belt-group span {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-width: clamp(17rem, 24vw, 23rem);
    min-height: 3.7rem;
    padding: 0.85rem 1.25rem;
    color: rgb(255 255 255 / 92%);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
    white-space: nowrap;
  }

  .liepaja-cta__belt-group span {
    border-left: 1px solid rgb(255 255 255 / 12%);
  }

  .liepaja-cta__belt-group :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: none;
    color: rgb(255 249 216 / 94%);
  }

  @keyframes cta-belt-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-1 * var(--cta-belt-distance)), 0, 0);
    }
  }

  @keyframes cta-float {
    0%,
    100% {
      transform: translateY(0) rotate(var(--r, 0deg));
    }
    50% {
      transform: translateY(-10px) rotate(var(--r, 0deg));
    }
  }

  @media (max-width: 1050px) {
    .liepaja-page::before,
    .liepaja-page::after {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .liepaja-shell {
      width: min(calc(100% - 2rem), 74rem);
    }
    .liepaja-hero {
      width: calc(100% - 1.5rem);
      min-height: calc(100svh - 1.5rem);
      margin-block: 0.75rem;
    }
    .liepaja-hero__field {
      min-height: 46rem;
      grid-template-rows: minmax(0, 1fr) auto;
    }
    .liepaja-hero__copy {
      padding: 8rem 1.25rem 2rem;
    }
    .liepaja-hero__proof {
      position: static;
      width: calc(100% - 1.5rem);
      margin: 0 auto 0.75rem;
    }
    .liepaja-hero__facts {
      grid-template-columns: 1fr;
    }
    .liepaja-hero__facts > div {
      grid-template-columns: minmax(8rem, 0.65fr) 1fr;
      gap: 1rem;
    }
    .liepaja-hero__facts > div + div {
      border-top: 1px solid rgb(255 255 255 / 10%);
      border-left: 0;
    }
    .liepaja-region__facts {
      grid-template-columns: 1fr;
    }
    .liepaja-region__facts article {
      min-height: auto;
    }
    .liepaja-region__facts article + article {
      border-top: 1px solid rgb(255 255 255 / 11%);
      border-left: 0;
    }
    .liepaja-review__panel {
      grid-template-columns: minmax(0, 1fr) minmax(8.5rem, 0.34fr);
      grid-template-areas:
        'quote brand'
        'belt belt';
      min-height: 0;
    }
    .liepaja-review__brand {
      border-top: 0;
      border-left: 1px solid rgb(255 255 255 / 10%);
    }
    .liepaja-review__belt {
      display: none;
    }
    .liepaja-scope__overview {
      grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 1.1fr);
    }
    .liepaja-scope__visual {
      margin: 1.5rem 1.5rem 1.5rem 0;
    }
    .liepaja-scope__details > section {
      min-height: 13.5rem;
      padding: 1.4rem;
    }
    .liepaja-split-heading,
    .liepaja-faq {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .liepaja-split-heading h2,
    .liepaja-faq h2 {
      max-width: 18ch;
    }
    .liepaja-process ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .liepaja-faq {
      gap: 2.5rem;
    }
  }

  @media (max-width: 560px) {
    .liepaja-shell {
      width: min(calc(100% - 1rem), 74rem);
    }
    .liepaja-hero,
    .liepaja-cta {
      width: calc(100% - 1.5rem);
    }
    .liepaja-breadcrumbs {
      padding-inline: 0.5rem;
      font-size: 0.7rem;
    }
    .liepaja-hero__field {
      min-height: 49rem;
      border-radius: 1rem;
