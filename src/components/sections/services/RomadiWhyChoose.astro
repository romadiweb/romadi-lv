</style>

<style is:global>
  [data-romadi-why] .rw__timeline-item.is-active .rw__timeline-track i {
    animation-duration: var(--rw-phase-duration, 5200ms);
  }
</style>

<script define:vars={{ interval }}>
  document.querySelectorAll('[data-romadi-why]').forEach((section) => {
    section.style.setProperty(
      '--rw-phase-duration',
      `${Math.max(3200, Number(interval) || 5200)}ms`,
    );
  });
</script>
