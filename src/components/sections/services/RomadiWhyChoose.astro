  }
  .rw__alert--4 {
    top: 60%;
    right: 8%;
    animation-delay: -3.6s;
  }
  .rw__alert--5 {
    bottom: 6%;
    left: -3%;
    animation-delay: -2.8s;
  }
  .rw__alert--6 {
    bottom: 9%;
    right: -7%;
