  .rw__phase--web .rw__alert--3 {
    top: 54%;
    left: 4%;
  }
  .rw__phase--web .rw__alert--4 {
    top: 60%;
    right: 8%;
  }
  .rw__phase--web .rw__alert--5 {
    bottom: 5%;
    left: -2%;
