---
interface Props {
  title?: string;
  interval?: number;
}

const { title = 'Kāpēc izvēlēties ROMADI', interval = 5200 } = Astro.props;

const waveHeights = [
  16, 20, 13, 24, 38, 18, 26, 44, 32, 20, 15, 24, 41, 58, 35, 22, 16, 29, 47, 34, 19, 14, 27, 38,
  62, 31, 22, 17, 26, 48, 72, 39, 28, 19, 14, 31, 53, 43, 24, 18, 29, 56, 37, 21, 16, 24, 46, 66,
  36, 22, 17, 30, 50, 33, 19, 15, 27, 43, 31, 18, 23, 40, 58, 34, 20, 14, 25, 47, 70, 42, 27, 18,
  31, 54, 39, 22, 16, 28, 48, 35, 21, 14, 26, 44, 63, 36, 24, 18, 29, 51, 38, 22, 17, 24, 41, 30,
];

const phases = [
  {
    key: 'web',
    kicker: 'WEB / DEVELOPMENT',
    dynamic: 'uzbūvētu ātru un pārdomātu digitālo produktu',
    leftTitle: 'Kad viss jāsaliek pašam',
    rightTitle: 'Izstrāde ar\nROMADI',
    status: 'Publicēta jauna produkta versija',
    metric: '98/100',
    metricLabel: 'performance',
    notes: [
      ['warning', 'Mobile', 'Hero nobīdās uz mazākiem ekrāniem'],
      ['error', 'Build', 'Vēl 4 neatrisinātas integrācijas'],
      ['muted', 'Forms', 'Pieteikumi glabājas trīs dažādās vietās'],
      ['error', 'Speed', 'LCP 4.8s — jāoptimizē attēli'],
      ['muted', 'CMS', 'Atjauninājums salauza custom bloku'],
      ['warning', 'SEO', 'Trūkst meta datu 17 lapām'],
    ],
  },
  {
    key: 'brand',
    kicker: 'BRAND / DESIGN',
    dynamic: 'izveidotu zīmolu, kas visur izskatās vienoti',
    leftTitle: 'Kad vizuālais tēls dzīvo pa failiem',
    rightTitle: 'Dizains ar\nROMADI',
    status: 'Apstiprināta vienota dizaina sistēma',
    metric: '1 sistēma',
    metricLabel: 'visiem kanāliem',
    notes: [
      ['muted', 'Logo', 'logo_final_FINAL_v12.svg'],
      ['warning', 'Fonts', 'Web un prezentācijā atšķirīgi svari'],
      ['error', 'Colors', 'Akcenta tonim atrastas 7 versijas'],
      ['muted', 'Social', 'Katrs ieraksts sākas no nulles'],
      ['warning', 'UI', 'Komponentēm nav vienotas sistēmas'],
      ['error', 'Export', 'Atkal nepareizais logo formāts'],
    ],
  },
  {
    key: 'ai',
    kicker: 'AI / AUTOMATION',
    dynamic: 'automatizētu atkārtojošos darbus un procesus',
    leftTitle: 'Kad process balstās uz manuālu darbu',
    rightTitle: 'Automatizācija ar\nROMADI',
    status: 'Procesi izpildīti automātiski šodien',
    metric: '12h',
    metricLabel: 'ietaupītas nedēļā',
    notes: [
      ['warning', 'Inbox', '37 pieprasījumi vēl jāpārkopē CRM'],
      ['muted', 'Excel', 'Vēlreiz manuāli jāapvieno 4 tabulas'],
      ['error', 'Lead', 'Klientam neatbildēts 19 stundas'],
      ['muted', 'Reports', 'Piektdien atkal jātaisa ar rokām'],
      ['warning', 'Data', 'Divās sistēmās atšķiras statuss'],
      ['error', 'Reminder', 'Atgādinājums netika nosūtīts'],
    ],
  },
];
---

<section class="rw" data-romadi-why data-interval={interval} aria-labelledby="rw-title">
  <div class="rw__rail rw__rail--left" aria-hidden="true"></div>
  <div class="rw__rail rw__rail--right" aria-hidden="true"></div>

  <div class="rw__inner">
    <header class="rw__header">
      <h2 id="rw-title">{title}</h2>

      <div class="rw__subline" aria-hidden="true">
        <div class="rw__subline-shell">
          <span class="rw__subline-static">Viss nepieciešamais, lai</span>
          <span class="rw__word-window" data-word-window>
            {
              phases.map((phase, index) => (
                <span
                  class:list={['rw__dynamic', { 'is-active': index === 0 }]}
                  data-dynamic-phase={index}
                >
                  {phase.dynamic}
                </span>
              ))
            }
          </span>
        </div>
      </div>

      <p class="rw__sr-only">ROMADI apvieno dizainu, izstrādi un automatizāciju vienā komandā.</p>
    </header>

    <div class="rw__stage" data-stage data-active-phase="0">
      <div class="rw__corner rw__corner--tl" aria-hidden="true"></div>
      <div class="rw__corner rw__corner--tr" aria-hidden="true"></div>
      <div class="rw__corner rw__corner--bl" aria-hidden="true"></div>
      <div class="rw__corner rw__corner--br" aria-hidden="true"></div>

      <div class="rw__left">
        <div class="rw__left-grid" aria-hidden="true"></div>
        <div class="rw__left-noise" aria-hidden="true"></div>
        <div class="rw__left-vignette" aria-hidden="true"></div>

        {
          phases.map((phase, index) => (
            <div
              class:list={[
                'rw__phase',
                'rw__phase--left',
                `rw__phase--${phase.key}`,
                { 'is-active': index === 0 },
              ]}
              data-left-phase={index}
            >
              <div class="rw__phase-kicker">{phase.kicker}</div>
              <h3>{phase.leftTitle}</h3>

              <div class="rw__alerts" aria-hidden="true">
                {phase.notes.map((note, noteIndex) => (
                  <div
                    class:list={[
                      'rw__alert',
                      `rw__alert--${note[0]}`,
                      `rw__alert--${noteIndex + 1}`,
                    ]}
                  >
                    <span class="rw__alert-icon">
                      {note[0] === 'error' ? '!' : note[0] === 'warning' ? '△' : '○'}
                    </span>
                    <span class="rw__alert-copy">
                      <b>{note[1]}</b>
                      <span>{note[2]}</span>
                    </span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }

        <div class="rw__wave" aria-hidden="true">
          <div class="rw__wave-line"></div>
          <div class="rw__bars">
            {
              waveHeights.map((height, index) => (
                <i
                  style={`--h:${height}%; --d:${(index % 9) * 0.09}s; --o:${0.28 + (index % 5) * 0.1}`}
                />
              ))
            }
          </div>
        </div>

        <div class="rw__incident" aria-hidden="true">
          <span class="rw__incident-dot"></span>
          <div>
            <span data-incident-number>14</span>
            <small>atvērtas lietas</small>
          </div>
        </div>
      </div>

      <div class="rw__right">
        <div class="rw__right-grid" aria-hidden="true"></div>
        <div class="rw__right-glow" aria-hidden="true"></div>
        <div class="rw__scan" aria-hidden="true"></div>

        {
          phases.map((phase, index) => (
            <div
              class:list={[
                'rw__phase',
                'rw__phase--right',
                `rw__phase--${phase.key}`,
                { 'is-active': index === 0 },
              ]}
              data-right-phase={index}
            >
              <p class="rw__right-kicker">{phase.kicker}</p>
              <h3>
                {phase.rightTitle.split('\n').map((line) => (
                  <span>{line}</span>
                ))}
              </h3>

              <div class="rw__metric">
                <strong>{phase.metric}</strong>
                <span>{phase.metricLabel}</span>
              </div>

              <div class="rw__success">
                <span class="rw__check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="m5 12.5 4 4L19 7" />
                  </svg>
                </span>
                <span class="rw__success-copy">{phase.status}</span>
                <strong class="rw__success-number" data-success-number={index}>
                  {index === 0 ? '01' : index === 1 ? '01' : '24'}
                </strong>
              </div>
            </div>
          ))
        }

        <div class="rw__signature" aria-hidden="true">
          <span>DESIGN</span><i></i><span>CODE</span><i></i><span>GROW</span>
        </div>
      </div>

      <div class="rw__divider" aria-hidden="true">
        <span></span>
      </div>
    </div>

    <div class="rw__timeline" role="tablist" aria-label="ROMADI pakalpojumu virzieni">
      {
        phases.map((phase, index) => (
          <button
            type="button"
            role="tab"
            class:list={['rw__timeline-item', { 'is-active': index === 0 }]}
            aria-selected={index === 0 ? 'true' : 'false'}
            data-phase-button={index}
          >
            <span class="rw__timeline-index">0{index + 1}</span>
            <span class="rw__timeline-label">
              {index === 0 ? 'Izstrāde' : index === 1 ? 'Dizains' : 'AI / automatizācija'}
            </span>
            <span class="rw__timeline-track">
              <i />
            </span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  const sections = document.querySelectorAll('[data-romadi-why]');

  sections.forEach((section) => {
    const el = section as HTMLElement;
    if (el.dataset.initialized === 'true') return;
    el.dataset.initialized = 'true';

    const stage = section.querySelector('[data-stage]') as HTMLElement;
    const wordWindow = section.querySelector('[data-word-window]') as HTMLElement | null;
    const dynamics = [...section.querySelectorAll('[data-dynamic-phase]')];
    const leftPhases = [...section.querySelectorAll('[data-left-phase]')];
    const rightPhases = [...section.querySelectorAll('[data-right-phase]')];
    const buttons = [...section.querySelectorAll('[data-phase-button]')];
    const incidentNumber = section.querySelector('[data-incident-number]');
    const successNumbers = [...section.querySelectorAll('[data-success-number]')];

    if (!stage || dynamics.length === 0) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const interval = Math.max(3200, Number(el.dataset.interval) || 5200);

    let active = 0;
    let timer: number | undefined;
    let visible = true;
    let userPausedUntil = 0;

    const counts = [
      ['17', '03'],
      ['09', '01'],
      ['24', '12'],
    ];

    const activate = (next: number, manual = false) => {
      const count = dynamics.length;
      active = ((next % count) + count) % count;

      stage.dataset.activePhase = String(active);

      dynamics.forEach((el, i) => el.classList.toggle('is-active', i === active));
      leftPhases.forEach((el, i) => el.classList.toggle('is-active', i === active));
      rightPhases.forEach((el, i) => el.classList.toggle('is-active', i === active));

      buttons.forEach((button, i) => {
        const isActive = i === active;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-selected', String(isActive));
      });

      if (incidentNumber) incidentNumber.textContent = counts[active]?.[0] ?? null;

      if (wordWindow && !reducedMotion) {
        wordWindow.classList.remove('is-flashing');
        void wordWindow.offsetWidth;
        wordWindow.classList.add('is-flashing');
      }
      successNumbers.forEach((el, i) => {
        if (i === active) el.textContent = counts[active]?.[1] ?? null;
      });

      if (manual) userPausedUntil = performance.now() + interval * 1.35;
    };

    const schedule = () => {
      if (reducedMotion || !visible) return;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (performance.now() < userPausedUntil) {
          schedule();
          return;
        }
        activate(active + 1);
        schedule();
      }, interval);
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => {
        activate(index, true);
        schedule();
      });
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        visible = entry?.isIntersecting ?? false;
        if (visible) schedule();
        else window.clearTimeout(timer);
      },
      { threshold: 0.18 },
    );

    observer.observe(section);

    let raf = 0;
    section.addEventListener('pointermove', (event) => {
      if (reducedMotion) return;
      const pointerEvent = event as PointerEvent;
      const rect = stage.getBoundingClientRect();
      const x = Math.max(0, Math.min(1, (pointerEvent.clientX - rect.left) / rect.width));
      const y = Math.max(0, Math.min(1, (pointerEvent.clientY - rect.top) / rect.height));

      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        stage.style.setProperty('--mx', `${x * 100}%`);
        stage.style.setProperty('--my', `${y * 100}%`);
      });
    });

    section.addEventListener('pointerleave', () => {
      stage.style.setProperty('--mx', '74%');
      stage.style.setProperty('--my', '44%');
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) window.clearTimeout(timer);
      else schedule();
    });

    activate(0);
    schedule();
  });
</script>

<style>
  .rw {
    --rw-accent: var(--romadi-accent, #dc285f);
    --rw-accent-bright: var(--romadi-accent-bright, #f43a73);
    --rw-bg: var(--romadi-background, #0b0b0d);
    --rw-surface: #101012;
    --rw-surface-2: #141416;
    --rw-text: var(--romadi-text, #f4f0f1);
    --rw-muted: var(--romadi-muted, #989194);
    --rw-line: rgba(255, 255, 255, 0.105);
    --rw-faint: rgba(255, 255, 255, 0.045);
    --rw-radius: 0px;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--rw-bg);
    color: var(--rw-text);
    padding: clamp(70px, 7vw, 112px) 0 clamp(58px, 6vw, 88px);
    font-family: inherit;
  }

  .rw::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
      radial-gradient(600px 360px at 52% 8%, rgba(220, 40, 95, 0.055), transparent 68%),
      linear-gradient(var(--rw-bg), var(--rw-bg));
  }

  .rw__inner {
    width: min(1180px, calc(100% - 36px));
    margin: 0 auto;
    position: relative;
  }

  .rw__rail {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(72px, 11vw, 170px);
    pointer-events: none;
    opacity: 0.76;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.105) 1px, transparent 1.25px);
    background-size: 12px 12px;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 9%, #000 92%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 9%, #000 92%, transparent);
  }

  .rw__rail::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(transparent, var(--rw-line) 12%, var(--rw-line) 88%, transparent);
  }

  .rw__rail--left {
    left: 0;
  }
  .rw__rail--left::after {
    right: 0;
  }
  .rw__rail--right {
    right: 0;
  }
  .rw__rail--right::after {
    left: 0;
  }

  .rw__header {
    position: relative;
    text-align: center;
    max-width: 900px;
    margin: 0 auto clamp(38px, 4.6vw, 56px);
  }

  .rw h2 {
    margin: 0;
    font-size: clamp(36px, 4.15vw, 58px);
    line-height: 0.98;
    letter-spacing: -0.05em;
    font-weight: 650;
    text-wrap: balance;
  }

  .rw__subline {
    display: flex;
    justify-content: center;
    min-height: 42px;
    margin-top: 22px;
    color: var(--rw-muted);
    font-size: clamp(16px, 1.26vw, 19px);
    line-height: 1.5;
    letter-spacing: -0.025em;
  }

  .rw__subline-shell {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.36em;
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
  }

  .rw__subline-static {
    white-space: nowrap;
  }

  .rw__word-window {
    position: relative;
    display: inline-grid;
    place-items: center;
    overflow: hidden;
    width: fit-content;
    max-width: min(100%, 54ch);
    min-height: 1.78em;
    padding: 0.14em 0.28em;
    text-align: center;
    vertical-align: bottom;
    border-radius: 0.45em;
    isolation: isolate;
  }

  .rw__word-window::before {
    content: '';
    position: absolute;
    inset: 0.1em 0.06em;
    border: 1px solid color-mix(in srgb, var(--rw-accent) 28%, transparent);
    border-radius: inherit;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--rw-accent) 15%, transparent),
        transparent 74%
      ),
      radial-gradient(
        circle at 50% 50%,
        color-mix(in srgb, var(--rw-accent) 18%, transparent),
        transparent 72%
      );
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.05),
      0 10px 34px color-mix(in srgb, var(--rw-accent) 12%, transparent);
    opacity: 0.62;
    z-index: -1;
    transform: scale(0.985);
    transition:
      opacity 360ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 360ms ease;
  }

  .rw__word-window::after {
    content: '';
    position: absolute;
    inset: -26% -2%;
    z-index: -2;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in srgb, var(--rw-accent) 18%, transparent),
      transparent 66%
    );
    filter: blur(20px);
    opacity: 0.4;
    transition:
      opacity 360ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rw__word-window.is-flashing::before {
    opacity: 0.95;
    transform: scale(1);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.09),
      0 14px 40px color-mix(in srgb, var(--rw-accent) 18%, transparent);
  }

  .rw__word-window.is-flashing::after {
    opacity: 0.82;
    transform: scale(1.03);
  }

  .rw__dynamic {
    grid-area: 1 / 1;
    width: 100%;
    color: color-mix(in srgb, var(--rw-accent) 84%, white 16%);
    opacity: 0;
    transform: translateY(125%);
    filter: blur(8px);
    clip-path: inset(0 0 100% 0);
    text-align: center;
    transition:
      opacity 420ms ease,
      transform 760ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 620ms ease,
      clip-path 760ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rw__dynamic.is-active {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    clip-path: inset(0 0 0 0);
  }

  .rw__stage {
    --mx: 74%;
    --my: 44%;
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: clamp(470px, 40vw, 540px);
    border: 1px solid var(--rw-line);
    background: var(--rw-surface);
    box-shadow:
      0 34px 90px rgba(0, 0, 0, 0.33),
      inset 0 1px rgba(255, 255, 255, 0.012);
  }

  .rw__left,
  .rw__right {
    position: relative;
    min-width: 0;
    overflow: hidden;
  }

  .rw__left {
    background:
      radial-gradient(circle at 54% 45%, rgba(255, 255, 255, 0.018), transparent 42%), #0d0d0f;
  }

  .rw__right {
    background:
      radial-gradient(circle at var(--mx) var(--my), rgba(255, 255, 255, 0.14), transparent 33%),
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--rw-accent) 84%, #8d163c 16%),
        color-mix(in srgb, var(--rw-accent-bright) 80%, var(--rw-accent) 20%)
      );
  }

  .rw__left-grid,
  .rw__right-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .rw__left-grid {
    opacity: 0.35;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.25),
      #000 35%,
      #000 80%,
      transparent
    );
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.25), #000 35%, #000 80%, transparent);
  }

  .rw__right-grid {
    opacity: 0.16;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 70px 70px;
    -webkit-mask-image: radial-gradient(circle at 50% 42%, #000, transparent 78%);
    mask-image: radial-gradient(circle at 50% 42%, #000, transparent 78%);
  }

  .rw__left-noise {
    position: absolute;
    inset: 0;
    opacity: 0.17;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.13'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }

  .rw__left-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(8, 8, 10, 0.28),
      transparent 18%,
      transparent 82%,
      rgba(8, 8, 10, 0.36)
    );
    pointer-events: none;
  }

  .rw__right-glow {
    position: absolute;
    width: 70%;
    aspect-ratio: 1;
    right: -18%;
    top: -35%;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    filter: blur(90px);
    pointer-events: none;
  }

  .rw__scan {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    top: 50%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.55) 12%,
      rgba(255, 255, 255, 0.68) 50%,
      rgba(255, 255, 255, 0.55) 88%,
      transparent
    );
    box-shadow: 0 0 18px rgba(255, 255, 255, 0.18);
    opacity: 0.55;
  }

  .rw__scan::after {
    content: '';
    position: absolute;
    left: -20%;
    width: 22%;
    height: 1px;
    background: white;
    box-shadow: 0 0 14px rgba(255, 255, 255, 0.8);
    animation: rw-scan 4.2s linear infinite;
  }

  @keyframes rw-scan {
    to {
      transform: translateX(550%);
    }
  }

  .rw__phase {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 520ms ease,
      transform 820ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 520ms ease;
  }

  .rw__phase.is-active {
    opacity: 1;
    visibility: visible;
  }

  .rw__phase--left {
