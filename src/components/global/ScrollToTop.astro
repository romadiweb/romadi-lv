<div class="scroll-to-top" data-scroll-top data-visible="false">
  <span class="scroll-to-top__label" aria-hidden="true">UZ AUGŠU</span>

  <button type="button" aria-label="Atgriezties lapas augšā" title="Atgriezties lapas augšā">
    <svg class="scroll-to-top__progress" viewBox="0 0 66 66" aria-hidden="true">
      <circle class="scroll-to-top__track" cx="33" cy="33" r="29" pathLength="100"></circle>
      <circle class="scroll-to-top__value" cx="33" cy="33" r="29" pathLength="100"></circle>
    </svg>

    <img
      src="/images/ui/scroll-to-top-arrow.png"
      alt=""
      width="256"
      height="256"
      decoding="async"
    />
  </button>
</div>

<script>
  interface ScrollTopWindow extends Window {
    __romadiScrollTopController?: AbortController;
  }

  const initScrollToTop = (): void => {
    const root = document.querySelector<HTMLElement>('[data-scroll-top]');
    const button = root?.querySelector<HTMLButtonElement>('button');

    if (!root || !button) return;

    const scrollWindow = window as ScrollTopWindow;
    scrollWindow.__romadiScrollTopController?.abort();

    const controller = new AbortController();
    const { signal } = controller;
    scrollWindow.__romadiScrollTopController = controller;

    let frame = 0;

    const update = (): void => {
      frame = 0;

      const scrollRange = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const progress = Math.min(100, Math.max(0, (window.scrollY / scrollRange) * 100));
      const revealPoint = Math.min(680, window.innerHeight * 0.72);
      const isVisible = window.scrollY > revealPoint;

      root.style.setProperty('--scroll-progress', progress.toFixed(2));
      root.style.pointerEvents = isVisible ? 'auto' : 'none';
      root.dataset.visible = String(isVisible);
    };

    const requestUpdate = (): void => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    button.addEventListener(
      'click',
      () => {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
      },
      { signal },
    );

    window.addEventListener('scroll', requestUpdate, { passive: true, signal });
    window.addEventListener('resize', requestUpdate, { passive: true, signal });
    update();
  };

  initScrollToTop();
  document.addEventListener('astro:page-load', initScrollToTop);
</script>

<style>
  .scroll-to-top {
    --scroll-progress: 0;

    position: fixed;
    z-index: 45;
    right: clamp(1rem, 2.2vw, 2.25rem);
    bottom: clamp(1rem, 2.2vw, 2.25rem);
    display: flex;
    align-items: center;
    gap: 0.85rem;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, 1rem, 0) scale(0.92);
    visibility: hidden;
    transition:
      opacity 220ms ease,
      transform 420ms var(--ease-out-expo),
      visibility 0s linear 420ms;
  }

  .scroll-to-top[data-visible='true'] {
    opacity: 1;
    pointer-events: auto;
    transform: translate3d(0, 0, 0) scale(1);
    visibility: visible;
    transition-delay: 0s;
  }

  .scroll-to-top__label {
    color: rgb(255 255 255 / 58%);
    font: 600 0.62rem/1 var(--font-mono);
    letter-spacing: 0.04em;
    opacity: 0;
    transform: translateX(0.5rem);
    transition:
      color 180ms ease,
      opacity 180ms ease,
      transform 320ms var(--ease-out-expo);
  }

  .scroll-to-top button {
    position: relative;
    display: grid;
    width: 4.125rem;
    height: 4.125rem;
    flex: 0 0 auto;
    overflow: hidden;
    border: 0;
    border-radius: 50%;
    place-items: center;
    background:
      radial-gradient(circle at 50% 112%, rgb(98 11 34 / 58%), transparent 64%), rgb(9 9 9 / 92%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 9%);
    color: white;
    cursor: pointer;
    pointer-events: auto;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .scroll-to-top__progress {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: rotate(-90deg);
  }

  .scroll-to-top__track,
  .scroll-to-top__value {
    fill: none;
    stroke-width: 1.15;
  }

  .scroll-to-top__track {
    stroke: rgb(255 255 255 / 13%);
  }

  .scroll-to-top__value {
    stroke: #e0234e;
    stroke-dasharray: 100;
    stroke-dashoffset: calc(100 - var(--scroll-progress));
    stroke-linecap: round;
    transition: stroke 180ms ease;
  }

  .scroll-to-top img {
    position: relative;
    z-index: 1;
    width: 3rem;
    height: 3rem;
    object-fit: contain;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 42%));
    transition:
      filter 220ms ease,
      transform 360ms var(--ease-out-expo);
  }

  .scroll-to-top:hover .scroll-to-top__label,
  .scroll-to-top:focus-within .scroll-to-top__label {
    color: white;
    opacity: 1;
    transform: translateX(0);
  }

  .scroll-to-top button:hover img,
  .scroll-to-top button:focus-visible img {
    filter: drop-shadow(0 3px 4px rgb(224 35 78 / 28%));
    transform: translateY(-0.2rem);
  }

  .scroll-to-top button:hover .scroll-to-top__value,
  .scroll-to-top button:focus-visible .scroll-to-top__value {
    stroke: #f75f7f;
  }

  .scroll-to-top button:focus-visible {
    outline: 3px solid rgb(247 95 127 / 52%);
    outline-offset: 4px;
  }

  .scroll-to-top button:active img {
    transform: translateY(0) scale(0.94);
  }

  @media (max-width: 700px) {
    .scroll-to-top {
      right: 0.875rem;
      bottom: 0.875rem;
    }

    .scroll-to-top__label {
      display: none;
    }

    .scroll-to-top button {
      width: 3.5rem;
      height: 3.5rem;
    }

    .scroll-to-top img {
      width: 2.55rem;
      height: 2.55rem;
    }

    .scroll-to-top__progress {
      transform: rotate(-90deg) scale(0.84);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-to-top,
    .scroll-to-top__label,
    .scroll-to-top img {
      transition: none;
    }
  }
</style>
