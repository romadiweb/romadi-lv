---
import { SITE } from '@/config/site';

const currentYear = new Date().getFullYear();
const serviceLinks = SITE.services.slice(0, 4);
---

<footer class="site-footer">
  <div class="site-footer__atmosphere" aria-hidden="true">
    <i class="site-footer__glow site-footer__glow--left"></i>
    <i class="site-footer__glow site-footer__glow--right"></i>
    <svg viewBox="0 0 100 100" preserveAspectRatio="none">
      <filter id="footer-noise">
        <feTurbulence type="fractalNoise" baseFrequency="0.82" numOctaves="4" stitchTiles="stitch" />
      </filter>
      <rect width="100" height="100" filter="url(#footer-noise)" opacity="0.34"></rect>
    </svg>
  </div>

  <div class="site-footer__panel">
    <section class="site-footer__contact" aria-labelledby="footer-contact-title">
      <div class="site-footer__waves" aria-hidden="true">
        <svg viewBox="0 0 520 620" fill="none" preserveAspectRatio="xMidYMid slice">
          {
            Array.from({ length: 18 }, (_, index) => (
              <path
                d={`M-80 ${170 + index * 13} C 80 ${100 + index * 5}, 116 ${292 - index * 2}, 264 ${294 + index * 2} S 405 ${180 + index * 12}, 590 ${220 + index * 17}`}
                style={`--line-index:${index};`}
              />
            ))
          }
          {
            Array.from({ length: 12 }, (_, index) => (
              <path
                d={`M-60 ${565 + index * 12} C 105 ${440 + index * 3}, 182 ${385 + index * 5}, 330 ${430 + index * 8} S 470 ${575 + index * 8}, 610 ${530 + index * 12}`}
                style={`--line-index:${index + 6};`}
              />
            ))
          }
        </svg>
      </div>

      <div class="site-footer__contact-copy">
        <h2 id="footer-contact-title">Vēlaties sazināties?</h2>
        <p class="site-footer__intro">
          Pastāstiet par savu ideju, ieceri vai jautājumu. Atbildēsim un palīdzēsim atrast labāko
          nākamo soli.
        </p>
        <a class="site-footer__contact-link" href={`mailto:${SITE.contact.email}`}>
          <span>{SITE.contact.email}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M7 17L17 7M9 7H17V15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </section>

    <div class="site-footer__main">
      <div class="site-footer__columns">
        <nav aria-label="Uzņēmums">
          <p>UZŅĒMUMS</p>
          {SITE.footer.companyLinks.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="/">Sākums</a>
        </nav>

        <nav aria-label="Pakalpojumi">
          <p>PAKALPOJUMI</p>
          {serviceLinks.map((item) => <a href={item.href}>{item.shortLabel}</a>)}
        </nav>

        <nav aria-label="Kontakti">
          <p>SAZINĀTIES</p>
          <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>
          {SITE.contact.phones.map((phone) => <a href={phone.href}>{phone.display}</a>)}
          <span>{SITE.contact.location.city}, {SITE.contact.location.country}</span>
        </nav>

        <nav aria-label="Sociālie tīkli">
          <p>SOCIĀLIE TĪKLI</p>
          <span>Instagram</span>
          <span>Facebook</span>
          <span>LinkedIn</span>
          <span>TikTok</span>
        </nav>
      </div>

      <div class="site-footer__bottom">
        <p>© {currentYear} ROMADI. VISAS TIESĪBAS AIZSARGĀTAS.</p>
        <p>DIGITĀLI RISINĀJUMI UZŅĒMUMA IZAUGSMEI.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(8rem, 15vw, 15rem) 0 2rem;
    background: #050203;
  }

  .site-footer__atmosphere {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    background:
      linear-gradient(to bottom, #050203 0%, rgb(5 2 3 / 96%) 16%, transparent 48%),
      radial-gradient(ellipse at 45% 115%, rgb(132 3 40 / 88%), transparent 52%),
      radial-gradient(ellipse at -5% 70%, rgb(148 6 46 / 76%), transparent 38%),
      radial-gradient(ellipse at 105% 66%, rgb(103 2 32 / 72%), transparent 40%),
      linear-gradient(116deg, #370410, #090104 44%, #130106 70%, #2b020d);
  }

  .site-footer__atmosphere::after {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 52%, transparent 12%, rgb(0 0 0 / 52%) 100%);
    content: '';
  }

  .site-footer__atmosphere > svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.2;
    mix-blend-mode: soft-light;
  }

  .site-footer__glow {
    position: absolute;
    width: 45rem;
    height: 38rem;
    border-radius: 48% 52% 62% 38%;
    background: radial-gradient(circle, rgb(238 42 89 / 58%), rgb(145 3 43 / 42%) 46%, transparent 72%);
    filter: blur(38px) contrast(1.25);
    opacity: 0.72;
    animation: footer-ambient 9s ease-in-out infinite alternate;
  }

  .site-footer__glow--left { bottom: -23rem; left: -11rem; }
  .site-footer__glow--right { right: -14rem; bottom: -19rem; animation-delay: -4s; }

  .site-footer__panel {
    display: grid;
    grid-template-columns: minmax(20rem, 31%) minmax(0, 1fr);
    min-height: 29rem;
    margin-inline: 2rem;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 8%);
    border-radius: 2rem;
    background-color: #111;
    background-image: radial-gradient(circle, rgb(255 255 255 / 12%) 0 0.55px, transparent 0.75px);
    background-size: 4px 4px;
    box-shadow: 0 2.5rem 7rem rgb(0 0 0 / 44%);
  }

  .site-footer__contact {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-right: 1px solid rgb(255 255 255 / 8%);
    background: linear-gradient(145deg, rgb(255 255 255 / 2%), transparent 60%);
  }

  .site-footer__waves { position: absolute; z-index: -1; inset: 0; opacity: 0.45; }
  .site-footer__waves::after { position: absolute; inset: 0; background: radial-gradient(circle at 48% 47%, transparent, #111 76%); content: ''; }
  .site-footer__waves svg { width: 100%; height: 100%; }
  .site-footer__waves path { stroke: rgb(255 255 255 / 25%); stroke-width: 1; vector-effect: non-scaling-stroke; animation: footer-wave 5.5s ease-in-out infinite alternate; animation-delay: calc(var(--line-index) * -0.16s); }

  .site-footer__contact-copy {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 29rem;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    padding: clamp(3.25rem, 4vw, 4.75rem) clamp(2rem, 4vw, 5rem) 2rem;
  }

  .site-footer__columns nav > p { color: rgb(255 255 255 / 38%); font: 600 0.64rem/1.2 var(--font-mono); letter-spacing: 0.08em; }
  .site-footer__contact h2 { max-width: 26rem; font-size: clamp(1.15rem, 1.55vw, 1.45rem); font-weight: 620; letter-spacing: -0.035em; line-height: 1.2; }
  .site-footer__intro { max-width: 24rem; margin-top: 1.25rem; color: rgb(255 255 255 / 54%); font: 500 clamp(0.72rem, 0.85vw, 0.86rem)/1.7 var(--font-mono); }
  .site-footer__contact-link { display: flex; width: min(100%, 26rem); min-height: 3.8rem; margin-top: 2rem; align-items: center; justify-content: space-between; border: 1px solid rgb(255 255 255 / 13%); border-radius: 1rem; padding: 0.7rem 0.8rem 0.7rem 1.2rem; background: rgb(255 255 255 / 6%); color: white; font-size: clamp(0.78rem, 0.9vw, 0.9rem); font-weight: 650; transition: border-color 220ms ease, background-color 220ms ease, transform 250ms var(--ease-out-expo); }
  .site-footer__contact-link svg { box-sizing: content-box; border-radius: 0.7rem; padding: 0.65rem; background: rgb(255 255 255 / 10%); }
  .site-footer__contact-link:hover { border-color: rgb(255 255 255 / 24%); background: rgb(255 255 255 / 10%); transform: translateY(-2px); }

  .site-footer__main { display: grid; min-width: 0; grid-template-rows: 1fr auto; padding: clamp(3.25rem, 4vw, 4.75rem) clamp(2rem, 4vw, 5rem) 2rem; }
  .site-footer__columns { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 4rem); align-content: start; }
  .site-footer__columns nav { display: flex; flex-direction: column; align-items: flex-start; gap: 0.95rem; }
  .site-footer__columns nav > p { margin-bottom: 1rem; }
  .site-footer__columns a,
  .site-footer__columns span { color: rgb(255 255 255 / 78%); font-size: clamp(0.78rem, 0.9vw, 0.9rem); font-weight: 650; transition: color 180ms ease, transform 220ms var(--ease-out-expo); }
  .site-footer__columns a:hover { color: white; transform: translateX(3px); }

  .site-footer__bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; border-top: 1px solid rgb(255 255 255 / 7%); padding-top: 1.5rem; color: rgb(255 255 255 / 34%); font: 550 clamp(0.55rem, 0.7vw, 0.68rem)/1.5 var(--font-mono); }

  @keyframes footer-wave { from { transform: translate3d(-1.5%, -0.7%, 0) scaleX(1.01); } to { transform: translate3d(1.8%, 1.1%, 0) scaleX(0.98); } }
  @keyframes footer-ambient { from { transform: translate3d(-4%, 2%, 0) scale(0.94); } to { transform: translate3d(5%, -4%, 0) scale(1.08); } }

  @media (max-width: 960px) {
    .site-footer__panel { grid-template-columns: 1fr; margin-inline: 0.75rem; border-radius: 1.5rem; }
    .site-footer__contact { border-right: 0; border-bottom: 1px solid rgb(255 255 255 / 8%); }
    .site-footer__contact-copy { min-height: 29rem; }
    .site-footer__waves { width: 70%; right: 0; left: auto; }
    .site-footer__main { min-height: 31rem; }
    .site-footer__columns { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 650px) {
    .site-footer { padding-top: 7rem; padding-bottom: 0.75rem; }
    .site-footer__contact-copy { min-height: 31rem; justify-content: flex-end; padding: 2rem 1.5rem 3rem; }
    .site-footer__waves { width: 100%; opacity: 0.34; }
    .site-footer__main { min-height: 0; padding: 3rem 1.5rem 1.5rem; }
    .site-footer__columns { grid-template-columns: 1fr 1fr; gap: 2.5rem 1.5rem; }
    .site-footer__bottom { margin-top: 3.5rem; flex-direction: column; align-items: flex-start; gap: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__waves path,
    .site-footer__glow { animation: none; }
  }
</style>
