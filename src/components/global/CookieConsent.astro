      bottom: 4.75rem;
      left: 0.5rem;
      width: min(calc(100% - 1rem), 20rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-consent,
    .cookie-consent__button {
      transition: none;
    }
  }
</style>
