<aside
  class="cookie-consent"
  data-cookie-consent
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-description"
  hidden
>
  <div class="cookie-consent__copy">
    <h2 id="cookie-consent-title">Sīkdatņu izvēle</h2>
    <p id="cookie-consent-description">
      Mēs izmantojam sīkdatnes, lai nodrošinātu vietnes darbību un anonīmi analizētu apmeklējumu.
      <a href="/sikdatnu-politika">Uzzināt vairāk</a>
    </p>
  </div>

  <div class="cookie-consent__actions">
    <button
      type="button"
      class="cookie-consent__button cookie-consent__button--secondary"
      data-consent-deny
    >
      Noraidīt
    </button>
    <button
      type="button"
      class="cookie-consent__button cookie-consent__button--primary"
      data-consent-accept
    >
      Piekrist
    </button>
  </div>
</aside>

<script>
  type ConsentChoice = 'granted' | 'denied' | null;
  interface ConsentApi {
    getChoice: () => ConsentChoice;
    setAnalytics: (granted: boolean) => void;
  }

  const getConsentApi = (): ConsentApi | undefined =>
    (window as typeof window & { romadiConsent?: ConsentApi }).romadiConsent;

  const initCookieConsent = (): void => {
    const banner = document.querySelector<HTMLElement>('[data-cookie-consent]');
    if (!banner || banner.dataset.initialized === 'true') return;
    banner.dataset.initialized = 'true';

    const acceptButton = banner.querySelector<HTMLButtonElement>('[data-consent-accept]');
    const denyButton = banner.querySelector<HTMLButtonElement>('[data-consent-deny]');
    let hideTimer = 0;

    const showBanner = (moveFocus = false): void => {
      window.clearTimeout(hideTimer);
      banner.hidden = false;
      window.requestAnimationFrame(() => {
        banner.dataset.visible = 'true';
        if (moveFocus) denyButton?.focus();
      });
    };

    const hideBanner = (): void => {
      banner.dataset.visible = 'false';
      hideTimer = window.setTimeout(() => {
        banner.hidden = true;
      }, 280);
    };

    acceptButton?.addEventListener('click', () => {
      getConsentApi()?.setAnalytics(true);
      hideBanner();
    });

    denyButton?.addEventListener('click', () => {
      getConsentApi()?.setAnalytics(false);
      hideBanner();
    });

    document.querySelectorAll<HTMLButtonElement>('[data-consent-settings]').forEach((button) => {
      if (button.dataset.consentInitialized === 'true') return;
      button.dataset.consentInitialized = 'true';
      button.addEventListener('click', () => showBanner(true));
    });

    if (!getConsentApi()?.getChoice()) showBanner();
  };

  initCookieConsent();
  document.addEventListener('astro:page-load', initCookieConsent);
</script>

<style>
  .cookie-consent {
    position: fixed;
    z-index: 90;
    right: clamp(1rem, 3vw, 2.5rem);
    bottom: clamp(1rem, 2vw, 1.5rem);
    left: clamp(1rem, 3vw, 2.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    width: min(calc(100% - clamp(2rem, 6vw, 5rem)), 70rem);
    margin-inline: auto;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 3rem);
    border: 1px solid rgb(255 255 255 / 13%);
    border-radius: 1rem;
    padding: 1rem;
    padding-left: clamp(1rem, 2.2vw, 1.75rem);
    background: rgb(7 5 6 / 94%);
    box-shadow: 0 1.5rem 5rem rgb(0 0 0 / 42%);
    -webkit-backdrop-filter: blur(18px) saturate(115%);
    backdrop-filter: blur(18px) saturate(115%);
    opacity: 0;
    transform: translate3d(0, 0.75rem, 0) scale(0.99);
    transition:
      opacity 240ms ease,
      transform 320ms var(--ease-out-expo);
  }

  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent[data-visible='true'] {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  .cookie-consent__copy {
    max-width: 48rem;
  }

  .cookie-consent h2 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .cookie-consent__copy > p:last-child {
    max-width: 68ch;
    color: rgb(255 255 255 / 72%);
    font-size: clamp(0.78rem, 1.2vw, 0.88rem);
    font-weight: 500;
    line-height: 1.5;
  }

  .cookie-consent__copy a {
    margin-left: 0.25rem;
    color: #f75f7f;
    font-weight: 700;
    text-decoration-line: none;
    text-underline-offset: 0.2em;
  }

  .cookie-consent__copy a:hover {
    text-decoration-line: underline;
  }

  .cookie-consent__actions {
    display: flex;
    gap: 0.65rem;
  }

  .cookie-consent__button {
    min-height: 2.75rem;
    border-radius: 999px;
    padding: 0.65rem 1.15rem;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 220ms var(--ease-out-expo);
  }

  .cookie-consent__button:hover {
    transform: translateY(-2px);
  }

  .cookie-consent__button--secondary {
    border: 1px solid rgb(255 255 255 / 24%);
    background: transparent;
    color: white;
  }

  .cookie-consent__button--secondary:hover {
    border-color: rgb(255 255 255 / 48%);
    background: rgb(255 255 255 / 6%);
  }

  .cookie-consent__button--primary {
    border: 1px solid var(--accent);
    background: var(--accent);
    color: white;
  }

  .cookie-consent__button--primary:hover {
    border-color: #f75f7f;
    background: #f75f7f;
  }

  @media (max-width: 760px) {
    .cookie-consent {
      right: auto;
      bottom: 5.25rem;
      left: 0.75rem;
      grid-template-columns: 1fr;
      width: min(calc(100% - 1.5rem), 20rem);
      gap: 1rem;
      margin: 0;
      padding: 1rem;
    }

    .cookie-consent__copy > p:last-child {
      font-size: 0.78rem;
    }

    .cookie-consent__copy a {
      display: inline-block;
    }

    .cookie-consent__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 360px) {
