---
import { SITE } from '@/config/site';

const currentPath = Astro.url.pathname;

const menuServices = [
  {
    title: 'Mājaslapu izstrāde',
    description: 'Ātras, pārdomātas un viegli uzturamas mājaslapas.',
    href: '/majas-lapu-izstrade',
  },
  {
    title: 'Interneta veikali',
    description: 'E-komercijas risinājumi ar skaidru un ērtu pirkšanas plūsmu.',
    href: '/interneta-veikalu-izstrade',
  },
  {
    title: 'Digitālie produkti un sistēmas',
    description: 'Portāli, klientu zonas, rezervācijas un iekšējie rīki.',
    href: '/kontakti',
  },
  {
    title: 'Zīmols un dizains',
    description: 'Vizuālā identitāte, interfeisi un komunikācijas materiāli.',
    href: '/ui-ux-dizains',
  },
  {
    title: 'AI un automatizācija',
    description: 'Praktiski AI palīgi, darbplūsmas un integrācijas.',
    href: '/kontakti',
  },
  {
    title: 'Izaugsme un atbalsts',
    description: 'Analītika, SEO, pārbūve un ilgtermiņa tehniskais atbalsts.',
    href: '/kontakti',
  },
];

function isCurrentPage(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }

  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__bar">
    <a href="/" class="site-header__logo" aria-label="ROMADI sākumlapa" data-astro-prefetch>
      <span class="site-header__logo-mark" aria-hidden="true"> R </span>

      <span class="site-header__wordmark"> ROMADI </span>
    </a>

    <nav class="site-header__navigation" aria-label="Galvenā navigācija">
      {
        SITE.navigation.primary.map((item) =>
          item.label === 'Pakalpojumi' ? (
            <div class="site-header__services-menu">
              <a
                href={item.href}
                class="site-header__navigation-link site-header__services-trigger"
                data-current={isCurrentPage(item.href) ? 'true' : undefined}
                aria-current={isCurrentPage(item.href) ? 'page' : undefined}
                aria-haspopup="true"
                data-astro-prefetch
              >
                {item.label}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 10L12 15L17 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>

              <div class="site-header__mega" aria-label="Pakalpojumu izvēlne">
                <div class="site-header__mega-surface">
                  <div class="site-header__mega-heading">
                    <p>ROMADI PAKALPOJUMI</p>
                  </div>

                  <div class="site-header__mega-grid">
                    {
                      menuServices.map((service, index) => (
                        <a class="site-header__mega-card" href={service.href} data-astro-prefetch>
                          <span class="site-header__mega-visual" style={`--service-index:${index};`} aria-hidden="true">
                            <i></i><i></i><b>0{index + 1}</b>
                          </span>
                          <span class="site-header__mega-copy">
                            <strong>{service.title}</strong>
                            <small>{service.description}</small>
                          </span>
                        </a>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="site-header__navigation-link"
              data-current={isCurrentPage(item.href) ? 'true' : undefined}
              aria-current={isCurrentPage(item.href) ? 'page' : undefined}
              data-astro-prefetch
            >
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="site-header__actions">
      <a
        href={SITE.navigation.callToAction.href}
        class="site-header__project-link"
        data-astro-prefetch
      >
        {SITE.navigation.callToAction.label}

        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M7 17L17 7M9 7H17V15"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>

      <details class="site-header__mobile-menu">
        <summary aria-label="Atvērt navigācijas izvēlni" aria-expanded="false">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M3.5 6.5H20.5M3.5 12H20.5M3.5 17.5H20.5"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"></path>
          </svg>
        </summary>

        <button class="site-header__mobile-backdrop" type="button" aria-label="Aizvērt navigācijas izvēlni"></button>

        <div class="site-header__mobile-panel">
          <nav aria-label="Mobilā navigācija" class="site-header__mobile-navigation">
            <div class="site-header__mobile-services">
              <a class="site-header__mobile-main-link" href="/pakalpojumi" style="--mobile-index:0" data-mobile-item>
                <span>Pakalpojumi</span><small>01</small>
              </a>
              <div class="site-header__mobile-service-links">
                {
                  menuServices.map((service, index) => (
                    <a href={service.href} style={`--mobile-index:${index + 1}`} data-mobile-item data-astro-prefetch>
                      <span>{service.title}</span><small>1.{index + 1}</small>
                    </a>
                  ))
                }
              </div>
            </div>

            <a class="site-header__mobile-main-link" href="/portfolio" style="--mobile-index:7" data-mobile-item data-astro-prefetch>
              <span>Portfolio</span><small>02</small>
            </a>
            <a class="site-header__mobile-main-link" href="/par-mums" style="--mobile-index:8" data-mobile-item data-astro-prefetch>
              <span>Par mums</span><small>03</small>
            </a>
            <a class="site-header__mobile-main-link" href="/kontakti" style="--mobile-index:9" data-mobile-item data-astro-prefetch>
              <span>Kontakti</span><small>04</small>
            </a>
          </nav>

          <div class="site-header__mobile-footer" style="--mobile-index:10" data-mobile-item>
            <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>
            <span>ROMADI · LIEPĀJA</span>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const initDesktopMegaMenus = (): void => {
    document.querySelectorAll<HTMLElement>('.site-header__services-menu').forEach((menu) => {
      if (menu.dataset.megaInitialized === 'true') return;
      menu.dataset.megaInitialized = 'true';

      const panel = menu.querySelector<HTMLElement>('.site-header__mega');
      let closeTimer = 0;

      if (!panel) return;

      const openMenu = (): void => {
        window.clearTimeout(closeTimer);
        menu.dataset.open = 'true';
      };

      const scheduleClose = (): void => {
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(() => {
          if (!menu.contains(document.activeElement) && !panel.matches(':hover')) {
            menu.dataset.open = 'false';
          }
        }, 140);
      };

      menu.addEventListener('pointerenter', openMenu);
      menu.addEventListener('pointerleave', scheduleClose);
      panel.addEventListener('pointerenter', openMenu);
      panel.addEventListener('pointerleave', scheduleClose);
      menu.addEventListener('focusin', openMenu);
      menu.addEventListener('focusout', scheduleClose);
    });
  };

  initDesktopMegaMenus();
  document.addEventListener('astro:page-load', initDesktopMegaMenus);

  const initMobileMenus = (): void => {
    document.querySelectorAll<HTMLDetailsElement>('.site-header__mobile-menu').forEach((menu) => {
      if (menu.dataset.mobileInitialized === 'true') return;
      menu.dataset.mobileInitialized = 'true';

      const summary = menu.querySelector<HTMLElement>('summary');
      const backdrop = menu.querySelector<HTMLButtonElement>('.site-header__mobile-backdrop');
      const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>('.site-header__mobile-panel a'));
      let closeTimer = 0;

      if (!summary || !backdrop) return;

      const openMenu = (): void => {
        window.clearTimeout(closeTimer);
        menu.open = true;
        document.body.dataset.mobileMenuOpen = 'true';
        window.requestAnimationFrame(() => {
          menu.dataset.mobileOpen = 'true';
          summary.setAttribute('aria-expanded', 'true');
        });
      };

      const closeMenu = (): void => {
        window.clearTimeout(closeTimer);
        menu.dataset.mobileOpen = 'false';
        summary.setAttribute('aria-expanded', 'false');
        delete document.body.dataset.mobileMenuOpen;
        closeTimer = window.setTimeout(() => {
          menu.open = false;
        }, 560);
      };

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        if (menu.dataset.mobileOpen === 'true') closeMenu();
        else openMenu();
      });

      backdrop.addEventListener('click', closeMenu);
      links.forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu.dataset.mobileOpen === 'true') closeMenu();
      });
    });
  };

  initMobileMenus();
  document.addEventListener('astro:page-load', initMobileMenus);
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    left: 0;

    width: 100%;
    margin-top: 3.4rem;
    margin-bottom: calc(-5rem - 3.4rem);
    padding-inline: clamp(1rem, 4vw, 4rem);

    pointer-events: none;
  }

  .site-header__bar {
    position: relative;
    isolation: isolate;

    overflow: visible;
    display: grid;
    grid-template-columns: 1fr auto 1fr;

    width: min(100%, 76rem);
    min-height: 5rem;
    margin-inline: auto;
    padding: 0.65rem 0.8rem 0.65rem 1.25rem;

    align-items: center;

    border: 0;
    border-radius: 2rem;

    background: transparent;

    box-shadow: 0 22px 60px rgb(0 0 0 / 24%);

    pointer-events: auto;
  }

  /*
   * Very subtle highlight around the top edge.
   * This is not a visible border.
   */

  .site-header__bar::before {
    position: absolute;
    z-index: 0;
    inset: 0;

    border-radius: inherit;

    /*
     * The dark layer is intentionally semi-transparent so the hero remains
     * visible through the header. The backdrop filter then blurs that content.
     */
    background:
      radial-gradient(circle at 0% 50%, rgb(224 35 78 / 13%), transparent 34%),
      radial-gradient(circle at 72% 0%, rgb(255 255 255 / 5%), transparent 32%),
      linear-gradient(100deg, rgb(27 4 10 / 88%) 0%, rgb(8 4 6 / 74%) 48%, rgb(15 3 7 / 86%) 100%);

    -webkit-backdrop-filter: blur(28px) saturate(115%);
    backdrop-filter: blur(12px) saturate(115%);

    content: '';
    pointer-events: none;
  }

  .site-header__logo {
    position: relative;
    z-index: 1;

    display: inline-flex;
    justify-self: start;

    align-items: center;
    gap: 0.75rem;
  }

  .site-header__logo-mark {
    display: grid;

    width: 2.65rem;
    height: 2.65rem;

    place-items: center;

    border-radius: 50%;

    background: radial-gradient(
      circle at 35% 28%,
      var(--color-signal-400),
      var(--color-signal-600) 68%,
      var(--color-signal-800)
    );

    box-shadow: 0 0 22px rgb(224 35 78 / 26%);

    color: white;

    font-size: 0.95rem;
    font-weight: 800;
  }

  .site-header__wordmark {
    color: white;

    font-size: 0.95rem;
    font-weight: 750;
    letter-spacing: -0.035em;
  }

  .site-header__navigation {
    position: relative;
    z-index: 1;

    display: flex;

    align-items: center;
    justify-content: center;
    gap: clamp(1.75rem, 3vw, 3rem);
  }

  .site-header__navigation-link {
    padding-block: 1rem;

    color: rgb(255 255 255 / 84%);

    font-size: 0.9rem;
    font-weight: 650;
    letter-spacing: -0.015em;

    transition:
      color 180ms ease,
      filter 220ms ease,
      transform 220ms var(--ease-out-expo);
  }

  /*
 * Keep all links equally bright.
 * Only introduce a small blur.
 */
  .site-header__navigation:hover .site-header__navigation-link {
    opacity: 1;
    color: rgb(255 255 255 / 84%);
    filter: blur(1.35px);
  }

  /*
 * The item under the pointer remains completely sharp.
 */
  .site-header__navigation .site-header__navigation-link:hover {
    opacity: 1;
    color: white;
    filter: blur(0);
    transform: translateY(-1px);
  }

  /*
 * Restore everything when the pointer leaves the nav.
 */
  .site-header__navigation:not(:hover) .site-header__navigation-link {
    opacity: 1;
    filter: blur(0);
  }

  .site-header__navigation-link[data-current='true'] {
    color: white;
  }

  .site-header__services-menu {
    position: relative;
  }

  .site-header__services-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .site-header__services-trigger svg {
    opacity: 0.62;
    transition: transform 260ms var(--ease-out-expo), opacity 180ms ease;
  }

  .site-header__services-menu:hover .site-header__services-trigger svg,
  .site-header__services-menu:focus-within .site-header__services-trigger svg {
    opacity: 1;
    transform: rotate(180deg);
  }

  .site-header__mega {
    position: absolute;
    z-index: 20;
    top: 100%;
    left: clamp(9rem, 15.625vw, 12.5rem);
    width: min(70rem, calc(100vw - 4rem));
    padding-top: 1.15rem;
    pointer-events: none;
    transform: translateX(-50%);
    visibility: hidden;
  }

  .site-header__mega-surface {
    padding: 1.15rem;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 1.4rem;
    background:
      radial-gradient(circle at 48% -12%, rgb(244 48 94 / 34%), transparent 45%),
      radial-gradient(circle at 0% 70%, rgb(153 8 48 / 24%), transparent 38%),
      linear-gradient(135deg, rgb(69 12 30 / 94%), rgb(37 7 17 / 96%) 55%, rgb(25 8 13 / 97%));
    box-shadow: 0 2.4rem 6rem rgb(0 0 0 / 50%), inset 0 1px rgb(255 255 255 / 8%);
    opacity: 0;
    transform: translateY(1rem) scale(0.985);
    transform-origin: top center;
    transition:
      opacity 420ms ease,
      transform 520ms var(--ease-out-expo),
      visibility 0s linear 180ms;
    -webkit-backdrop-filter: blur(30px) saturate(130%);
    backdrop-filter: blur(30px) saturate(130%);
  }

  .site-header__services-menu:hover .site-header__mega,
  .site-header__services-menu:focus-within .site-header__mega,
  .site-header__services-menu[data-open='true'] .site-header__mega {
    pointer-events: auto;
    visibility: visible;
  }

  .site-header__services-menu:hover .site-header__mega-surface,
  .site-header__services-menu:focus-within .site-header__mega-surface,
  .site-header__services-menu[data-open='true'] .site-header__mega-surface {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition-delay: 0s;
  }

  .site-header__mega-heading {
    display: flex;
    min-height: 2.6rem;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.35rem 0.8rem;
    color: rgb(255 255 255 / 42%);
    font: 600 0.62rem/1 var(--font-mono);
    letter-spacing: 0.08em;
  }

  .site-header__mega-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .site-header__mega-card {
    display: grid;
    min-width: 0;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    border: 1px solid rgb(255 255 255 / 7%);
    border-radius: 0.95rem;
    padding: 0.65rem;
    background: rgb(255 255 255 / 3%);
    transition: border-color 220ms ease, background-color 220ms ease, transform 300ms var(--ease-out-expo);
  }

  .site-header__mega-card:hover,
  .site-header__mega-card:focus-visible {
    border-color: rgb(255 255 255 / 17%);
    background: rgb(255 255 255 / 7%);
    transform: translateY(-2px);
  }

  .site-header__mega-visual {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: block;
    aspect-ratio: 1.35;
    border-radius: 0.65rem;
    background:
      radial-gradient(circle at 28% 28%, rgb(255 120 151 / 68%), transparent 28%),
      linear-gradient(145deg, #a80d35, #260711 58%, #0c0809);
  }

  .site-header__mega-visual::after {
    position: absolute;
    inset: 0;
    opacity: 0.14;
    background-image: linear-gradient(rgb(255 255 255 / 15%) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 15%) 1px, transparent 1px);
    background-size: 1rem 1rem;
    content: '';
  }

  .site-header__mega-visual i { position: absolute; z-index: 1; border: 1px solid rgb(255 255 255 / 22%); border-radius: 50%; }
  .site-header__mega-visual i:first-child { top: 15%; right: -8%; width: 60%; aspect-ratio: 1; }
  .site-header__mega-visual i:nth-child(2) { bottom: -22%; left: 12%; width: 48%; aspect-ratio: 1; background: rgb(224 35 78 / 24%); }
  .site-header__mega-visual b { position: absolute; z-index: 2; right: 0.55rem; bottom: 0.45rem; color: rgb(255 255 255 / 64%); font: 600 0.5rem/1 var(--font-mono); }

  .site-header__mega-copy { display: grid; min-width: 0; align-content: center; gap: 0.4rem; }
  .site-header__mega-copy strong { color: white; font-size: 0.88rem; font-weight: 650; letter-spacing: -0.025em; }
  .site-header__mega-copy small { display: -webkit-box; overflow: hidden; color: rgb(255 255 255 / 46%); font: 500 0.61rem/1.45 var(--font-mono); -webkit-box-orient: vertical; -webkit-line-clamp: 2; }

  /*
   * Keep all links sharp when the mouse is not inside the nav.
   */
  .site-header__navigation:not(:hover) .site-header__navigation-link {
    opacity: 1;
    filter: none;
  }

  .site-header__actions {
    position: relative;
    z-index: 1;

    display: flex;
    justify-self: end;

    align-items: center;
    gap: 0.55rem;
  }

  .site-header__project-link {
    display: inline-flex;
    min-height: 3.2rem;

    align-items: center;
    justify-content: center;
    gap: 0.55rem;

    border: 0;
    border-radius: 0.85rem;

    padding-inline: 1.2rem;

    background: rgb(255 255 255 / 8%);

    box-shadow: inset 0 1px 0 rgb(255 255 255 / 5%);

    color: white;

    font-size: 0.86rem;
    font-weight: 700;

    transition:
      background-color 200ms ease,
      box-shadow 200ms ease,
      color 200ms ease,
      transform 250ms var(--ease-out-expo);
  }

  .site-header__project-link:hover {
    background: var(--accent);

    box-shadow:
      0 10px 32px rgb(224 35 78 / 22%),
      inset 0 1px 0 rgb(255 255 255 / 16%);

    color: white;
    transform: translateY(-1px);
  }

  .site-header__project-link svg {
    transition: transform 250ms var(--ease-out-expo);
  }

  .site-header__project-link:hover svg {
    transform: translate(2px, -2px);
  }

  .site-header__mobile-menu {
    position: relative;
    display: none;
  }

  :global(body[data-mobile-menu-open='true']) {
    overflow: hidden;
  }

  .site-header__mobile-menu summary {
    position: relative;
    z-index: 103;
    display: grid;

    width: 3.75rem;
    height: 3.75rem;

    place-items: center;

    border: 0;
    border-radius: 0;

    background: transparent;
    color: rgb(255 255 255 / 94%);

    cursor: pointer;
    list-style: none;

    transition:
      color 180ms ease,
      opacity 180ms ease,
      transform 220ms var(--ease-out-expo);
  }

  .site-header__mobile-menu summary:hover {
    background: transparent;
    color: white;
    opacity: 0.82;
    transform: scale(1.04);
  }

  .site-header__mobile-menu summary:active {
    transform: scale(0.97);
  }

  .site-header__mobile-menu summary svg {
    width: 1.85rem;
    height: 1.85rem;
    transition: opacity 180ms ease, transform 350ms var(--ease-out-expo);
  }

  .site-header__mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .site-header__mobile-menu summary::before,
  .site-header__mobile-menu summary::after {
    position: absolute;
    width: 1.65rem;
    height: 1.5px;
    border-radius: 999px;
    background: white;
    content: '';
    opacity: 0;
    transform: rotate(0deg) scaleX(0.65);
    transition: opacity 220ms ease, transform 420ms var(--ease-out-expo);
  }

  .site-header__mobile-menu[data-mobile-open='true'] summary {
    position: fixed;
    top: 1.35rem;
    right: 1.35rem;
  }

  .site-header__mobile-menu[data-mobile-open='true'] summary svg {
    opacity: 0;
    transform: rotate(30deg) scale(0.7);
  }

  .site-header__mobile-menu[data-mobile-open='true'] summary::before {
    opacity: 1;
    transform: rotate(45deg) scaleX(1);
  }

  .site-header__mobile-menu[data-mobile-open='true'] summary::after {
    opacity: 1;
    transform: rotate(-45deg) scaleX(1);
  }

  .site-header__mobile-backdrop {
    position: fixed;
    z-index: 99;
    inset: 0;
    border: 0;
    padding: 0;
    background: rgb(4 4 5 / 66%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 420ms ease;
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .site-header__mobile-menu[data-mobile-open='true'] .site-header__mobile-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .site-header__mobile-panel {
    position: fixed;
    z-index: 100;
    top: 0;
    right: 0;
    display: grid;
    width: min(92vw, 27rem);
    height: 100dvh;
    grid-template-rows: 1fr auto;
    overflow-y: auto;
    border-left: 1px solid rgb(255 255 255 / 8%);
    padding: clamp(6rem, 13vh, 8rem) clamp(1.5rem, 7vw, 2.5rem) 2rem;
    background:
      radial-gradient(circle at 100% 0%, rgb(126 8 39 / 20%), transparent 34%),
      radial-gradient(circle at 0% 100%, rgb(224 35 78 / 8%), transparent 30%),
      #0b0b0c;
    box-shadow: -2rem 0 6rem rgb(0 0 0 / 52%);
    opacity: 0.75;
    pointer-events: none;
    transform: translateX(105%);
    transition: transform 580ms var(--ease-out-expo), opacity 420ms ease;
  }

  .site-header__mobile-menu[data-mobile-open='true'] .site-header__mobile-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  .site-header__mobile-navigation {
    display: flex;
    align-self: center;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
  }

  .site-header__mobile-main-link,
  .site-header__mobile-service-links a {
    display: flex;
    align-items: baseline;
    justify-content: flex-start;
    color: rgb(255 255 255 / 88%);
  }

  .site-header__mobile-main-link {
    min-height: 3rem;
    font-size: clamp(1.7rem, 8vw, 2.35rem);
    font-weight: 560;
    letter-spacing: -0.055em;
