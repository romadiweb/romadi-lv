PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only. Prefer Supabase's newer sb_secret_ key. A legacy service-role
# key also works, but must never be prefixed with PUBLIC_ or sent to a browser.
SUPABASE_SECRET_KEY=sb_secret_your_server_key

# Cloudflare Turnstile. The documented always-pass test keys may be used only
# in local development and automated tests.
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Long random value used only to HMAC login rate-limit identifiers.
PORTAL_RATE_LIMIT_SECRET=replace_with_at_least_32_random_characters
